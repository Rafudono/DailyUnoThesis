<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="NoirCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Background" Value="Transparent"/>
        <!--<Setter Property="BorderBrush" Value="DarkGray"/>-->
        <!-- Серый контур -->
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="23"/>
        <Setter Property="Height" Value="23"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="FontSize" Value="20"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Width="{TemplateBinding Width}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.BorderBrush" Value="{StaticResource InkBlueLightBrush}"/>
                                        <!--<Setter Target="HoverBackground.Opacity" Value="1"/>-->
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="Gray"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <!--<Setter Target="RootGrid.Background" Value="DarkGray"/>-->
                                        <!-- !!! Важно: Теперь меняем BorderBrush в Checked состоянии -->
                                        <!--<Setter Target="RootGrid.BorderBrush" Value="{StaticResource InkBlueLightBrush}"/>-->
                                        <Setter Target="CheckGlyph.Foreground" Value="Red"/>
                                        <!--<Setter Target="CheckedBackground.Opacity" Value="1"/>-->
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="RootGrid" Padding="0"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}" HorizontalAlignment="Left" Width="{TemplateBinding Height}" Height="{TemplateBinding Height}">

                      

                        <!-- Слой ВЫДЕЛЕНИЯ (Checked) -->
                        <Border x:Name="CheckedBackground" 
BorderBrush="{StaticResource InkBlueLightBrush}"
Opacity="1"  BorderThickness="2"
CornerRadius="2"/>

                        <!-- Слой НАВЕДЕНИЯ (Hover) -->
                        <!--<Border x:Name="HoverBackground" 
BorderBrush="{StaticResource InkBlueLightBrush}"
Opacity="0" BorderThickness="2"
CornerRadius="{TemplateBinding CornerRadius}"/>-->

                        <!-- Крестик (или галочка) -->
                        <FontIcon x:Name="CheckGlyph" 
                              Glyph="{TemplateBinding Tag}" 
                            FontSize="{TemplateBinding FontSize}" FontWeight="Bold"
                              Foreground="Transparent" 
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center"/> <!--&#xE106;-->
                    </Grid>
                        <Border BorderThickness="0 0 0 2" BorderBrush="Black" Padding="0 0 0 -3" Margin="5 0 0 0">
                            <ContentPresenter x:Name="ContentPresenter"
           Content="{TemplateBinding Content}"
           ContentTemplate="{TemplateBinding ContentTemplate}"
           Padding="{TemplateBinding Padding}"
           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
           VerticalAlignment="Center" FontSize="18" Foreground="Black" FontWeight="DemiBold" FontFamily="Segoe Print" Margin="0"/>
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
