<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style x:Key="NotebookTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Segoe Print"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#00224d"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <!-- Только линия снизу -->
        <Setter Property="BorderBrush" Value="#A3B1C6"/>
        <Setter Property="Padding" Value="0,0,0,0"/>
        <Setter Property="PlaceholderForeground" Value="#A3B1C6"/>
        <Setter Property="CornerRadius" Value="3"/>




        <!-- Убираем стандартные синие рамки при фокусе (WinUI/Uno) -->
    </Style>


    <Style x:Key="NotebookTimeTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Comic Sans MS"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Background" Value="#0A000000"/>
        <!-- Очень легкая тень -->
        <Setter Property="BorderBrush" Value="{StaticResource BackgroundDarkBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <!-- Только линия снизу -->
        <Setter Property="Padding" Value="5"/>
        <Setter Property="CornerRadius" Value="4"/>
        <!--<Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{TemplateBinding PlaceholderText}" FontSize="22" Opacity="0.5" FontFamily="Segoe Print"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>-->
    </Style>

    <Style x:Key="NotebookTimerTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Comic Sans MS"/>
        <Setter Property="FontSize" Value="24"/>
        
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BackgroundDarkBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Height="Auto">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ContentPresenter x:Name="HeaderContentPresenter" Grid.Row="0" Foreground="Gray" Margin="0,0,0,4" Content="{TemplateBinding Header}"/>

                        <Grid Grid.Row="1">
                            <!-- Основное поле ввода -->
                            <ScrollViewer x:Name="ContentElement" Margin="{TemplateBinding Padding}" />

                            <!-- Плейсхолдер, которым мы теперь управляем полностью -->
                            <!-- Имя PlaceholderTextContentPresenter заставляет TextBox управлять его видимостью -->
                            <TextBlock x:Name="PlaceholderTextContentPresenter"
        Text="{TemplateBinding PlaceholderText}"
        FontSize="{TemplateBinding FontSize}"
        FontFamily="{TemplateBinding FontFamily}"
        Foreground="Silver"
        Opacity="0.5"  Margin="7 0"
        IsHitTestVisible="False" 
        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalAlignment="Center"/>

                        </Grid>
                        <Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" VerticalAlignment="Bottom" Margin="2 0 0 0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


