<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="NoirTreeViewItemStyle" TargetType="TreeViewItem">
        <!--<Setter Property="HorizontalContentAlignment" Value="Stretch"/>-->
        <!-- Убираем стандартные отступы, которые могут мешать схлопыванию -->
        <!--<Setter Property="MinHeight" Value="0"/>
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="Transitions">
            <Setter.Value>
                <TransitionCollection>
                    --><!-- Эта штука заставляет соседей плавно ехать на свободное место --><!--
                    <AddDeleteThemeTransition />
                </TransitionCollection>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />-->
        <!-- Убираем лишние падинги -->
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid x:Name="NodeGrid" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <!-- Группа состояний раскрытия -->
                            <VisualStateGroup x:Name="ExpansionStates">
                                <VisualState x:Name="Collapsed"/>
                                <VisualState x:Name="Expanded">
                                    <VisualState.Setters>
                                        <!-- Поворачиваем стрелку на 90 градусов вниз -->
                                        <Setter Target="ExpanderGlyph.RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="90"/>
                                            </Setter.Value>
                                        </Setter>
                                        <!-- Можно сменить цвет при раскрытии -->
                                        <Setter Target="ExpanderGlyph.Foreground" Value="{ThemeResource AccentBlueBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <!-- Группа выделения (чтобы не было системного фиолетового) -->
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected"/>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="NodeGrid.Background" Value="{ThemeResource SystemControlBackgroundListLowBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <!-- Для стрелки -->
                            <ColumnDefinition Width="*"/>
                            <!-- Для вашего контента -->
                        </Grid.ColumnDefinitions>

                        <!-- Сама стрелка (Expander) -->
                        <!-- Мы делаем её видимой только если есть дети -->
                        <Grid x:Name="ExpanderButton" 
                          VerticalAlignment="Center" 
                          HorizontalAlignment="Center"
                          Margin="4,0"
                          Width="20" Height="20"
                          Background="Transparent">

                            <FontIcon x:Name="ExpanderGlyph" 
                                  Glyph="&#xE76C;" 
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="12"
                                  Foreground="{ThemeResource InkBlueBrush}"
                                  RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Grid>

                        <!-- ВАШ КОНТЕНТ (тот самый Border с задачей) -->
                        <ContentPresenter Grid.Column="1"
                                      x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
