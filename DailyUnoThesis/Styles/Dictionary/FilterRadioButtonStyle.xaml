<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">



    <Style x:Key="FilterRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource InkBlueLightBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource InkBlueLightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="RootGrid"  Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"  CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <!-- Теперь мы меняем прозрачность слоя выделения -->
                                        <Setter Target="CheckedBackground.Opacity" Value="0.4"/>
                                        <Setter Target="RootGrid.BorderBrush" Value="{StaticResource BackgroundDarkBrush}"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="Black"/>
                                        <Setter Target="CheckedBorder.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <!-- Теперь мы меняем прозрачность слоя наведения -->
                                        <Setter Target="HoverBackground.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverBackground.Background" Value="#8B5E3C"/>
                                        <Setter Target="HoverBackground.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <!-- Слой ВЫДЕЛЕНИЯ (Checked) -->
                        <Border x:Name="CheckedBackground"  Background="{StaticResource InkBlueLightBrush}" Opacity="0" BorderThickness="3"  CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Border x:Name="CheckedBorder"  Background="Transparent" Opacity="0" BorderThickness="3" BorderBrush="{StaticResource BackgroundDarkBrush}" CornerRadius="8"/>
                        <!-- Слой НАВЕДЕНИЯ (Hover) -->
                        <Border x:Name="HoverBackground"  Background="{ThemeResource SystemControlBackgroundListLowBrush}" Opacity="0" BorderThickness="{TemplateBinding BorderThickness}"  CornerRadius="8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="{TemplateBinding Padding}">
                            <PathIcon Data="{TemplateBinding Tag}"   x:Name="Icon" Foreground="{Binding Foreground, ElementName=ContentPresenter}"/>
                            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>





    <Style x:Key="FilterButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource InkBlueLightBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource InkBlueLightBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="CornerRadius" Value="15"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" 
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FilterStates">
                                <!-- Обычное состояние (Фильтр выключен) -->
                                <VisualState x:Name="FilterOff"/>

                                <!-- Состояние, когда фильтр включен -->
                                <VisualState x:Name="FilterActive">
                                    <VisualState.StateTriggers>
                                        <!-- Магия здесь: триггер следит за Tag родителя (кнопки) -->
                                        <StateTrigger IsActive="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </VisualState.StateTriggers>

                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource InkBlueLightBrush}"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="White"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                             Стандартные состояния наведения (чтобы не ломались) 
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverBackground.Opacity" Value="0.3"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="HoverBackground" Background="Gray" Opacity="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0" Padding="{TemplateBinding Padding}">
                            <PathIcon Data="M3 17V19H9V17H3ZM3 5V7H13V5H3ZM13 21V19H21V17H13V15H11V21H13ZM7 9V11H3V13H7V15H9V9H7ZM21 13V11H11V13H21ZM15 9H17V7H21V5H17V3H15V9Z"
                                      x:Name="Icon" Foreground="{Binding Foreground, ElementName=ContentPresenter}" Margin="3 3 0 0"/>
                            <ContentPresenter x:Name="ContentPresenter" Margin="0"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                        
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
