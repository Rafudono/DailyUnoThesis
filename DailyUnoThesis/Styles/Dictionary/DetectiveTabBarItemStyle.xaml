<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:utu="using:Uno.Toolkit.UI">


    <Style x:Key="DetectiveTabBarItemStyle" TargetType="utu:TabBarItem">
        <Setter Property="FontFamily" Value="Segoe Print"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="#3D2B1F"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="utu:TabBarItem">
                    <!-- Контейнер для всего пункта -->
                    <Grid x:Name="RootGrid"  Height="30" >
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <!-- Обычное состояние -->
                                <VisualState x:Name="Normal"/>
                                <!-- Наведение мыши -->
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <!-- Цвет текста становится темнее при наведении -->
                                        <Setter Target="ContentPresenter.Foreground" Value="#051a35"/>
                                        <Setter Target="Underline.BorderThickness" Value="0 0 0 2"/>
                                        <Setter Target="Underline.Opacity" Value="1"/>
                                        <Setter Target="HoverBackground.Opacity" Value="0.5"/>
                                        <Setter Target="CuttingBorder.Opacity" Value="1"/>
                                        <Setter Target="CuttingBorder.Margin" Value="3 3 0 0"/>
                                        <Setter Target="RootGrid.Height" Value="35"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <!-- Состояние выбора (Активный пункт) -->
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <!-- Текст становится красным -->
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ClueRedLightBrush}"/>
                                        <!-- Показываем красную черту -->
                                        <Setter Target="Underline.BorderThickness" Value="0 0 0 2"/>
                                        <Setter Target="CheckedBackground.Opacity" Value="0.5"/>
                                        <Setter Target="CuttingBorder.Opacity" Value="1"/>
                                        <Setter Target="CuttingBorder.Margin" Value="3 3 0 0"/>
                                        <Setter Target="Underline.Opacity" Value="1"/>
                                        <Setter Target="RootGrid.Height" Value="35"/>
                                        <Setter Target="ChevronPath.Opacity" Value="1"/>
                                        <Setter Target="ChevronPath.Visibility" Value="Visible"/>

                                        <Setter Target="HoverBackground.Opacity" Value="0.8"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <!-- Слой ВЫДЕЛЕНИЯ (Checked) -->
                        <!--<Border x:Name="CheckedBackground" Background="Gray" Opacity="0" BorderThickness="0" CornerRadius="6"/>-->
                        <!--<Border x:Name="CheckedBorder"  Background="Transparent" Opacity="0" BorderThickness="3" BorderBrush="{StaticResource InkBlueLightBrush}" CornerRadius="8"/>-->
                        <!-- Слой НАВЕДЕНИЯ (Hover) -->
                        <Border x:Name="HoverBackground" Background="{ThemeResource SystemControlBackgroundListLowBrush}" Opacity="0" BorderThickness="{TemplateBinding BorderThickness}" Margin="0"  CornerRadius="6">
                        </Border>
                        <!--<Border  x:Name="CuttingBorder" Background="#f3efdc" CornerRadius="4" BorderThickness="0" Opacity="0" Margin="0"/>-->

                        <Grid Margin="10,3,25,2" HorizontalAlignment="Left" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 0,0 L 5,5 L 0,10 Z"  Fill="{StaticResource ClueRedLightBrush}"  Stretch="Uniform" x:Name="ChevronPath"  Width="13" Height="20"  Margin="-11 2 10 0" Opacity="0"  Visibility="Collapsed"/>
                                <SymbolIcon Symbol="{TemplateBinding Tag}" x:Name="Icon" Foreground="{Binding Foreground, ElementName=ContentPresenter}" Margin="-2 -2 7 0"/>
                                <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Top" FontWeight="SemiBold"
                                      Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                            <Border x:Name="Underline" Opacity="0" Margin="0 -20 0 0"  BorderThickness="0 0 0 2" BorderBrush="{StaticResource ClueRedLightBrush}" VerticalAlignment="Bottom" Background="Transparent" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    

</ResourceDictionary>
