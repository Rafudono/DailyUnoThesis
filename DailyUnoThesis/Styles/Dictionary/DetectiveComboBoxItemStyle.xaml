<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">



    <!-- Стиль для элементов внутри выпадающего списка -->
    <Style x:Key="DetectiveComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="Segoe Print" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BackgroundDarkBrush}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <!--<Storyboard>
                                         --><!--Эффект выделения чернилами при наведении--><!-- 
                                        <ColorAnimation Storyboard.TargetName="LayoutRoot" 
                                                         Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
                                                         To="#E6E0B0" Duration="0:0:0.1"/>
                                    </Storyboard>-->
                                    <VisualState.Setters>
                                        <Setter Target="GreyBorder.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="LayoutRoot" 
                                                         Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
                                                         To="{StaticResource DividerLightBrush}" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="GreyBorder" Background="LightGray" Opacity="0.3" Visibility="Collapsed"/>
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          Margin="{TemplateBinding Padding}"
                                            VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Основной стиль ComboBox -->
    <Style x:Key="DetectiveComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Segoe Print" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource InkBlueLightBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkGrayBrown}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <!-- Только нижняя линия, как в анкете -->
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DetectiveComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="LayoutRoot">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="GreyBorder.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Поле самого комбобокса -->
                        <Border x:Name="BackgroundElement"
                                Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"/>
                        
                        <Border Grid.ColumnSpan="2" x:Name="GreyBorder" Background="LightGray" Opacity="0.3" Visibility="Collapsed"/>

                        <StackPanel Margin="5 0 0 0" Orientation="Horizontal" Scale="10">
                            <FontIcon Glyph="{TemplateBinding Tag}" FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                        
                        <ContentPresenter x:Name="ContentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        </StackPanel>

                        <!-- Иконка раскрытия (шеврон) -->
                        <Path Grid.Column="1"
                              Data="M0,0 L8,8 L16,0" 
                              Stroke="{StaticResource ClueRedDarkLightBrush}" 
                              StrokeThickness="3"
                              VerticalAlignment="Center" 
                              Margin="10,0" />

                        <!-- Выпадающее окно -->
                        <Popup x:Name="Popup" >
                            <Border x:Name="PopupBorder"
                                    Background="#f3f6ff"
                                    BorderBrush="{StaticResource DarkGrayBrown}"
                                    BorderThickness="1"
                                    Margin="0,2,0,0">
                                <ScrollViewer x:Name="ScrollViewer" MaxHeight="200">
                                    <ItemsPresenter Margin="0,5" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
