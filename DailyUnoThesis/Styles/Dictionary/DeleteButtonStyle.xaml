<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DailyUnoThesis.Styles.Dictionary">


    <Style x:Key="RedTextButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
        <!-- По умолчанию текст красный -->
        <Setter Property="Foreground" Value="{ThemeResource ClueRedBrush}" />

        <!-- Переопределяем поведение VisualStateManager, чтобы текст оставался красным -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>

                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <!-- Цвет текста при наведении: останется красным -->
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ClueRedDarkBrush}"/>
                                        <!-- Можно добавить легкий фон, если хочется -->
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SystemControlBackgroundBaseLowBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <!-- Цвет текста при нажатии: останется красным -->
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ClueRedBrush}"/>
                                        <!-- Можно добавить более темный фон -->
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SystemControlBackgroundBaseMediumLowBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SystemControlDisabledForegroundBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <!-- Другие группы состояний (FocusStates) можно оставить как есть,
                             если не нужно их менять -->
                        </VisualStateManager.VisualStateGroups>

                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <FontIcon Glyph="{TemplateBinding Tag}" Margin="6 0 -3 2" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" FontWeight="Black" FontSize="25" Foreground="{Binding Foreground, ElementName=ContentPresenter}"
VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            
                        
                        <!-- ContentPresenter отображает текст или иконку кнопки -->
                        <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



