    <Style x:Key="StampTogButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource InkBlueLightBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource InkBlueLightBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="5 5 5 2"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="FontFamily" Value="Segoe Print"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" 
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                   >

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FilterStates">
                                <!-- Обычное состояние (Фильтр выключен) -->
                                <VisualState x:Name="FilterOff"/>

                                <!-- Состояние, когда фильтр включен -->
                                <VisualState x:Name="FilterActive">
                                    <VisualState.StateTriggers>
                                        <!-- Магия здесь: триггер следит за Tag родителя (кнопки) -->
                                        <StateTrigger IsActive="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </VisualState.StateTriggers>

                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{StaticResource InkBlueLightBrush}"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="White"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <!--Стандартные состояния наведения (чтобы не ломались)-->
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverBackground.Opacity" Value="0.3"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="HoverBackground" Background="Gray" Opacity="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0" Margin="0 -3 0 0" Padding="{TemplateBinding Padding}">
                            <FontIcon Glyph="{Binding (local:ButtonHelper.IconGlyph), RelativeSource={RelativeSource TemplatedParent}}" 
                          x:Name="Icon" Foreground="{Binding Foreground, ElementName=ContentPresenter}" Margin="0 2 0 0"/>
                            <ContentPresenter x:Name="ContentPresenter" Margin="0"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </StackPanel>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


