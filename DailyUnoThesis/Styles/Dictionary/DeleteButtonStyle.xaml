         HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="StampWithIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <!--<Setter Property="Padding" Value="15,8,15,8"/>-->
        <Setter Property="FontFamily" Value="Segoe Print"/>
        <!--<Setter Property="FontSize" Value="16"/>-->
        <!--<Setter Property="FontWeight" Value="SemiBold"/>-->
        <!-- Используем ваш цвет чернил -->
        <Setter Property="Foreground" Value="{StaticResource InkBlueLightBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <!-- Анимируем прозрачность, чтобы создать эффект "нажатия" или наплыва чернил -->
                                        <DoubleAnimation Storyboard.TargetName="RootGrid"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0.7" Duration="0:0:0.1"/>
                                        <!--<DoubleAnimation Storyboard.TargetName="RootTransform"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.02" Duration="0:0:0.1"/>-->

                                    </Storyboard>
                                    <VisualState.Setters>
                                        <Setter Target="StampBorder.Background" Value="{ThemeResource SystemControlBackgroundBaseLowBrush}"/>
                                        <!-- Цвет текста при наведении: останется красным -->
                                        <Setter Target="ContentPresenter.Foreground" Value="{TemplateBinding Tag}"/>

                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <!--<Storyboard>
                                       <DoubleAnimation Storyboard.TargetName="RootTransform"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="0.95" Duration="0:0:0.1"/>
                                   </Storyboard>-->
                                    <VisualState.Setters>
                                        <!-- Цвет текста при нажатии: останется красным -->
                                        <Setter Target="ContentPresenter.Foreground" Value="{TemplateBinding Tag}"/>
                                        <!-- Можно добавить более темный фон -->
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SystemControlBackgroundBaseMediumLowBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.RenderTransform>
                            <CompositeTransform x:Name="RootTransform" />
                        </Grid.RenderTransform>

                        <!-- Рамка "Штамп" -->
                        <Border x:Name="StampBorder" 
                        BorderBrush="{TemplateBinding Foreground}" 
                        BorderThickness="2" 
                        CornerRadius="3">
                            <StackPanel Orientation="Horizontal" Padding="{TemplateBinding Padding}">
                                <FontIcon Glyph="{Binding (local:ButtonHelper.IconGlyph), RelativeSource={RelativeSource TemplatedParent}}" Margin="6 0 0 0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" FontWeight="Black" FontSize="25" Foreground="{Binding Foreground, ElementName=ContentPresenter}"
VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <ContentPresenter x:Name="ContentPresenter"
        Content="{TemplateBinding Content}"
        ContentTemplate="{TemplateBinding ContentTemplate}"
        Padding="{TemplateBinding Padding}"
        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
