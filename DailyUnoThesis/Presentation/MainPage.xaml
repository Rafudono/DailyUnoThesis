        <Grid.ColumnDefinitions>


            <ColumnDefinition MinWidth="40"  Width="0.035*" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Background="Aqua" Opacity="0.3">
            
        </Grid>
        -->
            <!--<Grid Background="Red" Grid.Column="1">
       
   </Grid>-->
            <!--
