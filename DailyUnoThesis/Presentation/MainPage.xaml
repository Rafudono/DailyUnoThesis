<Page x:Class="DailyUnoThesis.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:DailyUnoThesis.Presentation"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">
  <ScrollViewer IsTabStop="True">
    <Grid utu:SafeArea.Insets="VisibleBounds">
            <Grid  Background="PaleVioletRed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="40" Width="0.034*"></ColumnDefinition>
                    <ColumnDefinition/>

                </Grid.ColumnDefinitions>
                <Frame Background="AliceBlue" Grid.Column="1" IsNavigationStackEnabled="False" Content="{Binding CurPage}"/>
                <Grid Grid.Column="0"  Background="Red">

                    <StackPanel Margin="0 10 0 0">


                        <Button Height="30" Width="30"  Margin="0 10 0 0" Command="{Binding OpenTaskListPage}"/>
                        <Button Height="30" Width="30"  Margin="0 10 0 0"/>
                        <Button Height="30" Width="30"  Margin="0 10 0 0" Command="{Binding OpenPomodoroPage}"/>
                    </StackPanel>

                </Grid>

            </Grid>
