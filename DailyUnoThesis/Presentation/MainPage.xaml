                </NavigationView.MenuItems>

                </NavigationView>
            <Grid Grid.Column="1" uen:Region.Attached="True"
              uen:Region.Navigator="Visibility"
              Grid.Row="1">
            </Grid>
        </Grid>-->

    </Grid>
