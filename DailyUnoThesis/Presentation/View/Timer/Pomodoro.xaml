<Page x:Class="DailyUnoThesis.Presentation.View.Timer.Pomodoro"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="using:DailyUnoThesis.Presentation.View.Timer"
      xmlns:con="using:DailyUnoThesis.Models.Conventers"
xmlns:helperstyle="using:DailyUnoThesis.Styles.Dictionary"
           xmlns:mod="using:DailyUnoThesis.Models.MainClasses"
       xmlns:dob="using:DailyUnoThesis.Models.DobleClasses"
   xmlns:control="using:DailyUnoThesis.Presentation.ViewModel.TimerPagesControle" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"





    xmlns:uen="using:Uno.Extensions.Navigation.UI"
xmlns:utu="using:Uno.Toolkit.UI"
xmlns:um="using:Uno.Material"
NavigationCacheMode="Required"
          xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
xmlns:core="using:Microsoft.Xaml.Interactions.Core"
      xmlns:ut="using:Uno.Themes"
      x:Name="TimePageRoot">
    <Page.Resources>
        <con:MaxTimerConventer x:Key="MaxLength"/>
        <con:StringToIntConverter x:Key="StringToInt"/>
        <!--<control:PomodoroTimerControle x:Key="Control"/>-->
        <con:StringFormatTimeConverter x:Key="StringFormatTimeConverter"/>
        <con:PlayPauseIconConverter x:Key="PlayPauseIconConverter"/>
        <con:BoolToStringPlayButtonConverter x:Key="BoolToStringPlayButtonConverter"/>
        <con:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <con:ArrowControlEnabledConventer x:Key="ArrowControlEnabledConventer"/>
        <con:ArrowBackControlEnabledConventer x:Key="ArrowBackControlEnabledConventer"/>
        <con:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <con:HeightConventer x:Key="HeightConventer"/>
        <con:BoolToStringRoundTomatosConverter x:Key="BoolToStringRoundTomatosConverter"/>

        


        <!--HeightConventer-->

        <con:LevelToMarginConverter x:Key="LevelToMarginConverter" />
        <con:StringFormatConverter x:Key="StringFormatConverter" />
        <con:LevelVisibilityConverter x:Key="LevelVisibilityConverter"/>
        <con:DateTimeToOffsetConverter x:Key="DateTimeToOffsetConverter"/>
        <con:LevelTextBoxVisibilityConverter x:Key="LevelTextBoxVisibilityConverter"/>
        <con:LevelComboBoxVisibilityConverter x:Key="LevelComboBoxVisibilityConverter"/>
        <con:NullToVisibilityConverterTextBoxCategory x:Key="ConverterTextBoxVisibility"/>
        <con:VisibilityButtonToText x:Key="VisibilityButtonToText"/>
        <con:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <con:BoolToAngleConverter x:Key="BoolToAngleConverter"/>







        <Style TargetType="ToggleButton" x:Key="RadioLookToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <RadioButton DataContext="ToggleButton" IsChecked="{TemplateBinding IsChecked}" Content="{TemplateBinding Content}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"/>
                            <Border Background="Transparent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

      


    </Page.Resources>

    <Grid Background="BurlyWood">

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Когда окно узкое и пошел перенос, добавляем нахлёст -->
                        <Setter Target="HelperGrid.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="700" />
                    </VisualState.StateTriggers>
                    <!-- Здесь обычные отступы -->
                </VisualState>
            </VisualStateGroup>
            
      
        </VisualStateManager.VisualStateGroups>


        
        <Grid Background="#E9E9E9">
            <!-- Общий фон страницы -->

            <Grid >
                <Grid.Background>
                    <ImageBrush ImageSource="ms-appx:///Assets/PapersDoc.jpg" 
             Stretch="UniformToFill" 
             Opacity="0.8"/>
                    <!-- Опционально: сделать фон менее ярким -->
                </Grid.Background>

                <ScrollViewer >
                   
                        <!--<VariableSizedWrapGrid Width="1200" Margin="3 60 3 7" Orientation="Horizontal" HorizontalAlignment="Center" Background="Red" >-->

                    <Grid  Padding="-5 10 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.6*" MinWidth="380" x:Name="Test"/>
                            <ColumnDefinition Width="Auto" x:Name="CenterScreen" />
                            <ColumnDefinition  x:Name="PaneColumn" Width="0" MaxWidth="480"/>
                            <!--<ColumnDefinition Width="0.5*" />-->

                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="PaneStates">

                                <VisualState x:Name="InlinePanel">
                                    <VisualState.StateTriggers>
                                        <StateTrigger IsActive="{Binding IsEnoughSpace}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="PaneColumn.Width" Value="0.3*" />
                                        <Setter Target="PaneColumn.MinWidth" Value="350" />
                                        <Setter Target="SettingsPanel.Margin" Value="30 0" /> 
                                        <!--<Setter Target="ListSpace.Visible" Value="Collapsed" />-->

                                        <!--<Setter Target="DetailsPane.Visibility" Value="Collapsed" />-->

                                    </VisualState.Setters>
                                </VisualState>
                                
                                <VisualState x:Name="OverlayPanel">
                                    <VisualState.StateTriggers>
                                        <StateTrigger IsActive="{Binding IsDarkSpace}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="DarkSpace.Visibility" Value="Visible" />
                                        <!--<Setter Target="ListSpace.Visible" Value="Collapsed" />-->

                                        <!--<Setter Target="DetailsPane.Visibility" Value="Collapsed" />-->

                                    </VisualState.Setters>
                                </VisualState>

                                <!--СОСТОЯНИЕ: ПАНЕЛЬ ОТКРЫТА-->
                            
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="PaneStatesOpen">
                                <VisualState x:Name="Open">
                                    <VisualState.StateTriggers>
                                        <StateTrigger IsActive="{Binding IsPaneOpen}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <!--<Setter Target="PaneColumn.Width" Value="0.3*" />
            <Setter Target="PaneColumn.MinWidth" Value="350" />-->
                                        <!--<Setter Target="ListSpace.Tag" Value="true" />-->

                                        <Setter Target="ListSpace.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="PaneStatesOpenWidth">
                                <VisualState x:Name="OpenWidth">
                                    <VisualState.StateTriggers>
                                        <StateTrigger IsActive="{Binding IsEnoughSpace}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <!--<Setter Target="PaneColumn.Width" Value="0.3*" />
            <Setter Target="PaneColumn.MinWidth" Value="350" />-->
                                        <!--<Setter Target="ListSpace.Tag" Value="true" />-->

                                        <Setter Target="ListSpace.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid  x:Name="GridGrid" Width="Auto" />

                        <!-- Основной стикер -->
                        <ContentControl Style="{StaticResource StickerContainerStyle}"  Margin="0 0 0 0"  MinWidth="390" MinHeight="400" Padding="10 10 10 20" HorizontalAlignment="Left" VerticalAlignment="Top" >
                            <StackPanel>
                                <Grid Padding="0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="5">

                                    <!-- Циферблат -->
                                        <Grid x:Name="ClockFace" MinWidth="300" MinHeight="300"  VerticalAlignment="Top" Margin="0 10 0 0" >
                                        <!-- Эффект "наброска": три линии с разным DashArray создают вид небрежного круга -->
                                        <Grid  Visibility="{Binding CountdownTimer.BreakTimer, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <Ellipse Stroke="{StaticResource ClueRedLightBrush}" StrokeThickness="2" Opacity="0.4" Margin="2"/>
                                        <Ellipse Stroke="{StaticResource ClueRedLightBrush}" StrokeThickness="1" Opacity="0.2" Margin="-2" StrokeDashArray="4,2"/>
                                        <Ellipse Stroke="{StaticResource ClueRedLightBrush}" StrokeThickness="1.5" Opacity="0.3" Margin="5" StrokeDashArray="10,5"/>

                                        <Grid >
                                            <!-- Основное кольцо пятна (неровное и мягкое) -->
                                            <Ellipse Stroke="{StaticResource ClueRedLightBrush}" StrokeThickness="6" Opacity="0.2" Margin="0" >
                                                <!--<Ellipse.BlurEffect>
             -->
                                                <!-- Если Uno поддерживает, добавляем легкое размытие -->
                                                <!--
         </Ellipse.BlurEffect>-->
                                            </Ellipse>

                                            <!-- Второе кольцо (внутренний ободок чашки) -->
                                            <Ellipse Stroke="{StaticResource ClueRedLightBrush}" StrokeThickness="2" Opacity="0.15" Margin="10" StrokeDashArray="15,2,10,5" />
                                            <Ellipse Stroke="{StaticResource ClueRedLightBrush}" StrokeThickness="2" Opacity="0.15" Margin="10" StrokeDashArray="15,2,10,5" Fill="{StaticResource WorkTimeBrush}"/>

                                            <!-- Эффект "пролитого кофе" (небольшое пятнышко сбоку) -->
                                            <!--<Ellipse Fill="#6F4E37" Width="40" Height="30" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,30">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform Angle="30"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>-->
                                        </Grid>
                                        </Grid>
                                        <Grid  Visibility="{Binding CountdownTimer.BreakTimer, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <!-- СЛОЙ 1: КАРАНДАШНЫЙ НАБРОС (ВИДИМ ПРИ РАБОТЕ) -->
                                            <!-- Используем Visibility, привязанный к свойству IsBreak (нужен инвертированный конвертер) -->
                                            <Canvas >
                                                <Ellipse Stroke="{StaticResource BackgroundDarkBrush}" StrokeThickness="2" Opacity="0.4" Margin="2" />
                                                <Ellipse Stroke="{StaticResource BackgroundDarkBrush}" StrokeThickness="1" Opacity="0.2" Margin="-2" StrokeDashArray="4,2"/>
                                                <Ellipse Stroke="{StaticResource BackgroundDarkBrush}" StrokeThickness="1.5" Opacity="0.3" Margin="5" StrokeDashArray="10,5" />
                                            </Canvas>

                                            <!-- СЛОЙ 2: КОФЕЙНЫЙ СЛЕД (ВИДИМ ПРИ ПЕРЕРЫВЕ) -->
                                            <Grid Visibility="{Binding IsBreakMode}">
                                                <!-- Основное кольцо пятна (неровное и мягкое) -->
                                                <Ellipse Stroke="#6F4E37" StrokeThickness="6" Opacity="0.2" Margin="0" >
                                                    <!--<Ellipse.BlurEffect>
             -->
                                                    <!-- Если Uno поддерживает, добавляем легкое размытие -->
                                                    <!--
         </Ellipse.BlurEffect>-->
                                                </Ellipse>

                                                <!-- Второе кольцо (внутренний ободок чашки) -->
                                                <Ellipse Stroke="#4B3621" StrokeThickness="2" Opacity="0.15" Margin="10" StrokeDashArray="15,2,10,5" />
                                                <Ellipse Stroke="#4B3621" StrokeThickness="2" Opacity="0.15" Margin="10" StrokeDashArray="15,2,10,5" Fill="{StaticResource BreakTimeBrush}"/>

                                                <!-- Эффект "пролитого кофе" (небольшое пятнышко сбоку) -->
                                                <!--
     <Ellipse Fill="#6F4E37" Width="40" Height="30" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,30">
         <Ellipse.RenderTransform>
             <RotateTransform Angle="30"/>
         </Ellipse.RenderTransform>
     </Ellipse>-->
                                            </Grid>
                                        </Grid>

                                        <!-- Таймер -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock x:Name="TimerDisplay" 
                                       Text="{Binding CountdownTimer.RemainingTime, Converter={StaticResource StringFormatTimeConverter}, ConverterParameter='hh\\:mm\\:ss'}" 
                                       FontSize="74" 
                                       FontFamily="Comic Sans MS" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource InkBlueLightBrush}"/>
                                                <!--54-->



                                                <!-- Подпись сессии -->
                                            <TextBlock Text="сессия №1" 
                                       HorizontalAlignment="Center" 
                                       FontFamily="Segoe Print" 
                                       FontSize="14" Opacity="0.5" Margin="0,-10,0,0"/>
                                        </StackPanel>
                                    </Grid>


                                        
                                        <Button Height="35" FontFamily="Comic Sans MS" x:Name="DoubleTimerButton"  MaxHeight="40"
                                                        Style="{StaticResource StampTogButtonStyle}" helperstyle:ButtonHelper.IconGlyph="&#xE713;"
                                                        FontWeight="Bold"  Tag="{Binding IsDoubleTimer}" HorizontalAlignment="Left" >
                                            <StackPanel Orientation="Horizontal" Spacing="0">
                                                <TextBlock FontFamily="Segoe Print" FontWeight="Bold" VerticalAlignment="Top" FontSize="14" Text="Запустить с отслеживанием"
                                                       IsHitTestVisible="False" Background="Transparent" Padding="0" Margin="2 -5 0 0" ></TextBlock>
                                                <!--<Button Content="&#xE106;" Visibility="{Binding PomodoroTime.IsSample, Source={StaticResource GlobalStore},  Converter={StaticResource BoolToVisibilityConverter}}"
    x:Name="ClearButSample" Command="{Binding PomodoroTime.ClearSample, Source={StaticResource GlobalStore}}" 
Style="{StaticResource IconButtonStyle}" Margin="0 0 -16 0" Padding="0" Height="20" FontWeight="Bold" Foreground="White" FontSize="15" FontFamily="Segoe MDL2 Assets">
                                            </Button>-->

                                            </StackPanel>

                                            <Button.Flyout>
                                                <Flyout FlyoutPresenterStyle="{StaticResource StickerFlyoutStyle}" x:Name="ContentContainer">
                                                    <StackPanel Spacing="5">
                                                        <CheckBox x:Name="StopTimeForBreak" Tag="&#xE73E;" Style="{StaticResource NoirCheckBoxStyle}" Width="315" Content="Учитывать перерывы"
                                                  FontFamily="Segoe Print" FontSize="17" IsChecked="{Binding IsStopForBreak, Mode=TwoWay}" />

                                                        <CheckBox x:Name="AbsoluteEnd" Tag="&#xE73E;" Style="{StaticResource NoirCheckBoxStyle}" Width="315" Content="Останавливать всё по завершению Помодоро"
                                                  FontFamily="Segoe Print"  FontSize="17" IsChecked="{Binding IsAbsoluteEnd, Mode=TwoWay}" />
                                                        
                                                        <Button FontSize="18" FontWeight="Bold" Content="Запустить" Command="{Binding StartDoubleTimer}" VerticalAlignment="Bottom" Style="{StaticResource TextsButtonStyle}"
                                                         helperstyle:ButtonHelper.IconGlyph="&#xE768;" Tag="{StaticResource AccentBlueLightBrush}" Foreground="{StaticResource InkBlueLightBrush}"
                                                                IsEnabled="{Binding Main.IsPause, Source={StaticResource GlobalStore}}"/>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        
                                        <Grid Height="10"/>




                                        <!-- Кнопки управления (в стиле штампов) -->
                                    <!--<Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    -->
                                    <!-- Кнопка Старт/Пауза -->
                                    <!--
                                    <Button Grid.Column="0" HorizontalAlignment="Center" Style="{StaticResource TextsButtonStyle}">
                                        <Border BorderBrush="Green" BorderThickness="2" Padding="15,5" CornerRadius="2">
                                            <TextBlock Text="В РАБОТУ" FontFamily="Segoe Print" FontWeight="Bold" Foreground="Green" Opacity="0.8"/>
                                        </Border>
                                    </Button>

                                    -->
                                    <!-- Кнопка Сброс -->
                                    <!--
                                    <Button Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource TextsButtonStyle}">
                                        <Border BorderBrush="{StaticResource ClueRedLightBrush}" BorderThickness="2" Padding="15,5" CornerRadius="2">
                                            <TextBlock Text="ОТБОЙ" FontFamily="Segoe Print" FontWeight="Bold" Foreground="{StaticResource ClueRedLightBrush}" Opacity="0.8"/>
                                        </Border>
                                    </Button>
                                </Grid>-->
                                    </StackPanel>

                                    
                                   

                                </Grid>
                                
                          
                            </StackPanel>
                        </ContentControl>

                        <!--<Grid Grid.Column="0" Grid.ColumnSpan="2" Background="Violet" HorizontalAlignment="Right"/>

                        <Grid Grid.Column="1" Background="Red" x:Name=""/>
                        <Grid Grid.Column="2" Background="Aqua"/>-->





                        <!--НАСТРОЙКИ ТАЙМЕРА-->
                        <StackPanel x:Name="SettingsPanel" Grid.ColumnSpan="2" Margin="0 0 0 0"  HorizontalAlignment="Right">
                            <Grid Visibility="Collapsed" MinHeight="290" x:Name="HelperGrid"  Width="{Binding Width, ElementName=Test}" Height="{Binding Height, ElementName=ClockFace}" Margin="0 20"/>
                            <StackPanel   MinHeight="300"   x:Name="AdditionalSettings" HorizontalAlignment="Right" Grid.Row="1"  >
                                <ContentControl   MinHeight="360"  Style="{StaticResource StickerContainerStyle}" HorizontalAlignment="Center" Grid.Row="1">
                            <!-- Меняем скотч на "скрепку" или просто другой наклон -->
                                <Grid  MinHeight="360" Padding="15 20" Background="#FDFEFE">
                                        <StackPanel x:Name="SettingPanel" MinWidth="325" MaxWidth="420" MinHeight="350" Spacing="10" HorizontalAlignment="Center" Padding="0 0 00 0">
                                            <Grid>
                                                <Button Padding="5" Height="35" Style="{StaticResource DetectiveSaveButtonStyle}" HorizontalAlignment="Left" Content="Сохранить"
          Command="{Binding CheckSavePomodoroTimer}" IsEnabled="{Binding CountdownTimer.IsPaused}" />

                                                <Button Height="35" FontFamily="Comic Sans MS" x:Name="SampleButton"  MaxHeight="40" 
                                                        Style="{StaticResource StampTogButtonStyle}" helperstyle:ButtonHelper.IconGlyph="&#xE713;"
                                                        FontWeight="Bold"  Tag="{Binding IsSample}" HorizontalAlignment="Right" Command="{Binding OpenPanelSample}">
                                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                                        <TextBlock FontFamily="Segoe Print" FontWeight="Bold" VerticalAlignment="Top" FontSize="16" Text="Шаблоны" IsHitTestVisible="False" Background="Transparent" Padding="0" Margin="2 -5 0 0" ></TextBlock>
                                                        <Button Content="&#xE106;" Visibility="{Binding PomodoroTime.IsSample, Source={StaticResource GlobalStore},  Converter={StaticResource BoolToVisibilityConverter}}"
    x:Name="ClearButSample" Command="{Binding PomodoroTime.ClearSample, Source={StaticResource GlobalStore}}" 
Style="{StaticResource IconButtonStyle}" Margin="0 0 -16 0" Padding="0" Height="20" FontWeight="Bold" Foreground="White" FontSize="15" FontFamily="Segoe MDL2 Assets">
                                                        </Button>

                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!--<Button Padding="5" Height="35" Style="{StaticResource DetectiveSaveButtonStyle}" HorizontalAlignment="Left" Content="Сохранить"
                                                    Command="{Binding CheckSavePomodoroTimer}" />-->


                                            <!-- Переключатель режимов (в стиле вкладок или просто кнопок) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                                        <RadioButton x:Name="ModeUnit" Content="Классический" FontFamily="Segoe Print" FontSize="13" IsChecked="{Binding ModeHmsTime, Mode=TwoWay}"/>
                                                <RadioButton x:Name="ModeHms" Content="Точное время"  FontFamily="Segoe Print" FontSize="13"  IsChecked="{Binding ModeSettingTime}"/>

                                    </StackPanel>

                                    <!-- КОНТЕЙНЕР ДЛЯ ВВОДА -->
                                    <Grid VerticalAlignment="Top" Margin="0 -10 0 0">

                                        <!-- ВАРИАНТ 1: ЧЧ:ММ:СС -->
                                                <StackPanel Visibility="{Binding IsChecked, ElementName=ModeHms, Converter={StaticResource BoolToVisibilityConverter}}"
HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"  HorizontalAlignment="Center">

                                            <TextBox x:Name="textBox1" Width="50" VerticalAlignment="Top" FontSize="24"  TextChanging="TimeTextBox_TextChanged" PreviewKeyDown="TimeTextBox_KeyDown" 
         Text="{Binding TextHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MaxLength}}"
         BeforeTextChanging="TextBox_OnlyDigits_BeforeTextChanging" PlaceholderText="00" HorizontalTextAlignment="Center"
         MaxLength="2" InputScope="Number" Foreground="{StaticResource InkBlueLightBrush}"
          Style="{StaticResource NotebookTimerTextBoxStyle}"/>

                                            <TextBlock Foreground="{StaticResource InkBlueLightBrush}" Text=":" FontSize="35" VerticalAlignment="Top" Margin="5,-5,5,10" FontFamily="Segoe Print" FontWeight="Bold"/>

                                            <TextBox  x:Name="textBox2" Width="50" VerticalAlignment="Top" TextChanging="TimeTextBox_TextChanged"  PreviewKeyDown="TimeTextBox_KeyDown"
         Text="{Binding TextMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MaxLength}, ConverterParameter='Limit59'}"
         BeforeTextChanging="TextBox_OnlyDigits_BeforeTextChanging" PlaceholderText="00" 
         MaxLength="2" InputScope="Number" Foreground="{StaticResource InkBlueLightBrush}"
         Style="{StaticResource NotebookTimerTextBoxStyle}"/>

                                            <TextBlock Foreground="{StaticResource InkBlueLightBrush}" Text=":" FontSize="35" VerticalAlignment="Top" Margin="5,-5,5,19" FontFamily="Segoe Print" FontWeight="Bold"/>

                                            <TextBox x:Name="textBox3" Width="50" VerticalAlignment="Top" TextChanging="TimeTextBox_TextChanged"  PreviewKeyDown="TimeTextBox_KeyDown"
         Text="{Binding TextSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MaxLength}, ConverterParameter='Limit59'}"
         BeforeTextChanging="TextBox_OnlyDigits_BeforeTextChanging" PlaceholderText="00"
         MaxLength="2" InputScope="Number" Foreground="{StaticResource InkBlueLightBrush}"
         Style="{StaticResource NotebookTimerTextBoxStyle}"/>
                                        </StackPanel>
                                                    <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-5 -20 0 0"
                                                     Visibility="{Binding SecondNullTimer, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <SymbolIcon Symbol="Important" Foreground="{ThemeResource ClueRedBrush}"/>
                                                        <!--Priority-->
                                                        <TextBlock    VerticalAlignment="Top" FontFamily="Segoe Print"  Text="Должно быть заполнено хотя бы 1 поле" FontWeight="ExtraBlack"
FontSize="13" Foreground="{ThemeResource ClueRedBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                        <!-- ВАРИАНТ 2: Значение + Выбор единицы -->
                                                <StackPanel Spacing="20" Visibility="{Binding IsChecked, ElementName=ModeUnit, Converter={StaticResource BoolToVisibilityConverter}}" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"  HorizontalAlignment="Center">

                                            <Button x:Name="backward" IsEnabled="{Binding TextTime, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ArrowBackControlEnabledConventer}, ConverterParameter=Classic}" FontSize="25" Width="30"
           helperstyle:ButtonHelper.IconGlyph="&#xE76B;" Style="{StaticResource TextsButtonStyle}"
           Tag="{StaticResource AccentBlueLightBrush}" Foreground="{StaticResource InkBlueLightBrush}"
           Command="{Binding AdjustTimeCommand}" CommandParameter="Timer:-1"></Button>



                                            <TextBox Width="60" x:Name="Classic" TextChanging="TimeClassicTextBox_TextChanged" 
                                                             Text="{Binding TextTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource MaxLength}, ConverterParameter='Classic'}"
         VerticalAlignment="Top" Foreground="{StaticResource InkBlueLightBrush}"
         BeforeTextChanging="TextBox_OnlyDigits_BeforeTextChanging"  PlaceholderText="00"
         InputScope="Number"
         Style="{StaticResource NotebookTimerTextBoxStyle}"/>

                                            <Button x:Name="forward" IsEnabled="{Binding TextTime, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ArrowControlEnabledConventer}, ConverterParameter=Classic}" FontSize="25" Width="30"
          helperstyle:ButtonHelper.IconGlyph="&#xE76C;"  Style="{StaticResource TextsButtonStyle}"
          Tag="{StaticResource AccentBlueLightBrush}" Foreground="{StaticResource InkBlueLightBrush}"
          Command="{Binding AdjustTimeCommand}" CommandParameter="Timer:1"></Button>

                                            <TextBlock VerticalAlignment="Center" FontFamily="Segoe Print"  Text="Минут" FontWeight="ExtraBlack" FontSize="20" Foreground="{StaticResource InkBlueLightBrush}"/>

                                            <!--<ComboBox Width="120" Margin="10,-10,0,0" SelectedIndex="0" PlaceholderText="Время" Height="40"
          VerticalAlignment="Center" Tag="&#xE916;"
          SelectedItem="{Binding SelectedListTime, Mode=TwoWay}"
           Style="{StaticResource DetectiveComboBoxStyle}">
                                                        <ComboBoxItem Content="Секунд"/>
                                                        <ComboBoxItem Content="Минут"/>
                                                        <ComboBoxItem Content="Часов"/>
                                                    </ComboBox>-->
                                        </StackPanel>
                                                    <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-5 -20 0 0"
                                                     Visibility="{Binding IsEnabled, ElementName=backward, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                        <SymbolIcon Symbol="Important" Foreground="{ThemeResource ClueRedBrush}"/>
                                                        <!--Priority-->
                                                        <TextBlock    VerticalAlignment="Top" FontFamily="Segoe Print"  Text="Не меньше 10 минут" FontWeight="ExtraBlack"
FontSize="13" Foreground="{ThemeResource ClueRedBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                           


