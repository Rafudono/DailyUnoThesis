                            <VisualState x:Name="InlinePanel">
                                <VisualState.StateTriggers>
                                    <StateTrigger IsActive="{Binding IsEnoughSpace}" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="PaneColumn.Width" Value="0.3*" />
                                    <Setter Target="PaneColumn.MinWidth" Value="350" />

                                </VisualState.Setters>
                            </VisualState>

                            <VisualState x:Name="OverlayPanel">
                                <VisualState.StateTriggers>
                                    <StateTrigger IsActive="{Binding IsDarkSpace}" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="DarkSpace.Visibility" Value="Visible" />

                                </VisualState.Setters>
                            </VisualState>

                            <!--СОСТОЯНИЕ: ПАНЕЛЬ ОТКРЫТА-->

                        </VisualStateGroup>
                        <VisualStateGroup x:Name="PaneStatesOpen">
                            <VisualState x:Name="Open">
                                <VisualState.StateTriggers>
                                    <StateTrigger IsActive="{Binding IsPaneOpen}" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                  

                                    <Setter Target="ListSpace.Visibility" Value="Visible" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>

                        <VisualStateGroup x:Name="PaneStatesOpenWidth">
                            <VisualState x:Name="OpenWidth">
                                <VisualState.StateTriggers>
                                    <StateTrigger IsActive="{Binding IsEnoughSpace}" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                  

                                    <Setter Target="ListSpace.Visibility" Value="Visible" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
