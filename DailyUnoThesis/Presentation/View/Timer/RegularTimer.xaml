Tag="{StaticResource AccentBlueLightBrush}" Foreground="{StaticResource InkBlueLightBrush}" />

                                    <Button FontSize="28" FontWeight="Bold" Content="{Binding CountupTimer.IsPaused, Converter={StaticResource BoolToStringPlayButtonConverter}}" Command="{Binding StartCountupTimer}" VerticalAlignment="Bottom" Style="{StaticResource TextsButtonStyle}"
                                               helperstyle:ButtonHelper.IconGlyph="{Binding CountupTimer.IsPaused, Converter={StaticResource PlayPauseIconConverter}}"
Tag="{StaticResource AccentBlueLightBrush}" Foreground="{StaticResource InkBlueLightBrush}"/>
                                </StackPanel>
                                </StackPanel >
