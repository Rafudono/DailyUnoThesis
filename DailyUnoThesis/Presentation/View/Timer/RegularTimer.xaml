                                                                                <ColumnDefinition/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel Grid.Column="1"  Margin="3,10,0,10" HorizontalAlignment="Left">
                                                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                                                    <TextBlock x:Name="TitleTextBlock" Text="{Binding Title}"   FontSize="25" TextWrapping="NoWrap" Foreground="{ThemeResource InkBlueLightBrushOver}" FontWeight="Medium"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Top" HorizontalAlignment="Stretch" MaxLines="1" FontFamily="Segoe Print"/>
                                                                                    <!-- Линия зачеркивания - стилизуем цветом "Clue Red" -->
                                                                                    <Rectangle x:Name="StrikeLine" Height="2" Margin="0 8 0 0"  Fill="{ThemeResource DividerDarkBrush}" HorizontalAlignment="Stretch"  VerticalAlignment="Center"
                                                                   RenderTransformOrigin="0,0.5" IsHitTestVisible="False">
                                                                                        <Rectangle.RenderTransform>
                                                                                            <ScaleTransform x:Name="StrikeLineScale" ScaleX="0"/>
                                                                                        </Rectangle.RenderTransform>
                                                                                    </Rectangle>
                                                                                </Grid>


                                                                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                                                                    <TextBlock FontFamily="Comic Sans MS" x:Name="DateTextBlock" Visibility="{Binding EndDate, Converter={StaticResource ConverterTextBoxVisibility}}"
                                                                   Foreground="{ThemeResource InkBlueLightBrush}" FontSize="13" >
                                                            <Run Text="&#xE163;" FontFamily="Segoe MDL2 Assets"/>
                                                            <Run Text="{Binding EndDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:dd.MM.yyyy}'}"/>
                                                                                    </TextBlock>
                                                                                    <TextBlock FontFamily="Comic Sans MS" x:Name="CategoryTextBlock" Visibility="{Binding CategoryId, Converter={StaticResource ConverterTextBoxVisibility}}"
                                                                   Foreground="{ThemeResource InkBlueLightBrush}" FontSize="13">
                                                            <Run Text="#"/>
                                                            <Run Text="{Binding Category.Title}"/>
                                                                                    </TextBlock>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Grid>


                                                                    </Grid>
                                                                    <Grid Background="{StaticResource BackgroundLightBrush}" HorizontalAlignment="Stretch" Grid.ColumnSpan="4" VerticalAlignment="Bottom" Height="10"  Opacity="0.5"></Grid>


                                                                </Grid>

                                                            </Border>
                                                        </Grid>
                                                        </ListViewItem>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>

                                    </Grid>
                                </Border>

                            </Grid>
                        </Border>
                        <!--</Border>-->

                    </Grid>



                </Grid>

            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
