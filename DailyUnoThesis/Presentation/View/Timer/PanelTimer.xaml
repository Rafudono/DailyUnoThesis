<Page x:Class="DailyUnoThesis.Presentation.View.Timer.PanelTimer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="using:DailyUnoThesis.Presentation.View.Timer"
      xmlns:control="using:DailyUnoThesis.Presentation.ViewModel.TimerPagesControle"
      mc:Ignorable="d" 
       DataContext="DynamicResource Control"
      d:DesignHeight="450" d:DesignWidth="800">
    <Page.Resources>
        <control:PanelTimerControle x:Key="Control"/>
    </Page.Resources>

    <Grid Background="DarkSeaGreen">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.06*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid MinHeight="30" MaxHeight="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Content="Pomodoro" Command="{Binding OpenPomodoroPage}"/>
                <Button Content="RugularTimer" Grid.Column="1" Command="{Binding OpenRegularTimerPage}"/>
                <Button Content="Statistic" Grid.Column="2"/>

            </Grid>
            <Frame Grid.Row="1" Content="{Binding CurPageTimer}"/>

        </Grid>
        
    </Grid>
</Page>
