<Page x:Class="DailyUnoThesis.Presentation.View.Timer.PanelTimer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:DailyUnoThesis.Presentation"
       xmlns:pages="using:DailyUnoThesis.Presentation.View.Pages"
       xmlns:cal="using:DailyUnoThesis.Presentation.View.Calendar"
      xmlns:controlepage="using:DailyUnoThesis.Presentation.ViewModel.NavigationClasses"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">
    <Page.Resources>
        <!--<control:PanelTimerControle x:Key="Control"/>-->
        <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="SystemControlTransparentBrush" />
    </Page.Resources>

    <ScrollViewer IsTabStop="True">
        <Grid  uen:Region.Attached="True" utu:SafeArea.Insets="VisibleBounds">

            <Grid Background="DarkSeaGreen">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.1" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <NavigationView OpenPaneLength="170" IsPaneOpen="False" uen:Region.Attached="true"
                  Grid.Row="1" IsSettingsVisible="False">
                    <NavigationView.MenuItems>
                         <!--Tag должен совпадать с именами в маршрутах--> 
                        <NavigationViewItem Icon="Clock" Content="Помодоро"
                              uen:Region.Name="PomodoroTimer" />
                        <NavigationViewItem Icon="Clock" Content="Обычный"
              uen:Region.Name="RegularTimers" />
                        <NavigationViewItem Icon="Clock" Content="Analize"
              uen:Region.Name="Analize" />

                    </NavigationView.MenuItems>
                    <Grid uen:Region.Attached="True"
            uen:Region.Navigator="Visibility"
            Grid.Row="1">
                        <Grid uen:Region.Name="Analize"
                      Visibility="Collapsed">
                            <TextBlock Text="Analize"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </NavigationView>
                <!--<SelectorBar Grid.Row="1" x:Name="SelectorBar2" >
                    <SelectorBarItem Icon="Clock" Text="Помодоро" uen:Region.Name="PomodoroTimer"/>
                    <SelectorBarItem x:Name="SelectorBarItemPage2" Icon="Clock" Text="Обычный" uen:Region.Name="RegularTimers" />
                    <SelectorBarItem x:Name="SelectorBarItemPage3" Icon="Clock" Text="Analize" uen:Region.Name="Analize" />
                </SelectorBar>-->

            </Grid>

        </Grid>
    </ScrollViewer>

    <!--<Grid Background="DarkSeaGreen">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.06*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid MinHeight="30" MaxHeight="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Content="Pomodoro" Command="{Binding OpenPomodoroPage}"/>
                <Button Content="RugularTimer" Grid.Column="1" Command="{Binding OpenRegularTimerPage}"/>
                <Button Content="Statistic" Grid.Column="2"/>

            </Grid>
            <Frame Grid.Row="1" Content="{Binding CurPageTimer}"/>

        </Grid>
        
    </Grid>-->
</Page>
