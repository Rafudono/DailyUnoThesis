SuggestionChosen="{x:Bind ViewModel.OnSuggestionChosen}" QuerySubmitted="{x:Bind ViewModel.OnQuerySubmitted}"
VerticalAlignment="Top" MaxHeight="40" MinWidth="300" >
                                                <AutoSuggestBox.ItemContainerStyle>
                                                    <Style TargetType="InfoBarPanel">
                                                        <Setter Property="Background" Value="{StaticResource StickerBrush}"/>
                                                        <!--<Setter Property="MinWidth" Value="450"/>-->
                                                    </Style>
                                                </AutoSuggestBox.ItemContainerStyle>
                                                <AutoSuggestBox.ItemTemplate>
                                                    <DataTemplate x:DataType="double:MissionSuggestionDto" >
                                                        <StackPanel Spacing="0" Margin="10,0">
                                                            <Border HorizontalAlignment="Left" BorderThickness="0,0,0,1" BorderBrush="#00224d" Padding="0,0,0,0">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" FontFamily="Segoe Print" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{StaticResource InkBlueLightBrush}"/>
                                                            </Border>

                                                        </StackPanel>
                                                    </DataTemplate>
                                                </AutoSuggestBox.ItemTemplate>
                                            </AutoSuggestBox>

                                            <Grid>




                                                <ListView x:Name="SampleTimerList" ItemsSource="{Binding Missionstimers}" SelectedItem="{Binding SelectedMissionstimer, Mode=TwoWay}"  SelectionMode="Single" 
                           IsItemClickEnabled="True"  >
                                                <ListView.ItemTemplate>
                                                    <DataTemplate x:DataType="mod:Missionstimer">
                                                    <Grid  Margin="0" x:Name="GridRootBorder" Height="70" Background="Transparent">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="0"/>
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RenderTransform>
                                                    <CompositeTransform />
                                                </Grid.RenderTransform>

                                            <Border x:Name="RootBorder" Padding="0 3 0 -5" MinWidth="300" CornerRadius="4" Background="Transparent" Grid.Column="1" Margin="0"
                                  BorderBrush="{ThemeResource SystemControlBackgroundListMediumBrush}" BorderThickness="0 0 0 1"   RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top" Height="70" MinHeight="0">
                                                <Border.RenderTransform>
                                                    <CompositeTransform />
                                                </Border.RenderTransform>
                                                <Grid HorizontalAlignment="Stretch" Background="Transparent" >
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Колонки для линий вложенности -->
                                                        <!--<ColumnDefinition Width="0.05*" />-->
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Левая часть: Линии (Нити) -->
                                                    <!-- Ширина этого блока будет зависеть от уровня вложенности -->

                                                    <Grid  Background="Transparent" Grid.Column="1"  MinWidth="200" IsHitTestVisible="True">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition />
                                                            <ColumnDefinition Width="0.1*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <interactivity:Interaction.Behaviors>
                                                                
                                                         <!--Когда курсор входит в Grid--> 
                                                        
                                                                <core:EventTriggerBehavior EventName="PointerEntered">
                                                                                                                            
                                                                    <core:ChangePropertyAction TargetObject="{Binding ElementName=RootBorder}" PropertyName="BorderBrush" Value="{StaticResource BackgroundDarkBrush}"/>
                                                                    
                                                        <core:ChangePropertyAction TargetObject="{Binding ElementName=TitleTextBlock}" PropertyName="Foreground" Value="{StaticResource InkBlueLightBrush}"/>
                                                        
                                                                </core:EventTriggerBehavior>
                                                                
                                                         <!--Когда курсор выходит из Grid--> 
                                                        
                                                                <core:EventTriggerBehavior EventName="PointerExited">
                                                                    
                                                        
                                                                    <core:ChangePropertyAction TargetObject="{Binding ElementName=RootBorder}" PropertyName="BorderBrush" Value="{ThemeResource SystemControlBackgroundListMediumBrush}"/>
                                                                    
                                                        <core:ChangePropertyAction TargetObject="{Binding ElementName=TitleTextBlock}" PropertyName="Foreground" Value="{StaticResource InkBlueLightBrushOver}"/>
                                                        
                                                                </core:EventTriggerBehavior>
                                                            </interactivity:Interaction.Behaviors>
                                                        
                                                        <Grid Width="Auto"  Padding="0" MinHeight="65" IsHitTestVisible="True">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="0.1*" MaxWidth="50" MinWidth="32"/>
                                                                        <ColumnDefinition/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="1"  Margin="3,10,0,10" HorizontalAlignment="Left">
                                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                                                    <TextBlock x:Name="TitleTextBlock" Text="{Binding TitleMission}"   FontSize="17" TextWrapping="NoWrap" Foreground="{ThemeResource InkBlueLightBrushOver}" FontWeight="Medium"
                                                         TextTrimming="CharacterEllipsis" VerticalAlignment="Top" HorizontalAlignment="Stretch" MaxLines="1" FontFamily="Segoe Print"/>
                                                                                </Grid>


                                                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                                                    <TextBlock FontFamily="Comic Sans MS" x:Name="DateTextBlock" Visibility="{Binding Mission.EndDate, Converter={StaticResource ConverterTextBoxVisibility}}"
                                                         Foreground="{ThemeResource InkBlueLightBrush}" FontSize="12" >
                                                  <Run Text="&#xE163;" FontFamily="Segoe MDL2 Assets"/>
                                                  <Run Text="{Binding Mission.EndDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:dd.MM.yyyy}'}"/>
                                                                    </TextBlock>
                                                                                    <TextBlock FontFamily="Comic Sans MS" x:Name="CategoryTextBlock" Visibility="{Binding Mission.CategoryId, Converter={StaticResource ConverterTextBoxVisibility}}"
                                                         Foreground="{ThemeResource InkBlueLightBrush}" FontSize="12">
                                                  <Run Text="#"/>
                                                  <Run Text="{Binding Mission.Category.Title}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>


                                                    </Grid>
                                                    <Grid Background="{StaticResource BackgroundLightBrush}" HorizontalAlignment="Stretch" Grid.ColumnSpan="4" VerticalAlignment="Bottom" Height="10"  Opacity="0.8"></Grid>


                                                </Grid>

                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>



                                        
                                    </Grid>

                                    </StackPanel>
                                       
                                    </Grid>
                                </ScrollViewer>



                            </Grid>
                    </Border>

                </Grid>
            </Border>
            <!--</Border>-->

        </Grid>

           

        </Grid>

    </Grid>
</Page>
