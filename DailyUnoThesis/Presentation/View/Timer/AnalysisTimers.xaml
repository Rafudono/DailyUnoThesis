<Page
    x:Class="DailyUnoThesis.Presentation.View.Timer.AnalysisTimers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DailyUnoThesis.Presentation.View.Timer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
      xmlns:con="using:DailyUnoThesis.Models.Conventers"

               xmlns:mod="using:DailyUnoThesis.Models.MainClasses"
           xmlns:double="using:DailyUnoThesis.Models.DobleClasses"
      xmlns:helperstyle="using:DailyUnoThesis.Styles.Dictionary"
     xmlns:pages="using:DailyUnoThesis.Presentation.View.Pages"
 xmlns:cal="using:DailyUnoThesis.Presentation.View.Calendar"
xmlns:controlepage="using:DailyUnoThesis.Presentation.ViewModel.NavigationClasses"
xmlns:uen="using:Uno.Extensions.Navigation.UI"
xmlns:utu="using:Uno.Toolkit.UI"
xmlns:um="using:Uno.Material"
NavigationCacheMode="Required"

    xmlns:winui="using:Microsoft.UI.Xaml.Controls"
    xmlns:lottie="using:CommunityToolkit.WinUI.Lottie"
    
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    
          xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
xmlns:core="using:Microsoft.Xaml.Interactions.Core"
      xmlns:ut="using:Uno.Themes"
    
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <con:MaxTimerConventer x:Key="MaxLength"/>
        <con:StringToIntConverter x:Key="StringToInt"/>
        <!--<control:PomodoroTimerControle x:Key="Control"/>-->
        <con:StringFormatTimeConverter x:Key="StringFormatTimeConverter"/>
        <con:PlayPauseIconConverter x:Key="PlayPauseIconConverter"/>
        <con:BoolToStringPlayButtonConverter x:Key="BoolToStringPlayButtonConverter"/>
        <con:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <con:ArrowControlEnabledConventer x:Key="ArrowControlEnabledConventer"/>
        <con:ArrowBackControlEnabledConventer x:Key="ArrowBackControlEnabledConventer"/>
        <con:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <con:HeightConventer x:Key="HeightConventer"/>
        <con:BoolToStringRoundTomatosConverter x:Key="BoolToStringRoundTomatosConverter"/>
        <con:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
        <con:MinutesToWidthConverter x:Key="MinutesToWidthConverter"/>
        <con:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>






        <!--HeightConventer-->

        <con:LevelToMarginConverter x:Key="LevelToMarginConverter" />
        <con:StringFormatConverter x:Key="StringFormatConverter" />
        <con:LevelVisibilityConverter x:Key="LevelVisibilityConverter"/>
        <con:DateTimeToOffsetConverter x:Key="DateTimeToOffsetConverter"/>
        <con:LevelTextBoxVisibilityConverter x:Key="LevelTextBoxVisibilityConverter"/>
        <con:LevelComboBoxVisibilityConverter x:Key="LevelComboBoxVisibilityConverter"/>
        <con:NullToVisibilityConverterTextBoxCategory x:Key="ConverterTextBoxVisibility"/>
        <con:VisibilityButtonToText x:Key="VisibilityButtonToText"/>
        <con:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <con:BoolToAngleConverter x:Key="BoolToAngleConverter"/>
        <con:PercentageToWidthConverter x:Key="PercentageToWidthConverter"/>




        <Style TargetType="ListViewItem" x:Key="ListViewItemNoHoverStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>

            <!-- Отключаем визуальные состояния при наведении/фокусе/выборе -->
            <Setter Property="Template" >
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <!-- Отключаем эффект при наведении -->
                                    <VisualState x:Name="Pressed"/>
                                    <VisualState x:Name="Selected"/>
                                    <VisualState x:Name="PointerOverSelected"/>
                                    <VisualState x:Name="PressedSelected"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused"/>
                                    <VisualState x:Name="Unfocused"/>
                                    <VisualState x:Name="PointerFocused"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter/>
                            <!-- Просто отображаем контент, без лишних оберток -->
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="ms-appx:///Assets/PapersDoc.jpg" 
Stretch="UniformToFill" 
Opacity="0.8"/>
            <!-- Опционально: сделать фон менее ярким -->
        </Grid.Background>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PaneStates">

                <VisualState x:Name="TopPanel">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding IsPaneOpen}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TopListPanel.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            
                <VisualStateGroup>
                    <VisualState x:Name="SmallWindow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1100"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <!-- Пример: Уменьшаем шрифт для определенных TextBlock -->
                        <Setter Target="MainTime.FontSize" Value="56"/>
                        <Setter Target="Pretext.FontSize" Value="24"/>
                        <Setter Target="TotalTime.FontSize" Value="36"/>

                        <Setter Target="Focus.FontSize" Value="20"/>
                        <Setter Target="TextFocus.FontSize" Value="40"/>

                        <Setter Target="FrequentTime.FontSize" Value="20"/>
                        <Setter Target="TextFrequentTime.FontSize" Value="30"/>
                            
                        <!--<Setter Target="Pretext.FontSize" Value="9"/>-->
                        <Setter Target="TitleProgressRing.FontSize" Value="26"/>

                        <Setter Target="MaximumSession.FontSize" Value="18"/>
                        <Setter Target="AverageSessionTime.FontSize" Value="18"/>
                        <Setter Target="NumberLaunches.FontSize" Value="18"/>

                        <Setter Target="TextMaximumSession.FontSize" Value="26"/>
                        <Setter Target="TextAverageSessionTime.FontSize" Value="26"/>
                        <Setter Target="TextNumberLaunches.FontSize" Value="26"/>




                        <!-- И так для каждого TextBlock, которому нужна адаптация -->
                        </VisualState.Setters>
                    </VisualState>
                    <!--<VisualState x:Name="LargeWindow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="501"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                             --><!--Пример: Увеличиваем шрифт--><!-- 
                            <Setter Target="MyBigTitleTextBlock.FontSize" Value="36"/>
                            <Setter Target="MyBodyTextBlock.FontSize" Value="18"/>
                        </VisualState.Setters>
                    </VisualState>-->
                </VisualStateGroup>

            <VisualStateGroup>
                <VisualState x:Name="VisibilityTwoStatistics">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="700"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>

                        <Setter Target="StatisticsInBox.Visibility" Value="Visible"/>
                        <Setter Target="StatisticsOutsideBox.Visibility" Value="Collapsed"/>

                       

                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>

            <VisualStateGroup>
                <VisualState x:Name="ContentResetsTime">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="500"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>

                        <Setter Target="ResetsTimeline.Content" Value="СБРОСИТЬ"/>
                        <Setter Target="ResetsWeekDailyWorkHours.Content" Value="СБРОСИТЬ"/>

                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>


        </VisualStateManager.VisualStateGroups>


        <ScrollViewer Grid.ColumnSpan="2" >
            <StackPanel Padding="20 40" Spacing="30" >

              




                <StackPanel Padding="0 20 0 40" Spacing="30" >
                   
                    <!-- Фон миллиметровки -->

                    <!-- Верхний заголовок -->
                  
                    <!--<TextBlock Text="{Binding Text}"/>-->

                    <!-- Карточки с ключевыми показателями -->
                    <Border Background="#F4F7F9" BorderBrush="#ADB5BD" BorderThickness="1" Padding="10">
                        <StackPanel Spacing="30">
                            <Border BorderBrush="#ADB5BD" BorderThickness="0 0 0 1">
                                <TextBlock Text="СТАТИСТИКА УЧЕТА ВРЕМЕНИ" Foreground="{StaticResource InkBlueLightBrush}"
 FontSize="24" FontFamily="Segoe Print" FontWeight="Bold" 
 HorizontalAlignment="Center" Opacity="0.8"/>
                            </Border>

                            <Grid Background="#F4F7F9" BorderBrush="#ADB5BD">
                            <!--<Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>-->
                            <VariableSizedWrapGrid Orientation="Horizontal"  VerticalAlignment="Top" HorizontalAlignment="Center" >

                                <!-- Карточка: Всего отработано -->
                                <StackPanel Background="#F4F7F9"  Grid.Column="0" Margin="20 20" HorizontalAlignment="Center" BorderBrush="Black" BorderThickness="1 0 1 0" Padding="10" Width="250" Height="130">
                                    <TextBlock Text="ОБЩЕЕ ВРЕМЯ" Foreground="{StaticResource InkBlueLightBrush}" FontSize="12" Opacity="0.6" TextAlignment="Center" HorizontalAlignment="Center" FontFamily="Segoe Print"/>
                                    <TextBlock Text="{Binding TimeAnalyticsSummary.TotalWorkTime}" FontSize="36" Foreground="{StaticResource InkBlueLightBrush}" FontFamily="Comic Sans MS" FontWeight="Bold" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="за неделю" FontSize="12" Opacity="0.4" TextAlignment="Center" HorizontalAlignment="Center" FontFamily="Segoe Print"/>
                                </StackPanel>

                                <!-- Карточка: Средняя сессия -->
                                <StackPanel Background="#F4F7F9" Grid.Column="1" Margin="20 20" HorizontalAlignment="Center"  BorderBrush="Black" BorderThickness="1 0 1 0" Padding="10" Width="250" Height="130">
                                    <TextBlock Text="СРЕДНЯЯ АКТИВНОСТЬ" Foreground="{StaticResource InkBlueLightBrush}" FontSize="12" Opacity="0.6" TextAlignment="Center" HorizontalAlignment="Center" FontFamily="Segoe Print"/>
                                    <TextBlock Text="{Binding TimeAnalyticsSummary.AverageSession}" Foreground="{StaticResource InkBlueLightBrush}" FontSize="36" FontFamily="Comic Sans MS" FontWeight="Bold" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="длительность" FontSize="10" Opacity="0.4" TextAlignment="Center" HorizontalAlignment="Center" FontFamily="Segoe Print"/>
                                </StackPanel>

                                <!-- Карточка: Активных дней -->
                                <StackPanel Background="#F4F7F9" Grid.Column="2" Margin="20 20" HorizontalAlignment="Center"  BorderBrush="Black" BorderThickness="1 0 1 0" Padding="10" Width="250" Height="130">
                                    <TextBlock Text="АКТИВНЫХ ДНЕЙ" FontSize="12" Opacity="0.6" Foreground="{StaticResource InkBlueLightBrush}" TextAlignment="Center" HorizontalAlignment="Center" FontFamily="Segoe Print"/>
                                    <TextBlock Text="{Binding TimeAnalyticsSummary.ActiveDaysCount}" Foreground="{StaticResource InkBlueLightBrush}" FontSize="36" FontFamily="Comic Sans MS" FontWeight="Bold" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="за неделю" FontSize="10" Opacity="0.4" TextAlignment="Center" HorizontalAlignment="Center" FontFamily="Segoe Print"/>
                                </StackPanel>

                                <!-- Карточка: Пик активности (Пример) -->
                                <StackPanel Background="#F4F7F9" Grid.Column="3" Margin="20 20" HorizontalAlignment="Center"  BorderBrush="Black" BorderThickness="1 0 1 0" Padding="10" Width="250" Height="130">
                                    <TextBlock Text="ПИК АКТИВНОСТИ" FontSize="12" Foreground="{StaticResource InkBlueLightBrush}" Opacity="0.6" TextAlignment="Center" HorizontalAlignment="Center" FontFamily="Segoe Print"/>
                                    <TextBlock FontSize="24" FontFamily="Segoe Print" FontWeight="Bold" Margin="0,5,0,0" HorizontalAlignment="Center" Foreground="{StaticResource InkBlueLightBrush}">
                                    <Run Text="{Binding TimeAnalyticsSummary.PeakActivityDay}"/>
                                    </TextBlock>
                                    <!--<TextBlock Text="(1ч 30м)" FontSize="14" Opacity="0.4" TextAlignment="Center" HorizontalAlignment="Center"/>-->
                                </StackPanel>
                            </VariableSizedWrapGrid>
                        </Grid>

                        </StackPanel>
                    </Border>

                    <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,30,0">
                    <Border Background="#FFF8DC" Width="250" Height="150" CornerRadius="1" 
HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-40,30,0" BorderBrush="{StaticResource StickerBrush}" BorderThickness="1" 
RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform Angle="5"/>
                        </Border.RenderTransform>
                            <TextBlock Text=""  TextAlignment="Justify" Foreground="{StaticResource InkBlueLightBrush}"
       FontSize="14" FontFamily="Segoe Print" TextWrapping="Wrap" Opacity="0.7"
       Padding="5">
                                <Run Text="Заметки:" FontSize="16"/>
                                <Run Text="{Binding TimeAnalyticsSummary.MotivationalNote}"/>
                            </TextBlock>
                    </Border>
                    <Viewbox Width="30" Height="60" 
   HorizontalAlignment="Right" 
   VerticalAlignment="Top" 
   Margin="0,-15,50,0">
                        <!--Отрицательный Margin выносит её наверх-->
                        <Path Data="M 20,40 L 20,80 A 15,15 0 0 0 50,80 L 50,30 A 20,20 0 0 0 10,30 L 10,90 A 25,25 0 0 0 60,90 L 60,40"
Stroke="#5D6D7E" 
StrokeThickness="4" 
StrokeStartLineCap="Round" 
StrokeEndLineCap="Round"
StrokeLineJoin="Round"
Width="30" Height="60"
Stretch="Uniform"
HorizontalAlignment="Left" VerticalAlignment="Top"
Margin="20,-50,0,0">
                            <Path.RenderTransform>
                                <RotateTransform Angle="-25"/>
                            </Path.RenderTransform>
                        </Path>
                    </Viewbox>
                    </Grid>

                





                    
                    <StackPanel Spacing="20" Margin="0,0,0,20">

                     

                        <ScrollViewer  HorizontalScrollBarVisibility="Auto" 
VerticalScrollBarVisibility="Auto"
HorizontalScrollMode="Enabled" 
VerticalScrollMode="Enabled">
                            <!--ВАША ДИАГРАММА (ItemsControl)-->
                            <Border Background="#F4F7F9" BorderBrush="#ADB5BD" BorderThickness="1" Padding="10">

                                <StackPanel>
                                    <!--Заголовок с диапазоном дат и стрелками-->
                                    <Grid Width="500" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
                                            <!--Кнопка "Назад"-->
                                            <Button Content="&#xE72B;" FontFamily="Segoe Print" 
         Command="{Binding MoveToPreviousWeek}"
         Style="{StaticResource TextsButtonStyle}" Tag="{StaticResource AccentBlueLightBrush}" Foreground="{StaticResource InkBlueLightBrush}" />

                                            <!--ДИАПАЗОН ДАТ-->
                                            <StackPanel VerticalAlignment="Center" Margin="0 -5 0 0">
                                                <TextBlock Text="ОТЧЕТНЫЙ ПЕРИОД" Foreground="{StaticResource InkBlueLightBrush}" FontSize="9" FontFamily="Segoe Print" Opacity="0.5"/>
                                                <TextBlock Text="{Binding WeekRangeDisplay}" 
                FontSize="18" FontFamily="Comic Sans MS" FontWeight="Bold" Foreground="{StaticResource InkBlueLightBrush}"/>
                                            </StackPanel>

                                            <!--Кнопка "Вперед"-->
                                            <Button Content="&#xE72A;" FontFamily="Segoe Print" 
         Command="{Binding MoveToNextWeek}"
         Style="{StaticResource TextsButtonStyle}"  Tag="{StaticResource AccentBlueLightBrush}" Foreground="{StaticResource InkBlueLightBrush}"/>

                                            <!--Кнопка "Сегодня" (возврат к текущей неделе)-->
                                            <Button Content="" helperstyle:ButtonHelper.IconGlyph="&#xE895;"
HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-10 0 0 0"
FontSize="13" FontFamily="Segoe Print" x:Name="ResetsWeekDailyWorkHours"
Command="{Binding MoveToCurrentWeek}"
Style="{StaticResource TextsButtonStyle}" Tag="{StaticResource AccentBlueLightBrush}" Foreground="{StaticResource InkBlueLightBrush}"/>
                                        </StackPanel>


                                    </Grid>
                               
                                <Grid>
                                    <ListView ItemsSource="{Binding DailyWorkHoursData}" SelectionMode="Extended"  >
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="double:DailyWorkHoursDto">
                                                <Grid Height="40">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30"/>
                                                        <!--День недели-->
                                                        <ColumnDefinition Width="Auto"/>
                                                        <!--Столбик-->
                                                        <ColumnDefinition Width="*"/>
                                                        <!--Время-->
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.ColumnSpan="3" BorderBrush="#D1D8E0" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" Opacity="0.5"/>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!--1. День недели-->
                                                            <TextBlock Grid.Column="0" Text="{Binding DayOfWeek}" Foreground="{StaticResource InkBlueLightBrush}" FontSize="14" FontFamily="Segoe Print" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <Border BorderBrush="#D1D8E0" BorderThickness="0,0,1.5,0" HorizontalAlignment="Right" Opacity="0.8" Margin="6 -5"/>
                                                    </StackPanel>
                                                    <!--2. Столбик (растет вправо)-->
                                                    <Border Grid.Column="1" Background="{StaticResource DividerLightBrush}" Height="35" Width="{Binding NormalizedWidth}" CornerRadius="0,2,2,0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0">
                                                        <ToolTipService.ToolTip>
                                                            <ToolTip Content="{Binding TotalWorkTime}"/>
                                                        </ToolTipService.ToolTip>
                                                    </Border>
                                                    <!--3. Текст с временем в конце-->
                                                        <TextBlock Grid.Column="1" Text="{Binding TotalWorkTime}" Foreground="{StaticResource InkBlueLightBrush}" FontSize="16" FontFamily="Comic Sans MS" VerticalAlignment="Center" FontWeight="Bold"  Margin="6 0" Opacity="1"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Grid Background="Transparent"/>
                                </Grid>

                                    </StackPanel>

                            </Border>
                        </ScrollViewer>
                    </StackPanel>




                    <Border Background="#FDFDFD" Visibility="Collapsed"
        BorderBrush="#ADB5BD" 
        BorderThickness="1" 
        Padding="20" 
        Margin="0,20,0,0">

                        <StackPanel Spacing="15">
                            <!-- Заголовок блока -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                                <FontIcon Glyph="&#xE8EF;" FontSize="16" Opacity="0.6"/>
                                <TextBlock Text="АНАЛИЗ ПОРТФЕЛЯ ДЕЛ" Foreground="{StaticResource InkBlueLightBrush}"
                       FontSize="14" FontFamily="Segoe Print" FontWeight="Bold" Opacity="0.8"/>
                            </StackPanel>

                            <ScrollViewer  HorizontalScrollBarVisibility="Auto" 
VerticalScrollBarVisibility="Auto"
HorizontalScrollMode="Enabled" 
VerticalScrollMode="Enabled">

                                <Grid>
                                    <!-- ListView для отображения списка задач -->
                                <ListView ItemsSource="{Binding TaskDistributionData}"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  Background="Transparent"
                  BorderThickness="0">
                                    <!-- Задаем высоту, чтобы сделать его скроллируемым -->

                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="double:TaskDistributionDto">
                                            <Grid Height="45" Margin="0,0,0,10">
                                                <!-- Увеличили высоту строки -->
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- День недели (здесь будет название задачи) -->
                                                    <ColumnDefinition Width="100"/>
                                                    <!-- Столбик (фиксированная ширина) -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- Время -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Горизонтальная линия-разделитель под строкой -->
                                                <Border Grid.ColumnSpan="3" BorderBrush="#D1D8E0" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" Opacity="0.9"/>

                                                <!-- 1. Название задачи -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TaskName}" 
                                       FontSize="13" FontFamily="Segoe Print" FontWeight="Bold" 
                                       Foreground="{StaticResource InkBlueLightBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                    <!-- Ограничим ширину названия -->

                                                    <!-- Вертикальный разделитель справа от названия -->
                                                    <Border BorderBrush="#D1D8E0" BorderThickness="0,0,1.5,0" Height="30" Opacity="0.8" Margin="10 -5"/>
                                                </StackPanel>

                                                <!-- 2. Столбик (растет вправо) -->
                                                <Border Grid.Column="1" 
                                Background="{StaticResource DividerLightBrush}" 
                                                Height="25" 
                                Width="{Binding Percentage, Converter={StaticResource PercentageToWidthConverter}, ConverterParameter=500}" 
                                CornerRadius="0,2,2,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="0,0,0,0">
                                                    <!-- Можно взять цвет из ресурсов -->
                                                    <ToolTipService.ToolTip>
                                                        <ToolTip Content="{Binding ToolTipContent}"/>
                                                    </ToolTipService.ToolTip>
                                                </Border>

                                                <!-- 3. Время -->
                                                <TextBlock Grid.Column="2" 
                                   Text="{Binding FormattedTime}" Foreground="{StaticResource InkBlueLightBrush}"
                                   FontSize="13" FontFamily="Comic Sans MS" 
                                   VerticalAlignment="Center" 
                                   Margin="10,0,0,0" Opacity="1"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                    <Grid Background="Transparent"/>
                                </Grid>
                            </ScrollViewer>

                            <TextBlock Text="* ОБЩЕЕ ВРЕМЯ ПО ЗАДАЧАМ" Foreground="{StaticResource InkBlueLightBrush}"
                   FontSize="9" FontFamily="Segoe Print" Opacity="0.4" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>



                    


                    

                 







                    

                    <!--КРУГОВАЯ ДИАГРАММА-->
                    <Border Background="#FDFDFD" BorderBrush="#ADB5BD" BorderThickness="1" Padding="25">
                        <Grid >
                            
                       
                        <StackPanel Spacing="25">


                                <Button Height="35" FontFamily="Comic Sans MS" x:Name="SampleButton"  MaxHeight="40"  
                                                        Style="{StaticResource StampTogButtonStyle}" helperstyle:ButtonHelper.IconGlyph="&#xE713;"
                                                        FontWeight="Bold"  HorizontalAlignment="Right" Command="{Binding OpenPanelSample}">
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <TextBlock FontFamily="Segoe Print" FontWeight="Bold" VerticalAlignment="Top" FontSize="16" Text="Выбрать задачу" IsHitTestVisible="False" Background="Transparent" Padding="0" Margin="2 -5 0 0" ></TextBlock>

                                    </StackPanel>
                                </Button>
                            
                                <!-- Заголовок задачи -->
                                <StackPanel Margin="0 -20 0 0">
                                    <TextBlock Text="АНАЛИЗ ВРЕМЕНИ ЗАДАЧИ:" Foreground="{StaticResource InkBlueLightBrush}" FontSize="16" FontFamily="Segoe Print" Opacity="1"/>
                                <TextBlock Text="{Binding SelectedTaskAnalysis.TaskName}" 
                       FontSize="22" FontFamily="Comic Sans MS" FontWeight="Bold" Foreground="{StaticResource InkBlueLightBrush}"/>
                                <Border BorderBrush="#D1D8E0" BorderThickness="0,0,0,2" Margin="0,5,0,0"/>
                            </StackPanel>

                                
                                <!-- БЛОК С КРУГОВОЙ ДИАГРАММОЙ -->
                            <Grid Background="#F8F9FA" Padding="20 20 0 20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.ColumnSpan="2" Text="ВРЕМЯ ОТ ОБЩЕГО ОБЪЕМА:" FontSize="13" FontFamily="Segoe Print" Foreground="{StaticResource InkBlueLightBrush}" Margin="0,-15,0,5" x:Name="TitleProgressRing"/>
                                    <!-- 1. Круговой индикатор (ProgressRing) -->
                                <Grid Grid.Row="1" Grid.Column="0" MaxWidth="500" MinWidth="120" MaxHeight="500" MinHeight="120">
                                        <StackPanel>
                                            
                                            <Grid>
                                    <!-- Фон кольца -->
                                                <Ellipse Stroke="#E9ECEF" StrokeThickness="8" Name="FullEllipse"/>
                                    <!-- Само кольцо прогресса -->
                                    <ProgressRing Value="{Binding SelectedTaskAnalysis.GlobalPercentage}" 
                              IsIndeterminate="False" x:Name="ClockFace"
                              Width="120" Height="120" MaxWidth="500" MinWidth="120" MaxHeight="500" MinHeight="120"
                              Foreground="#4B5663" 
                              Background="Transparent"
                              />
                                    <!-- Текст процентов внутри -->
                                                <TextBlock Text="{Binding SelectedTaskAnalysis.GlobalPercentageFormatted}" x:Name="PercentageText"
