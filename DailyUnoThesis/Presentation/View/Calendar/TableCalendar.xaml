<Page x:Class="DailyUnoThesis.Presentation.View.Calendar.TableCalendar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:DailyUnoThesis.Presentation.View.Calendar"
      xmlns:control="using:DailyUnoThesis.Presentation.ViewModel.CalendarControls"
      xmlns:mod="using:DailyUnoThesis.Models.MainClasses"
      xmlns:con="using:DailyUnoThesis.Models.Conventers"
      xmlns:pro="using:DailyUnoThesis.Presentation.View.Calendar"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material"
      NavigationCacheMode="Required"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Loaded="OnLoaded" 
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <control:TableCalendarViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <!-- Конвертеры -->
        <con:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <con:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <con:DayOfWeekToShortStringConverter x:Key="DayOfWeekToShortStringConverter"/>

        <Style x:Key="CalendarTabButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe Print"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceSecondaryBrush}"/>
            
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                                <TextBlock x:Name="ContentText"
                                   Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <Border x:Name="Underline"
                            Height="2"
                            Background="{StaticResource InkBlueLightBrush}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Margin="8,-2,8,0"
                            Opacity="0"/>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentText.Foreground" 
                                            Value="{StaticResource InkBlueLightBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentText.Foreground" 
                                            Value="{StaticResource InkBlueLightBrushOver}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectedTabButtonStyle" TargetType="Button" BasedOn="{StaticResource CalendarTabButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource InkBlueLightBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                                <TextBlock x:Name="ContentText"
                                   Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <Border x:Name="Underline"
                            Height="2"
                            Background="{StaticResource InkBlueLightBrush}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Margin="8,0,8,0"
                            Opacity="1"/>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentText.Foreground" 
                                            Value="{StaticResource InkBlueLightBrushOver}"/>
                                            <Setter Target="Underline.Opacity" Value="0.7"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentText.Foreground" 
                                            Value="{StaticResource InkBlueLightBrushOver}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarDayGridStyle" TargetType="Grid">
            <Setter Property="Background">
                <Setter.Value>
                    <RadialGradientBrush Center="0.5,0.6" RadiusX="1" RadiusY="0.9" GradientOrigin="0.5,0.6">
                        <GradientStop Color="#f2eff5" Offset="0.02" />
                        <GradientStop Color="White" Offset="0.88" />
                        <GradientStop Color="#dfbba9" Offset="1.0" />
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для заголовка дня -->
        <Style x:Key="CalendarDayHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Print"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource InkBlueLightBrush}"/>
            <Setter Property="Margin" Value="5,5,0,0"/>
        </Style>

        <!-- Стиль для номера дня -->
        <Style x:Key="CalendarDayNumberStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Print"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource InkBlueLightBrushOver}"/>
            <Setter Property="Margin" Value="4,2,0,0"/>
        </Style>

        <!-- Стиль для ListView внутри дня -->
        <Style x:Key="CalendarListViewStyle" TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Стиль для элемента задачи в календаре -->
        <Style x:Key="CalendarMissionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource StickerBrush}"/>
            <Setter Property="CornerRadius" Value="8,4,8,4"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Page.Resources>



    <ScrollViewer IsTabStop="True">
        <Grid utu:SafeArea.Insets="VisibleBounds">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Календарь -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="0" Margin="10,0" Spacing="8">
                        <Button x:Name="MonthViewBtn" Content="Месяц"   Style="{StaticResource SelectedTabButtonStyle}"   Click="MonthView_Click"/>
                        <Button x:Name="WeekViewBtn"    Content="Неделя"   Style="{StaticResource CalendarTabButtonStyle}"  Click="WeekView_Click"/>
                    </StackPanel>
                    <Frame x:Name="CalendarViewFrame" Grid.Row="1"/>
                </Grid>

                <!-- Inbox с кнопкой добавления -->
                <Grid Grid.Column="1" Grid.RowSpan="2" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" 
             Content="+ Добавить задачу" 
             Margin="10" 
             HorizontalAlignment="Stretch"
             Click="OpenNewTaskFrame_Click"
             Style="{StaticResource AccentButtonStyle}"/>

                    <Grid Grid.Row="1">
                        <TreeView x:Name="InboxTree"
                   ItemsSource="{Binding InboxTreeMissions}"
                   SelectionMode="Single"
                   SelectedItem="{Binding SelectedMission, Mode=TwoWay}"
                   MinWidth="260">
                            <TreeView.ItemTemplate>
                                <DataTemplate x:DataType="mod:Mission">
                                    <TreeViewItem ItemsSource="{Binding InverseIdUpMissionNavigation}" IsExpanded="True">
                                        <StackPanel CanDrag="True"
                                     DragStarting="InboxMission_DragStarting"
                                     Margin="2,4">
                                            <TextBlock Text="{Binding Title}"
                                        FontFamily="Segoe Print"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FormattedTime}"
                                        FontSize="11"
                                        Foreground="{StaticResource ClueRedLightBrush}"/>
                                        </StackPanel>
                                    </TreeViewItem>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <Border x:Name="NewTaskFrameHost"
                 Visibility="Collapsed"
                 Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                 BorderBrush="{StaticResource DividerLightBrush}"
                 BorderThickness="1,0,0,0">
                            <Grid>
                                <Frame x:Name="NewTaskFrame"/>
                                <Button Content="&#xE10A;"
                         Click="CloseNewTaskFrame_Click"
                         FontSize="24"
                         FontFamily="Segoe MDL2 Assets"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,12,8,0"
                         Style="{StaticResource RedTextButtonStyle}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
