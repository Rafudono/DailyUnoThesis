<Page
    x:Class="DailyUnoThesis.Presentation.View.Calendar.MonthCalendarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DailyUnoThesis.Presentation.View.Calendar"
      xmlns:control="using:DailyUnoThesis.Presentation.ViewModel.CalendarControls"
      xmlns:mod="using:DailyUnoThesis.Models.MainClasses"
      xmlns:con="using:DailyUnoThesis.Models.Conventers"
      xmlns:pro="using:DailyUnoThesis.Presentation.View.Calendar"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:um="using:Uno.Material"
      NavigationCacheMode="Required"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <control:MonthCalendarViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <!-- Конвертеры -->
        <con:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <con:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <con:DayOfWeekToShortStringConverter x:Key="DayOfWeekToShortStringConverter"/>
        <con:TagColorToBrushConverter x:Key="TagColorToBrushConverter"/>

        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Pressed"/>
                                    <VisualState x:Name="Selected"/>
                                    <VisualState x:Name="SelectedPointerOver"/>
                                    <VisualState x:Name="SelectedPressed"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter 
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Margin="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NoPaddingListViewStyle" TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter 
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CalendarDayGridStyle" TargetType="Grid">
            <Setter Property="Background">
                <Setter.Value>
                    <RadialGradientBrush Center="0.5,0.6" RadiusX="1" RadiusY="0.9" GradientOrigin="0.5,0.6">
                        <GradientStop Color="#f2eff5" Offset="0.02" />
                        <GradientStop Color="White" Offset="0.88" />
                        <GradientStop Color="#dfbba9" Offset="1.0" />
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для заголовка дня -->
        <Style x:Key="CalendarDayHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Print"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource InkBlueLightBrush}"/>
            <Setter Property="Margin" Value="5,5,0,0"/>
        </Style>

        <!-- Стиль для номера дня -->
        <Style x:Key="CalendarDayNumberStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Print"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource InkBlueLightBrushOver}"/>
            <Setter Property="Margin" Value="4,2,0,0"/>
        </Style>

        <!-- Стиль для ListView внутри дня -->
        <Style x:Key="CalendarListViewStyle" TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Стиль для элемента задачи в календаре -->
        <Style x:Key="CalendarMissionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource StickerBrush}"/>
            <Setter Property="CornerRadius" Value="8,4,8,4"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid utu:SafeArea.Insets="VisibleBounds">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid  Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="&#xE76B;"  FontFamily="Segoe MDL2 Assets"  FontSize="16"
      Style="{StaticResource IconButtonStyle}" Command="{Binding PreviousMonthCommand}" Margin="10,0,0,0"/>

            <TextBlock Grid.Column="1" Text="{Binding MonthHeader, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
         FontFamily="Segoe Print" FontSize="18"/>

            <Button Grid.Column="2" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Style="{StaticResource IconButtonStyle}"
      Command="{Binding NextMonthCommand}" Margin="0,0,10,0"/>
        </Grid>

        <!-- Дни недели (7 колонок) -->
        <Grid Grid.Row="1" Margin="4,0,4,5" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Пн" Style="{StaticResource DayOfWeekHeaderStyle}"/>
            <TextBlock Grid.Column="1" Text="Вт" Style="{StaticResource DayOfWeekHeaderStyle}"/>
            <TextBlock Grid.Column="2" Text="Ср" Style="{StaticResource DayOfWeekHeaderStyle}"/>
            <TextBlock Grid.Column="3" Text="Чт" Style="{StaticResource DayOfWeekHeaderStyle}"/>
            <TextBlock Grid.Column="4" Text="Пт" Style="{StaticResource DayOfWeekHeaderStyle}"/>
            <TextBlock Grid.Column="5" Text="Сб" Style="{StaticResource DayOfWeekHeaderStyle}"/>
            <TextBlock Grid.Column="6" Text="Вс" Style="{StaticResource DayOfWeekHeaderStyle}"/>
        </Grid>

        <!-- Календарь -->
        <ItemsControl x:Name="CalendarDaysGrid" Grid.Row="2" ItemsSource="{Binding Days, Mode=OneWay}">
            <interactivity:Interaction.Behaviors>
                <pro:CalendarWidthBehavior/>
            </interactivity:Interaction.Behaviors>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4" Margin="2" CornerRadius="4"  
                                Background="{Binding IsOtherMonth, Converter={StaticResource BoolToColorConverter}, ConverterParameter='LightBlue'}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding DayNumber}"
                                         FontWeight="{Binding IsToday, Converter={StaticResource BoolToFontWeightConverter}}"
                                         Foreground="{Binding IsOtherMonth, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Gray'}"
                                         FontSize="12"
                                         Margin="2,0,0,2"/>

                        <ListView Grid.Row="1"  Style="{StaticResource NoPaddingListViewStyle}"
                                        ItemsSource="{Binding TasksSessions}"
                                        MinHeight="20"
                                        HorizontalAlignment="Stretch"
                                        SelectedItem="{Binding SelectedSession}"
                                        AllowDrop="True"
                                        Drop="PlannedListView_Drop"
                                        DragOver="PlannedListView_DragOver"
                                        DragLeave="PlannedListView_DragLeave"
                                        Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="mod:Mission">
                                    <Border x:Name="RootBorder"
                                                   Background="{Binding IdMissionNavigation.Tag, Converter={StaticResource TagColorToBrushConverter}}"
                                                  Margin="0,2,0,2"
                                                  CornerRadius="8,4,8,4">
                                        <StackPanel CanDrag="True"
                                                          DragStarting="StackPanel_DragStarting"
                                                          IsHitTestVisible="True"
                                                          Margin="4">
                                            <TextBlock Text="{Binding IdMissionNavigation.Title}"
                                                             FontSize="10"
                                                             FontFamily="Segoe Print"
                                                             FontWeight="SemiBold"
                                                             Foreground="{StaticResource InkBlueLightBrush}"
                                                             TextTrimming="CharacterEllipsis"
                                                             Margin="2"/>
                                            <TextBlock Text="{Binding FormattedTime}"
                                                             FontSize="8"
                                                             FontFamily="Comic Sans MS"
                                                             Foreground="{StaticResource ClueRedLightBrush}"
                                                             TextTrimming="CharacterEllipsis"
                                                             Margin="2"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Inbox с кнопкой добавления --><!--
        <Grid Grid.Column="1" Grid.RowSpan="2" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" 
                  Content="+ Добавить задачу" 
                  Margin="10" 
                  HorizontalAlignment="Stretch"
                  Click="OpenNewTaskFrame_Click"
                  Style="{StaticResource AccentButtonStyle}"/>

            <Grid Grid.Row="1">
                <TreeView x:Name="InboxTree"
                        ItemsSource="{Binding InboxTreeMissions}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedMission, Mode=TwoWay}"
                        MinWidth="260">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="mod:Mission">
                            <TreeViewItem ItemsSource="{Binding InverseIdUpMissionNavigation}" IsExpanded="True">
                                <StackPanel CanDrag="True"
                                          DragStarting="InboxMission_DragStarting"
                                          Margin="2,4">
                                    <TextBlock Text="{Binding Title}"
                                             FontFamily="Segoe Print"
                                             FontWeight="SemiBold"
                                             TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FormattedTime}"
                                             FontSize="11"
                                             Foreground="{StaticResource ClueRedLightBrush}"/>
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <Border x:Name="NewTaskFrameHost"
                      Visibility="Collapsed"
                      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                      BorderBrush="{StaticResource DividerLightBrush}"
                      BorderThickness="1,0,0,0">
                    <Grid>
                        <Frame x:Name="NewTaskFrame"/>
                        <Button Content="&#xE10A;"
                              Click="CloseNewTaskFrame_Click"
                              FontSize="24"
                              FontFamily="Segoe MDL2 Assets"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Margin="0,12,8,0"
                              Style="{StaticResource RedTextButtonStyle}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>-->
    </Grid>
</Page>
