    <Grid Background="CadetBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.6*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="BlanchedAlmond">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="папки"/>
                    <ComboBox/>

                </StackPanel>

               
                <TreeView ItemsSource="{Binding Missions}" 
          SelectionMode="Single"  SelectedItem="{Binding Task, Mode=TwoWay}">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="mod:Mission">
                            <TreeViewItem ItemsSource="{Binding InverseIdUpMissionNavigation}" >
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Padding="5">
                                        <Ellipse Width="20" Height="20" Fill="Blue" VerticalAlignment="Center" Margin="5"/>
                                        <StackPanel Margin="10,0,0,0" HorizontalAlignment="Stretch">

                                            <TextBlock Text="{Binding Title}"  FontSize="20"   FontWeight="Medium"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding EndDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:dd.MM.yyyy}'}"/>

                                                <TextBlock>
                                                    <Run Text="#"/>
                                                    <Run Text="{Binding Category.Title}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Rectangle Height="1"  Fill="Black"  Opacity="0.2"  Margin="0,8,0,0"  HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </TreeViewItem>

                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

            </StackPanel>

        </Grid>


        <Grid Grid.Column="1">
            <ScrollViewer>
                <StackPanel Margin="10">
                    <TextBlock Text="{Binding Task.Title, Mode=TwoWay}" MinWidth="300"  Height="30" FontSize="20"/>

                    <TextBlock Text="{Binding Task.Description, Mode=TwoWay}" MinWidth="300"  Height="50" TextWrapping="Wrap" FontSize="15"/>

                    <ListView Margin="0 10 0 0" Background="Transparent"
    ItemsSource="{Binding Subtasks, Mode=TwoWay}"
    MinHeight="10"
    Visibility="{Binding Task.LevelUp, Converter={StaticResource LevelVisibilityConverter}}">

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="mod:Mission">
                                <TextBlock Width="300" Height="30" Margin="0,0,0,3" Padding="3"
                Text="{Binding Title, Mode=TwoWay}" 
                FontSize="16" FontWeight="Bold" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <!--<ListBox Background="Transparent" ItemsSource="{Binding Subtasks}" MinHeight="40">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Width="300" Height="30" Margin="0 0 0 3" Padding="3"
                                                 Text="{Binding Title}"
                                                  FontSize="16" FontWeight="Bold"
                                                >


                                    </TextBlock>

                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>-->
                    <Ellipse Width="30" HorizontalAlignment="Left"
Height="30"
Fill="Blue" Margin="5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock />
                        <TextBlock Text="---" Margin="10 0 10 0 "/>
                        <TextBlock  Text="{Binding Task.EndDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:dd.MM.yyyy}'}"/>
                    </StackPanel>
                   
                    <TextBlock Height="30" Text="{Binding Task.Category}" >

                    </TextBlock>
                </StackPanel>

            </ScrollViewer>
        </Grid>


        <!--<Grid x:Name="CatBanner" Visibility="Collapsed" >
            <Grid Background="Gray" Opacity="0.6">
