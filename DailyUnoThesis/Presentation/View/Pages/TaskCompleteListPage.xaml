    <Grid Background="CadetBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.6*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="BlanchedAlmond">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="папки"/>
                    <ComboBox/>

                </StackPanel>

                <ListBox ItemsSource="{Binding Missions}" SelectedItem="{Binding Task}" Height="600">

                </ListBox>


            </StackPanel>

        </Grid>
        <Grid Grid.Column="1">
            <ScrollViewer Height="{Binding ElementName=mainPage, Path=ActualHeight, Converter={StaticResource heightOffsetConverter}}">
                <StackPanel Margin="10">
                    <TextBlock Text="{Binding Task.Title}" MinWidth="300"  Height="30" FontSize="20"/>

                    <TextBlock Text="{Binding Task.Description}" MinWidth="300"  Height="50" TextWrapping="Wrap" FontSize="15"/>
                    <ListBox Background="Transparent" ItemsSource="{Binding Subtasks}" MinHeight="40">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Width="300" Height="30" Margin="0 0 0 3" Padding="3"
                                                 Text="{Binding Title}"
                                                  FontSize="16" FontWeight="Bold"
                                                >


                                    </TextBlock>

                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>
                    <Button x:Name="AddSubTask" Content="добавить подзадачу +" Command="{Binding CreateSubtask}">
                       
                    </Button>
                    <Ellipse Width="30" HorizontalAlignment="Left"
Height="30"
Fill="Blue" Margin="5"/>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker IsEnabled="False"/>
                        <TextBlock Text="---" Margin="10 0 10 0 "/>
                        <DatePicker IsEnabled="False" SelectedDate="{Binding Task.EndDate}"/>
                    </StackPanel>
                   
                    <TextBlock Height="30" Text="{Binding Task.Category}" >

                    </TextBlock>
                </StackPanel>

            </ScrollViewer>
        </Grid>


        <!--<Grid x:Name="CatBanner" Visibility="Collapsed" >
