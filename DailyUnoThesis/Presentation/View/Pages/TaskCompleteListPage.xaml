<Page x:Class="DailyUnoThesis.Presentation.View.Pages.TaskCompleteListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="using:DailyUnoThesis.Presentation.View.Pages"
      xmlns:mod="using:DailyUnoThesis.Models.MainClasses"
xmlns:con="clr-namespace:DailyUnoThesis.Models.Conventers"
   xmlns:control="clr-namespace:DailyUnoThesis.Presentation.ViewModel.PagesControls" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:uen="using:Uno.Extensions.Navigation.UI"
xmlns:utu="using:Uno.Toolkit.UI"
xmlns:um="using:Uno.Material"
NavigationCacheMode="Required"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800">
    <Page.Resources>
        <con:LevelToMarginConverter x:Key="LevelToMarginConverter" />
        <con:StringFormatConverter x:Key="StringFormatConverter" />
        <con:LevelVisibilityConverter x:Key="LevelVisibilityConverter"/>
        <con:DateTimeToOffsetConverter x:Key="DateTimeToOffsetConverter"/>
        <con:LevelTextBoxVisibilityConverter x:Key="LevelTextBoxVisibilityConverter"/>
        <con:LevelComboBoxVisibilityConverter x:Key="LevelComboBoxVisibilityConverter"/>
    </Page.Resources>
    <Page.DataContext>
        <control:TaskCompleteControle/>
    </Page.DataContext>
