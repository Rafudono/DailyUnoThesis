<Page
    x:Class="DailyUnoThesis.Presentation.View.Pages.Projects.PanelProjects"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DailyUnoThesis.Presentation.View.Pages.Projects"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"


           xmlns:mv="using:DailyUnoThesis.Presentation.ViewModel.NavigationClasses"
    xmlns:mod="using:DailyUnoThesis.Models.MainClasses"
    xmlns:con="using:DailyUnoThesis.Models.Conventers"
      xmlns:model="using:DailyUnoThesis.Models"
             xmlns:helperstyle="using:DailyUnoThesis.Styles.Dictionary"
    xmlns:control="using:DailyUnoThesis.Presentation.ViewModel.NavigationClasses"
      xmlns:help="using:DailyUnoThesis.Presentation.ViewModel.HelperClasses"
       xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
       xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
xmlns:core="using:Microsoft.Xaml.Interactions.Core"
 xmlns:utu="using:Uno.Toolkit.UI"
 xmlns:um="using:Uno.Material"
 NavigationCacheMode="Enabled"
    mc:Ignorable="d"
    
        xmlns:winui="using:Microsoft.UI.Xaml.Controls"
    xmlns:lottie="using:CommunityToolkit.WinUI.Lottie"
    
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!--<mv:TaskPageControle x:Key="Control"/>-->
        <con:ScrollHeightConventer x:Key="heightOffsetConverter" />
        <con:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter"/>
        <con:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <con:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <con:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <con:BoolToAngleConverter x:Key="BoolToAngleConverter"/>
        <con:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <con:LevelTextBoxVisibilityConverter x:Key="LevelTextBoxVisibilityConverter"/>



    </Page.Resources>

    <Grid>

        <Grid x:Name="maingrid" Background="BlueViolet" uen:Region.Attached="True" >

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AdaptiveStates">

                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1300" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RootSplitView.DisplayMode" Value="Inline" />
                            <Setter Target="RootSplitView.IsPaneOpen" Value="True" />
                            <Setter Target="RootSplitView.OpenPaneLength" Value="300" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="AverageState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="800" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RootSplitView.DisplayMode" Value="Inline" />
                            <Setter Target="RootSplitView.OpenPaneLength" Value="230" />
                            <Setter Target="RootSplitView.IsPaneOpen" Value="True" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="100" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>

                            <!--<Setter Target="RootSplitView.IsPaneOpen" Value="False" />-->
                            <Setter Target="RootSplitView.OpenPaneLength" Value="300" />
                            <Setter Target="RootSplitView.DisplayMode" Value="Overlay" />
                            <Setter Target="HamburgerBtn.Visibility" Value="Visible" />

                            <Setter Target="ArchiveHeader.Padding" Value="0,45,20,0" />

                            
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>


                <VisualStateGroup x:Name="MenuOpenStates">
                    <VisualState x:Name="MenuOpen">
                        <VisualState.StateTriggers>
                            <StateTrigger IsActive="{Binding IsMenuOpen}" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RootSplitView.IsPaneOpen" Value="True" />
                            <Setter Target="RootSplitView.OpenPaneLength" Value="300" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="MenuClose">
                        <VisualState.StateTriggers>
                            <StateTrigger IsActive="{Binding IsMenuOpen, Converter={StaticResource InverseBoolConverter}}" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RootSplitView.IsPaneOpen" Value="False" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="MenuClosed" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>


            <!--<Grid Canvas.ZIndex="100">
            
        </Grid>-->

            <SplitView x:Name="RootSplitView" OpenPaneLength="300"  DisplayMode="Inline"  IsPaneOpen="{Binding IsMenuOpen, Mode=TwoWay}" Margin="0 0 0 0"
                   CompactPaneLength="0" CornerRadius="0,8,8,0" >
                <SplitView.Pane MaxWidth="300">
                    <Border  BorderThickness="0,0,1,0" BorderBrush="{StaticResource DarkGrayBrown}" Padding="0 0 1 0">
                        <Border x:Name="MenuBorder" MaxWidth="300"  Background="#e9e9e9" BorderThickness="0,0,2,0" BorderBrush="{StaticResource DarkGrayBrown}" uen:Region.Attached="True">
                            <Border.Transitions>
                                <TransitionCollection>
                                    <!-- Это заставит список задач плавно менять размер, когда панель его толкает -->
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </Border.Transitions>
                            <Grid>
                                <!-- Декоративный элемент: имитация текстуры бумаги или вертикальная полоса-склейка -->
                                <Rectangle Width="4" 
HorizontalAlignment="Right" 
Fill="{StaticResource DarkGrayBrown}" 
Opacity="0.1" 
Margin="0,0,1,0"/>
                                <Rectangle Width="4" 
HorizontalAlignment="Left" 
Fill="{StaticResource DarkGrayBrown}" 
Opacity="0.1" 
Margin="0,0,1,0"/>

                                <ScrollViewer  Padding="0 15" IsTabStop="True"  HorizontalScrollBarVisibility="Auto" 
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollMode="Enabled" 
              VerticalScrollMode="Enabled">

                                    <Border BorderThickness="0,0,2,0" BorderBrush="#2D3135">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <!-- Шапка: Гриф секретности -->
                                                <RowDefinition Height="*"/>
                                                <!-- Картотека (Список) -->
                                                <RowDefinition Height="Auto"/>
                                                <!-- Кнопка: Инициализировать дело -->
                                            </Grid.RowDefinitions>

                                            <!-- 1. ШАПКА: Гриф важности (Военно-архивный стиль) -->
                                            <StackPanel Grid.Row="0" Padding="0,5,20,0" Spacing="8" x:Name="ArchiveHeader">

                                                <!-- Тонкая перфорированная линия-разделитель -->
                                                <Border Height="1.5" Background="{StaticResource DarkGrayBrown}" Margin="0,0,0,0"/>

                                                <StackPanel Grid.Row="0" Padding="10,0,10,20" Spacing="0">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Button Content="{Binding VisibilityArchivalBar, Converter={StaticResource BoolToAngleConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                Style="{StaticResource TextsButtonStyle}" Tag="{StaticResource AccentBlueLightBrush}"
                                                                Foreground="{StaticResource InkBlueLightBrush}" Command="{Binding OpeningArchivalBar}"/> <!--&#xE70D;-->
                                                        <TextBlock Text="АРХИВ ПРОЕКТОВ" FontSize="14" FontFamily="Comic Sans MS" FontWeight="Bold" Opacity="0.8" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                      
                                                    </StackPanel>
                                                    <StackPanel x:Name="ArchivalBar">
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="ListMissionsOpened">
                                                                <VisualState x:Name="ListClosed">
                                                                    <VisualState.StateTriggers>
                                                                        <StateTrigger IsActive="{Binding VisibilityArchivalBar, Converter={StaticResource InverseBoolConverter}}" />
                                                                    </VisualState.StateTriggers>
                                                                    <VisualState.Setters>
                                                                        <Setter Target="ArchivalBar.Height" Value="0"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>

                                                        <TextBlock Text="Статусы:" FontSize="10" Margin="25 -10 20 20"/>
                                                    <ComboBox FontSize="13" Height="40" Margin="25 -13 20 20" HorizontalAlignment="Left" MinWidth="180"
            DisplayMemberPath="Title" Style="{StaticResource DetectiveComboBoxStyle}" Tag="&#xEADF;" BorderThickness="1" CornerRadius="9" Foreground="#3D2B1F" FontWeight="Bold"
            SelectedItem="{Binding SelectedArchivalProgressStates, Mode=TwoWay}"
            ItemsSource="{Binding ArchivalProgressStates, Mode=TwoWay}" SelectionChanged="{x:Bind ViewModel.SelectArchivalProgressStates}" />
                                                    <Grid >
                                                      
                                                        <ScrollViewer  MaxHeight="400" Height="Auto" Margin="0 -10 0 5">

                               

                                                        <StackPanel   VerticalAlignment="Top" Margin="0 0 0 5">

                                                          


                                                            <TreeView x:Name="ArchivalProjectList" ItemsSource="{Binding ArchivalProjects}" MinHeight="60" MaxHeight="400"
          SelectionMode="Single"  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">

                                                            <TreeView.Resources>
                                                                <!--1. МЕНЯЕМ СИМВОЛЫ СТРЕЛОК (Шляпки) 
         Код символа ">"-->
                                                                <x:String x:Key="TreeViewItemCollapsedGlyph">&#xE106;</x:String>
                                                                <x:String x:Key="TreeViewItemExpandedGlyph">&#xE76C;</x:String>

                                                                <x:String x:Key="TreeViewItemCollapsedChevronGlyph">&#xE106;</x:String>
                                                                <x:String x:Key="TreeViewItemExpandedChevronGlyph">&#xE76C;</x:String>

                                                                <!--2. НАСТРАИВАЕМ РАЗМЕР И ЦВЕТ СТРЕЛОК-->
                                                                <x:Double x:Key="TreeViewItemChevronFontSize">20</x:Double>
                                                                <StaticResource x:Key="TreeViewItemForegroundExpander" ResourceKey="InkBlueBrush" />

                                                                <!--3. ИСПРАВЛЯЕМ ВЫДЕЛЕНИЕ (чтобы не было тормозов и фиолетового)-->
                                                                <!--Цвет фона при наведении-->
                                                                <!--<SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#F0F0F0" Opacity="0.5"/>-->
                                                                <!--Цвет фона при выделении-->
                                                                <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{ThemeResource SystemControlBackgroundListLowBrush}" Opacity="0.8"/>
                                                                <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemControlBackgroundListLowBrush}" Opacity="1"/>

                                                                <SolidColorBrush x:Key="TreeViewItemForegroundExpander" Color="Black" />
                                                                <!--Или ваш InkBlueBrush-->

                                                                <!--Убираем системные отступы, которые могут мешать нитям-->
                                                                <Thickness x:Key="TreeViewItemCompactPadding">0,0,0,0</Thickness>
                                                            </TreeView.Resources>

                                                            <TreeView.ItemContainerStyle>
                                                                <Style TargetType="TreeViewItem">
                                                                    <!--Убираем стандартные отступы, которые могут мешать схлопыванию-->
                                                                    <Setter Property="MinHeight" Value="0"/>
                                                                    <!--<Setter Property="IsExpanded" Value="True" />-->
                                                                    <Setter Property="Transitions">
                                                                        <Setter.Value>
                                                                            <TransitionCollection>
                                                                                <!--Эта штука заставляет соседей плавно ехать на свободное место-->
                                                                                <AddDeleteThemeTransition />
                                                                            </TransitionCollection>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                    <Setter Property="Padding" Value="0" />
                                                                    <!--Убираем лишние падинги-->

                                                                </Style>
                                                            </TreeView.ItemContainerStyle>




                                                            <TreeView.ItemTemplate>
                                                                <DataTemplate x:DataType="mod:Category">
                                                                    <TreeViewItem ItemsSource="{Binding InverseIdUpCategoryNavigation}" x:Name="TreeViewItem">

                                                                        <Grid Background="Transparent"  Width="Auto" MinWidth="30" MaxWidth="700" x:Name="RootGrid"  Height="65" PointerEntered="Grid_PointerEntered" PointerExited="Grid_PointerExited" Tag="{Binding IsPointerOver}">

                                                                            <VisualStateManager.VisualStateGroups>
                                                                                <VisualStateGroup x:Name="CommonStates">
                                                                                    <!-- Обычное состояние -->
                                                                                    <VisualState x:Name="Normal"/>
                                                                                    <VisualState x:Name="IsSelected">
                                                                                        <VisualState.StateTriggers>
                                                                                            <StateTrigger IsActive="{Binding IsSelected, ElementName=TreeViewItem}" />
                                                                                        </VisualState.StateTriggers>
                                                                                        <VisualState.Setters>
                                                                                            <!-- Текст становится красным -->
                                                                                            <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ClueRedLightBrush}"/>
                                                                                            <!-- Показываем красную черту -->
                                                                                            <Setter Target="Underline.BorderThickness" Value="0 0 0 2"/>
                                                                                            <!--<Setter Target="CheckedBackground.Opacity" Value="0.5"/>-->
                                                                                            <!--<Setter Target="CuttingBorder.Opacity" Value="1"/>
                     <Setter Target="CuttingBorder.Margin" Value="3 3 0 0"/>-->
                                                                                            <Setter Target="Underline.Opacity" Value="1"/>
                                                                                            <Setter Target="RootGrid.Height" Value="63"/>
                                                                                            <Setter Target="ChevronPath.Opacity" Value="1"/>
                                                                                            <Setter Target="ChevronPath.Visibility" Value="Visible"/>

                                                                                            <!--<Setter Target="HoverBackground.Opacity" Value="0.8"/>-->
                                                                                        </VisualState.Setters>
                                                                                    </VisualState>
                                                                                    <!--PointerOverAndSelected-->
                                                                                    <VisualState x:Name="PointerOver">
                                                                                        <VisualState.StateTriggers>
                                                                                            <StateTrigger IsActive="{Binding Tag, ElementName=RootGrid}" />
                                                                                        </VisualState.StateTriggers>
                                                                                        <VisualState.Setters>
                                                                                            <!-- Цвет текста становится темнее при наведении -->
                                                                                            <!--<Setter Target="ContentPresenter.Foreground" Value="#051a35"/>-->
                                                                                            <Setter Target="Underline.BorderThickness" Value="0 0 0 2"/>
                                                                                            <Setter Target="Underline.Opacity" Value="1"/>
                                                                                            <!--<Setter Target="HoverBackground.Opacity" Value="0.5"/>-->
                                                                                            <!--<Setter Target="CuttingBorder.Opacity" Value="1"/>
<Setter Target="CuttingBorder.Margin" Value="3 3 0 0"/>-->
                                                                                            <Setter Target="RootGrid.Height" Value="63"/>
                                                                                        </VisualState.Setters>
                                                                                    </VisualState>
                                                                                </VisualStateGroup>
                                                                            </VisualStateManager.VisualStateGroups>

                                                                            <Grid.ContextFlyout>
                                                                                <MenuFlyout>
                                                                                    <MenuFlyoutItem Text="Редактировать" Background="#ecf1ff" FontFamily="Segoe Print"
Command="{Binding PanelProject.OpenPanelEditCategory,Source={StaticResource GlobalStore}}" 
CommandParameter="{Binding}">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <SymbolIcon Symbol="Edit" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>


                                                                                    <MenuFlyoutItem Text="Создать подкатегорию проекта" Background="#ecf1ff" FontFamily="Segoe Print"
                                                                        Command="{Binding PanelProject.CreateSubcategory,Source={StaticResource GlobalStore}}"
                                                                        CommandParameter="{Binding}">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <SymbolIcon Symbol="List" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>



                                                                                    <MenuFlyoutSeparator />


                                                                                    <MenuFlyoutItem Text="Удалить проект" Foreground="Red" Background="#ecf1ff" FontFamily="Segoe Print"
                                                                        Command="{Binding PanelProject.DeleteCategoryCascade, Source={StaticResource GlobalStore}}"
                                                                        CommandParameter="{Binding}"
                                                                        Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <SymbolIcon Symbol="Delete" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>


                                                                                    <!--<MenuFlyoutSubItem Text="Удалить"  Foreground="Red" Background="#ecf1ff" FontFamily="Segoe Print"
                                                                           Visibility="{Binding HasAnyContent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <MenuFlyoutSubItem.Icon>
                                                                                    <SymbolIcon Symbol="Delete" />
                                                                                </MenuFlyoutSubItem.Icon>
                                                                                <MenuFlyoutItem Text="Удалить только категорию" Background="#ecf1ff" FontFamily="Segoe Print"
                                                                            Command="{Binding PanelProject.DeleteCategoryMoveToParent, Source={StaticResource GlobalStore}}"
                                                                            CommandParameter="{Binding}"/>

                                                                                <MenuFlyoutItem Text="Удалить всё" Background="#ecf1ff" FontFamily="Segoe Print"
                                                                            Command="{Binding PanelProject.DeleteCategoryCascade, Source={StaticResource GlobalStore}}"
                                                                            CommandParameter="{Binding}" IsEnabled="{Binding HasAllContent, Mode=OneWay}"/>

                                                                                <MenuFlyoutSubItem Text="Удалить c вложеннотями" Background="#ecf1ff" FontFamily="Segoe Print"  Foreground="Red" >

                                                                                    <MenuFlyoutItem Text="Удалить только категории" Background="#ecf1ff" FontFamily="Segoe Print"
                                                                                Command="{Binding PanelProject.DeleteCategoryOrphanTasks, Source={StaticResource GlobalStore}}"
                                                                                CommandParameter="{Binding}"
                                                                                IsEnabled="{Binding HasSubCategories, Mode=OneWay}" />

                                                                                    <MenuFlyoutItem Text="Удалить с задачами" Background="#ecf1ff" FontFamily="Segoe Print"
                                                                                Command="{Binding PanelProject.DeleteCategoryWithMissions, Source={StaticResource GlobalStore}}"
                                                                                CommandParameter="{Binding}"
                                                                                IsEnabled="{Binding HasMissions, Mode=OneWay}"/>
                                                                                </MenuFlyoutSubItem>

                                                                            </MenuFlyoutSubItem>-->


                                                                                </MenuFlyout>
                                                                            </Grid.ContextFlyout>


                                                                            <Grid IsHitTestVisible="False" Margin="0,3,25,2" HorizontalAlignment="Left" Background="Transparent">

                                                                                <StackPanel >
                                                                                    <StackPanel Orientation="Horizontal" >
                                                                                                    <TextBlock x:Name="ContentPresenter" Margin="0 -5 0 0"  Text="{Binding Title}" Foreground="#3D2B1F" FontFamily="Segoe Print"  FontSize="20"  HorizontalAlignment="Left"  VerticalAlignment="Top" FontWeight="Thin"/>
                                                                                    </StackPanel>
                                                                                                <TextBlock FontSize="11" FontFamily="Comic Sans MS" Foreground="#3D2B1F">
                                                                                <Run Text="СТАТУС:"/>
                                                                                <Run Text="{Binding Progressstates.Title}"/>
                                                                                    </TextBlock>
                                                                                        <Grid Width="205" Height="15" HorizontalAlignment="Left">
                                                                                        <Rectangle Height="5" HorizontalAlignment="Left" Background="Transparent" Fill="Transparent" Stroke="Black" Stretch="Fill" Opacity="0.3" Margin="0,0" Width="200" StrokeThickness="1" />
                                                                                        <Grid HorizontalAlignment="Left" Width="200">
                                                                                            <muxc:ProgressBar HorizontalAlignment="Left" Foreground="{StaticResource InkBlueLightBrush}" Background="Transparent" Value="{Binding Progress}" Minimum="0" Maximum="120" Style="{StaticResource MaterialProgressBarStyle}" Width="200" Height="10" Margin="0 -1 0 0">
                                                                                                <ProgressBar.Resources>
                                                                                                    <!-- Задаем высоту внутренней полосы (например, 8 пикселей) -->
                                                                                                    <x:Double x:Key="ProgressBarTrackHeight">15</x:Double>
                                                                                                </ProgressBar.Resources>
                                                                                            </muxc:ProgressBar>
                                                                                        </Grid>
                                                                                    </Grid>
                                                                                </StackPanel>


                                                                                <Border x:Name="Underline" Opacity="0" Margin="-25 -20 -25 0"  BorderThickness="0 0 0 2" BorderBrush="{StaticResource ClueRedLightBrush}" VerticalAlignment="Bottom" Background="Transparent" />
                                                                            </Grid>
                                                                            <Grid Background="Transparent" IsHitTestVisible="False" Margin="-25 -2 0 0" Height="20" Width="20" HorizontalAlignment="Left" Visibility="{Binding InverseIdUpCategoryNavigation.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                                                                <!--<TextBlock FontSize="15" Text="&#xE76C;" Margin="0 0 0 0" Background="Transparent" Height="30" Width="30" VerticalAlignment="Bottom" IsHitTestVisible="False"/>-->
                                                                                <Grid Background="{StaticResource TransparentGridBrushCat}" Width="20" Height="15"/>
                                                                                <FontIcon Glyph="{Binding IsExpanded, ElementName=TreeViewItem, Converter={StaticResource BoolToAngleConverter}}" HorizontalAlignment="Center" Width="10" Height="10" RenderTransformOrigin="0.5,0.5">
                                                                                </FontIcon>
                                                                            </Grid>
                                                                            <Path IsHitTestVisible="False" Data="M 0,0 L 10,10 L 0,20 Z"  Fill="{StaticResource ClueRedLightBrush}" HorizontalAlignment="Left"  Stretch="Uniform" x:Name="ChevronPath"  Width="10" Height="17"  Margin="-35 2 0 0" Opacity="0"  Visibility="Visible"/>

                                                                            <!--<CheckBox x:Name="ToggleBut" IsHitTestVisible="False" Visibility="Collapsed" IsChecked="True" />-->

                                                                            <ToolTipService.ToolTip>
                                                                                <ToolTip Content="{Binding Title}"/>
                                                                            </ToolTipService.ToolTip>
                                                                        </Grid>
                                                                    </TreeViewItem>

                                                                </DataTemplate>
                                                            </TreeView.ItemTemplate>
                                                        </TreeView>
                                                        
                                                    </StackPanel>
                                                    </ScrollViewer>
                                                    </Grid>
                                                    </StackPanel>
                                                    <Border Height="1.5" Background="{StaticResource DarkGrayBrown}" Margin="-10,0,0,0" HorizontalAlignment="Stretch"/>
                                                    <Border Height="1.5" Background="{StaticResource DarkGrayBrown}" Margin="-10,5,0,0" HorizontalAlignment="Stretch"/>

                                                </StackPanel>
                                            </StackPanel>


                                            
                                            <StackPanel Spacing="10" Grid.Row="1">
                                              

                                            
                                                <StackPanel Orientation="Horizontal" Margin="10 0 0 0">
                                                    <TextBlock  Margin="0 10 0 0"  FontSize="16">
                                            <Run Text="#" FontFamily="Comic Sans MS"  FontSize="18" />
                                            <Run Text="ПРОЕКТЫ" FontFamily="Comic Sans MS" FontWeight="Bold"/>
                                                    </TextBlock>
                                                    <Button Command="{Binding CloseAndOpenAddCategoryPanel}" HorizontalAlignment="Right" helperstyle:ButtonHelper.IconGlyph="&#xE8F4;"
                                            Margin="5 0 0 -6" FontSize="18" FontWeight="Black" Padding="0"  Style="{StaticResource TextsButtonStyle}"  
          Tag="{StaticResource AccentBlueLightBrush}" Foreground="Black"/>
                                                </StackPanel>
                                                <TextBlock Text="АКТИВНЫХ ОБЪЕКТОВ: " FontSize="13" FontFamily="Comic Sans MS" Opacity="0.8" Margin="10 0 0 0">
                                                    <Run Text="{Binding Categories.Count}"/>
                                                </TextBlock>
                                                <Border Height="1" Background="{StaticResource DarkGrayBrown}" Margin="10,3,10,0" HorizontalAlignment="Stretch"/>


                                                <TreeView x:Name="CategoriesRepeater" ItemsSource="{Binding Categories}" 
          SelectionMode="Single"  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">

                                                    <TreeView.Resources>
                                                        <!--1. МЕНЯЕМ СИМВОЛЫ СТРЕЛОК (Шляпки) 
         Код символа ">"-->
                                                        <x:String x:Key="TreeViewItemCollapsedGlyph">&#xE106;</x:String>
                                                        <x:String x:Key="TreeViewItemExpandedGlyph">&#xE76C;</x:String>

                                                        <x:String x:Key="TreeViewItemCollapsedChevronGlyph">&#xE106;</x:String>
                                                        <x:String x:Key="TreeViewItemExpandedChevronGlyph">&#xE76C;</x:String>

                                                        <!--2. НАСТРАИВАЕМ РАЗМЕР И ЦВЕТ СТРЕЛОК-->
                                                        <x:Double x:Key="TreeViewItemChevronFontSize">20</x:Double>
                                                        <StaticResource x:Key="TreeViewItemForegroundExpander" ResourceKey="InkBlueBrush" />

                                                        <!--3. ИСПРАВЛЯЕМ ВЫДЕЛЕНИЕ (чтобы не было тормозов и фиолетового)-->
                                                        <!--Цвет фона при наведении-->
                                                        <!--<SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#F0F0F0" Opacity="0.5"/>-->
                                                        <!--Цвет фона при выделении-->
                                                        <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{ThemeResource SystemControlBackgroundListLowBrush}" Opacity="0.8"/>
                                                        <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemControlBackgroundListLowBrush}" Opacity="1"/>

                                                        <SolidColorBrush x:Key="TreeViewItemForegroundExpander" Color="Black" />
                                                        <!--Или ваш InkBlueBrush-->

                                                        <!--Убираем системные отступы, которые могут мешать нитям-->
                                                        <Thickness x:Key="TreeViewItemCompactPadding">0,0,0,0</Thickness>
                                                    </TreeView.Resources>

                                                    <TreeView.ItemContainerStyle>
                                                        <Style TargetType="TreeViewItem">
                                                            <!--Убираем стандартные отступы, которые могут мешать схлопыванию-->
                                                            <Setter Property="MinHeight" Value="0"/>
                                                            <!--<Setter Property="IsExpanded" Value="True" />-->
                                                            <Setter Property="Transitions">
                                                                <Setter.Value>
                                                                    <TransitionCollection>
                                                                        <!--Эта штука заставляет соседей плавно ехать на свободное место-->
                                                                        <AddDeleteThemeTransition />
                                                                    </TransitionCollection>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
