<Page x:Class="DailyUnoThesis.Presentation.View.Pages.TaskPages"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DailyUnoThesis.Presentation.View.Pages"
    xmlns:mod="using:DailyUnoThesis.Models.MainClasses"
    xmlns:con="using:DailyUnoThesis.Models.Conventers"
    xmlns:control="using:DailyUnoThesis.Presentation.ViewModel.NavigationClasses">

    <Page.Resources>
        <con:ScrollHeightConventer x:Key="heightOffsetConverter" />
    </Page.Resources>

    <Grid Background="PaleVioletRed">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.6*" />
            <ColumnDefinition Width="1.8*" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid Background="BlueViolet">
            <ScrollViewer>
                <StackPanel Margin="10">
                    <Button Height="30" Margin="0,5,0,0" Content="Все задания" Command="{Binding OpenAllList}" />
                    <Button Height="30" Margin="0,5,0,0" Content="На сегодня" Command="{Binding OpenTodayList}" />
                    <Button Height="30" Margin="0,5,0,0" Content="Выполненные" Command="{Binding OpenCompleteList}" />
                    <Button Height="30" Margin="0,5,0,0" Content="Просроченные" Command="{Binding OpenOverdueList}" />
                    <Button Height="40" Margin="0,5,0,0">
                        <TextBlock TextAlignment="Center">
                            Фильтры и метки<LineBreak/>(а как работает?)
                        </TextBlock>
                    </Button>

                    <Line X1="0" Y1="0" X2="100" Y2="0" Stroke="Black" StrokeThickness="1" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="#Категории" />
                        <Button Content="+" Margin="10,0,0,0" Click="OpenCatBanner" />
                    </StackPanel>

                    <ListView ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              MinHeight="30">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="mod:Category">
                                <Grid>
                                    <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" />
                                    <Button Command="{Binding OpenCategoryList, Source={StaticResource Control}}"
                                            Background="Transparent"
                                            MinWidth="168" MinHeight="20" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Line X1="0" Y1="0" X2="100" Y2="0" Stroke="Black" StrokeThickness="1" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="#Проекты" />
                        <Button Content="+" Margin="10,0,0,0" />
                    </StackPanel>

                    <Button Height="30" Margin="0,5,0,0" Content="Все задания" />
                    <Button Height="30" Margin="0,5,0,0" Content="Все задания" />
                    <Button Height="30" Margin="0,5,0,0" Content="Все задания" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Frame Background="AliceBlue"
               Grid.Column="1"
               Grid.ColumnSpan="2"
               Visibility="Collapsed"
               Content="{Binding CurPageCategory}" />

        <Grid x:Name="CatBanner" Visibility="{Binding IsCatBannerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Background="Gray" Opacity="0.6" Tapped="CloseCatBanner" />
            <Border CornerRadius="20" Height="200" Width="500" Background="PaleVioletRed">
                <Grid>
                    <TextBox PlaceholderText="Название категории"
                             Text="{Binding CategoryTitle}"
                             Width="400" Height="40" FontSize="25" />
                    <Button Content="Сохранить"
                            Margin="20"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Height="30" Width="100"
                            Command="{Binding CreateCat}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
