            <Grid Background="Gray" Opacity="0.6"  Tapped="{x:Bind ViewModel.CloseCategoryPanel}"/>
            <!--Tapped="{Binding CloseAndOpenAddCategoryPanel}"-->
            <Border CornerRadius="20" Height="200" Width="500" Background="PaleVioletRed">
                <Grid>
                    <TextBox PlaceholderText="Название категории"
                             Text="{Binding Category.Title, Mode=TwoWay}"
                             Width="400" Height="40" FontSize="20" />
                    <Button Content="Сохранить"
                            Margin="20"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Height="30" Width="150"
                            Command="{Binding CreateCat}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
