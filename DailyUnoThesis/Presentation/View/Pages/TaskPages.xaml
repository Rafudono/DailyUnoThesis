<Page x:Class="DailyUnoThesis.Presentation.View.Pages.TaskPages"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DailyUnoThesis.Presentation.View.Pages"
       xmlns:mv="using:DailyUnoThesis.Presentation.ViewModel.NavigationClasses"
    xmlns:mod="using:DailyUnoThesis.Models.MainClasses"
    xmlns:con="using:DailyUnoThesis.Models.Conventers"
      xmlns:model="using:DailyUnoThesis.Models"
             xmlns:helperstyle="using:DailyUnoThesis.Styles.Dictionary"
    xmlns:control="using:DailyUnoThesis.Presentation.ViewModel.NavigationClasses"
      xmlns:help="using:DailyUnoThesis.Presentation.ViewModel.HelperClasses"
       xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
       xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
xmlns:core="using:Microsoft.Xaml.Interactions.Core"
 xmlns:utu="using:Uno.Toolkit.UI"
 xmlns:um="using:Uno.Material"
      x:Name="PanelTask"
 NavigationCacheMode="Enabled">

    <!--<Page.DataContext>
        <mv:TaskPageControle/>
    </Page.DataContext>-->
    <Page.Resources>
        <!--<mv:TaskPageControle x:Key="Control"/>-->
        <con:ScrollHeightConventer x:Key="heightOffsetConverter" />
        <con:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter"/>
        <con:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <con:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <con:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <con:BoolToAngleConverter x:Key="BoolToAngleConverter"/>
        <con:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>


        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Red" />
        
        <!-- Цвет фона выбранного элемента -->
        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Red" />
        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="Red" />

        <!-- Описание того, как выглядит каждый тип элемента -->
        <DataTemplate x:Key="NavHeaderTemplate" x:DataType="model:NavMenuItem">
            <NavigationViewItemHeader Content="{Binding Label}" Margin="0,20,0,0" />
        </DataTemplate>

        <DataTemplate x:Key="NavSeparatorTemplate">
            <NavigationViewItemSeparator />
        </DataTemplate>

        <DataTemplate x:Key="NavItemTemplate" x:DataType="model:NavMenuItem">
            <!-- 
         Магия Uno 5: 
         uen:Region.Name указывает КУДА идти.
         uen:Region.Data указывает ЧТО передать (объект Category).
     -->
            <NavigationViewItem Content="{Binding Label}" 
                         Icon="{Binding Icon}" 
                         uen:Region.Name="{Binding Route}"
                         uen:Navigation.Data="{Binding Data}" />
        </DataTemplate>

        <model:TaskMenuSelector x:Key="TaskMenuSelector"
     ItemTemplate="{StaticResource NavItemTemplate}"
     HeaderTemplate="{StaticResource NavHeaderTemplate}"
     SeparatorTemplate="{StaticResource NavSeparatorTemplate}" />

      
    </Page.Resources>

    <Grid x:Name="maingrid" Background="BlueViolet" uen:Region.Attached="True" >

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveStates">

                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1300" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootSplitView.DisplayMode" Value="Inline" />
                        <Setter Target="RootSplitView.IsPaneOpen" Value="True" />
                        <Setter Target="RootSplitView.OpenPaneLength" Value="300" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="AverageState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootSplitView.DisplayMode" Value="Inline" />
                        <Setter Target="RootSplitView.OpenPaneLength" Value="230" />
                        <Setter Target="RootSplitView.IsPaneOpen" Value="True" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>

                        <!--<Setter Target="RootSplitView.IsPaneOpen" Value="False" />-->
                        <Setter Target="RootSplitView.OpenPaneLength" Value="300" />
                        <Setter Target="RootSplitView.DisplayMode" Value="Overlay" />
                        <Setter Target="HamburgerBtn.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>


            <VisualStateGroup x:Name="MenuOpenStates">
                <VisualState x:Name="MenuOpen">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding IsMenuOpen}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootSplitView.IsPaneOpen" Value="True" />
                        <Setter Target="RootSplitView.OpenPaneLength" Value="300" />
                    </VisualState.Setters>
                </VisualState>
                
                <VisualState x:Name="MenuClose">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{Binding IsMenuOpen, Converter={StaticResource InverseBoolConverter}}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootSplitView.IsPaneOpen" Value="False" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MenuClosed" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        
        <!--<Grid Canvas.ZIndex="100">
            
        </Grid>-->

        <SplitView x:Name="RootSplitView" OpenPaneLength="300"  DisplayMode="Inline"  IsPaneOpen="{Binding IsMenuOpen, Mode=TwoWay}" Margin="0 0 0 0"
                   CompactPaneLength="0" CornerRadius="0,8,8,0" >
            <SplitView.Pane MaxWidth="300">
                <Border  BorderThickness="0,0,1,0" BorderBrush="{StaticResource DarkGrayBrown}" Padding="0 0 1 0">
                <Border x:Name="MenuBorder" MaxWidth="300"  Background="#e9e9e9" BorderThickness="0,0,2,0" BorderBrush="{StaticResource DarkGrayBrown}" uen:Region.Attached="True">
                        <Border.Transitions>
                            <TransitionCollection>
                                <!-- Это заставит список задач плавно менять размер, когда панель его толкает -->
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </Border.Transitions>
                        <Grid>
                        <!-- Декоративный элемент: имитация текстуры бумаги или вертикальная полоса-склейка -->
                        <Rectangle Width="4" 
HorizontalAlignment="Right" 
Fill="{StaticResource DarkGrayBrown}" 
Opacity="0.1" 
Margin="0,0,1,0"/>
                            <Rectangle Width="4" 
HorizontalAlignment="Left" 
Fill="{StaticResource DarkGrayBrown}" 
Opacity="0.1" 
Margin="0,0,1,0"/>

                            <ScrollViewer  Padding="0 5" IsTabStop="True"  HorizontalScrollBarVisibility="Auto" 
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollMode="Enabled" 
              VerticalScrollMode="Enabled">

                            <StackPanel Spacing="10">
                                    <StackPanel Height="40">
                                        
                                    </StackPanel>

                                    <utu:TabBar x:Name="StaticTabBar" SelectedIndex="{Binding NamderMainPanel, Mode=TwoWay}" HorizontalAlignment="Left" SelectionChanged="{x:Bind ViewModel.SelectedAndVisible}" Width="220" Margin="10 0 0 0"
                                        uen:Region.Attached="True" Orientation="Vertical" Background="Transparent" MinHeight="150" ItemContainerStyle="{StaticResource DetectiveTabBarItemStyle}">

                                        <utu:TabBarItem Content="Все задания"  uen:Region.Name="TaskList" utu:TabBarItemExtensions.OnClickBehaviorsTarget="{Binding ElementName=TaskContentGrid}"  Tag="Bookmarks" />
                                        <utu:TabBarItem Content="На сегодня"  uen:Region.Name="Today"  utu:TabBarItemExtensions.OnClickBehaviorsTarget="{Binding ElementName=TaskContentGrid}"     Tag="Clock" />
                                        <utu:TabBarItem Content="Выполненные"  uen:Region.Name="Complete" utu:TabBarItemExtensions.OnClickBehaviorsTarget="{Binding ElementName=TaskContentGrid}"  Tag="Accept"/>
                                        <utu:TabBarItem Content="Просроченные"  uen:Region.Name="Overdue" utu:TabBarItemExtensions.OnClickBehaviorsTarget="{Binding ElementName=TaskContentGrid}"  Tag="SelectAll"/>
                                </utu:TabBar>

                                    <StackPanel Orientation="Horizontal" Margin="10 0 0 0"> 
                                        <TextBlock  Margin="0 10 0 0"  FontSize="19">
                                            <Run Text="#" FontFamily="Comic Sans MS"  FontSize="22" />
                                            <Run Text="Категории" FontFamily="Comic Sans MS" FontWeight="Bold"/>
                                        </TextBlock>
                                        <Button Command="{Binding CloseAndOpenAddCategoryPanel}" HorizontalAlignment="Right" helperstyle:ButtonHelper.IconGlyph="&#xE8F4;"
                                            Margin="5 0 0 -6" FontSize="18" FontWeight="Black" Padding="0"  Style="{StaticResource TextsButtonStyle}"  
          Tag="{StaticResource AccentBlueLightBrush}" Foreground="Black"/>
                                </StackPanel>


                                    <TreeView x:Name="CategoriesRepeater" ItemsSource="{Binding Categories}"  
          SelectionMode="Single"  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">

                                        <TreeView.Resources>
                                            <!--1. МЕНЯЕМ СИМВОЛЫ СТРЕЛОК (Шляпки) 
         Код символа ">"-->
                                            <x:String x:Key="TreeViewItemCollapsedGlyph">&#xE106;</x:String>
                                            <x:String x:Key="TreeViewItemExpandedGlyph">&#xE76C;</x:String>

                                            <x:String x:Key="TreeViewItemCollapsedChevronGlyph">&#xE106;</x:String>
                                            <x:String x:Key="TreeViewItemExpandedChevronGlyph">&#xE76C;</x:String>

                                            <!--2. НАСТРАИВАЕМ РАЗМЕР И ЦВЕТ СТРЕЛОК-->
                                            <x:Double x:Key="TreeViewItemChevronFontSize">20</x:Double>
                                            <StaticResource x:Key="TreeViewItemForegroundExpander" ResourceKey="InkBlueBrush" />

                                            <!--3. ИСПРАВЛЯЕМ ВЫДЕЛЕНИЕ (чтобы не было тормозов и фиолетового)-->
                                            <!--Цвет фона при наведении-->
                                            <!--<SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#F0F0F0" Opacity="0.5"/>-->
                                            <!--Цвет фона при выделении-->
                                            <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{ThemeResource SystemControlBackgroundListLowBrush}" Opacity="0.8"/>
                                            <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemControlBackgroundListLowBrush}" Opacity="1"/>

                                            <SolidColorBrush x:Key="TreeViewItemForegroundExpander" Color="Black" />
                                            <!--Или ваш InkBlueBrush-->

                                            <!--Убираем системные отступы, которые могут мешать нитям-->
                                            <Thickness x:Key="TreeViewItemCompactPadding">0,0,0,0</Thickness>
                                        </TreeView.Resources>

                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem">
                                                <!--Убираем стандартные отступы, которые могут мешать схлопыванию-->
                                                <Setter Property="MinHeight" Value="0"/>
                                                <Setter Property="IsExpanded" Value="True" />
                                                <Setter Property="Transitions">
                                                    <Setter.Value>
                                                        <TransitionCollection>
                                                            <!--Эта штука заставляет соседей плавно ехать на свободное место-->
                                                            <AddDeleteThemeTransition />
                                                        </TransitionCollection>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <!--Убираем лишние падинги-->

                                            </Style>
                                        </TreeView.ItemContainerStyle>




                                        <TreeView.ItemTemplate>
                                            <DataTemplate x:DataType="mod:Category">
                                                <TreeViewItem ItemsSource="{Binding InverseIdUpCategoryNavigation}" x:Name="TreeViewItem">

                                                    <Grid Background="Transparent"  Width="Auto" MinWidth="30" MaxWidth="700" x:Name="RootGrid"  Height="30" PointerEntered="Grid_PointerEntered" PointerExited="Grid_PointerExited" Tag="{Binding IsPointerOver}">

                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <!-- Обычное состояние -->
                                                                <VisualState x:Name="Normal"/>
                                                                <VisualState x:Name="IsSelected">
                                                                    <VisualState.StateTriggers>
                                                                        <StateTrigger IsActive="{Binding IsSelected, ElementName=TreeViewItem}" />
                                                                    </VisualState.StateTriggers>
                                                                    <VisualState.Setters>
                                                                        <!-- Текст становится красным -->
                                                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource ClueRedLightBrush}"/>
                                                                        <!-- Показываем красную черту -->
                                                                        <Setter Target="Underline.BorderThickness" Value="0 0 0 2"/>
                                                                        <!--<Setter Target="CheckedBackground.Opacity" Value="0.5"/>-->
                                                                        <!--<Setter Target="CuttingBorder.Opacity" Value="1"/>
                     <Setter Target="CuttingBorder.Margin" Value="3 3 0 0"/>-->
                                                                        <Setter Target="Underline.Opacity" Value="1"/>
                                                                        <Setter Target="RootGrid.Height" Value="35"/>
                                                                        <Setter Target="ChevronPath.Opacity" Value="1"/>
                                                                        <Setter Target="ChevronPath.Visibility" Value="Visible"/>

                                                                        <!--<Setter Target="HoverBackground.Opacity" Value="0.8"/>-->
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <!--PointerOverAndSelected-->
                                                                <VisualState x:Name="PointerOver">
                                                                    <VisualState.StateTriggers>
                                                                        <StateTrigger IsActive="{Binding Tag, ElementName=RootGrid}" />
                                                                    </VisualState.StateTriggers>
                                                                    <VisualState.Setters>
                                                                        <!-- Цвет текста становится темнее при наведении -->
                                                                        <!--<Setter Target="ContentPresenter.Foreground" Value="#051a35"/>-->
                                                                        <Setter Target="Underline.BorderThickness" Value="0 0 0 2"/>
                                                                        <Setter Target="Underline.Opacity" Value="1"/>
                                                                        <!--<Setter Target="HoverBackground.Opacity" Value="0.5"/>-->
                                                                        <!--<Setter Target="CuttingBorder.Opacity" Value="1"/>
<Setter Target="CuttingBorder.Margin" Value="3 3 0 0"/>-->
                                                                        <Setter Target="RootGrid.Height" Value="35"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>

                                                        <Grid.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Редактировать" Background="#ecf1ff" FontFamily="Segoe Print"
                                Command="{Binding PanelTask.OpenPanelEditCategory,Source={StaticResource GlobalStore}}" 
                                CommandParameter="{Binding}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <SymbolIcon Symbol="Edit" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>


                                                                <MenuFlyoutItem Text="Создать подкатегорию" Background="#ecf1ff" FontFamily="Segoe Print"
                                                                        Command="{Binding PanelTask.CreateSubcategory,Source={StaticResource GlobalStore}}"
                                                                        CommandParameter="{Binding}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <SymbolIcon Symbol="List" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                СlearСategory

                                                                <MenuFlyoutItem Text="Очистить содержимое" Background="#ecf1ff" FontFamily="Segoe Print"
                                                                        Command="{Binding  PanelTask.СlearСategory, Source={StaticResource GlobalStore}}"
                                                                        CommandParameter="{Binding}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <SymbolIcon Symbol="List" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>

                                                                <MenuFlyoutSeparator />


                                                                <MenuFlyoutItem Text="Удалить категорию" Foreground="Red" Background="#ecf1ff" FontFamily="Segoe Print"
                                                                        Command="{Binding PanelTask.DeleteCategoryEmptyOnly, Source={StaticResource GlobalStore}}"
                                                                        CommandParameter="{Binding}"
                                                                        Visibility="{Binding IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <SymbolIcon Symbol="List" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>


                                                                <MenuFlyoutSubItem Text="Удалить"  Foreground="Red" Background="#ecf1ff" FontFamily="Segoe Print"
                                                                           Visibility="{Binding HasAnyContent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <MenuFlyoutSubItem.Icon>
                                                                        <SymbolIcon Symbol="Delete" />
                                                                    </MenuFlyoutSubItem.Icon>
                                                                    <MenuFlyoutItem Text="Удалить только категорию" Background="#ecf1ff" FontFamily="Segoe Print"
                                                                            Command="{Binding PanelTask.DeleteCategoryMoveToParent, Source={StaticResource GlobalStore}}"
                                                                            CommandParameter="{Binding}"/>

                                                                    <MenuFlyoutItem Text="Удалить всё" Background="#ecf1ff" FontFamily="Segoe Print"
                                                                            Command="{Binding PanelTask.DeleteCategoryCascade, Source={StaticResource GlobalStore}}"
                                                                            CommandParameter="{Binding}" IsEnabled="{Binding HasAllContent, Mode=OneWay}"/>

                                                                    <MenuFlyoutSubItem Text="Удалить c вложеннотями" Background="#ecf1ff" FontFamily="Segoe Print"  Foreground="Red" >

                                                                        <MenuFlyoutItem Text="Удалить только категории" Background="#ecf1ff" FontFamily="Segoe Print"
                                                                                Command="{Binding PanelTask.DeleteCategoryOrphanTasks, Source={StaticResource GlobalStore}}"
                                                                                CommandParameter="{Binding}"
                                                                                IsEnabled="{Binding HasSubCategories, Mode=OneWay}" />

                                                                        <MenuFlyoutItem Text="Удалить с задачами" Background="#ecf1ff" FontFamily="Segoe Print"
                                                                                Command="{Binding PanelTask.DeleteCategoryWithMissions, Source={StaticResource GlobalStore}}"
                                                                                CommandParameter="{Binding}"
                                                                                IsEnabled="{Binding HasMissions, Mode=OneWay}"/>
                                                                    </MenuFlyoutSubItem>

                                                                </MenuFlyoutSubItem>


                                                            </MenuFlyout>
                                                        </Grid.ContextFlyout>


                                                        <Grid IsHitTestVisible="False" Margin="0,3,25,2" HorizontalAlignment="Left" Background="Transparent">
                                                            <StackPanel Orientation="Horizontal" >
                                                                <SymbolIcon Symbol="SolidStar" x:Name="Icon" Foreground="{Binding Foreground, ElementName=ContentPresenter}" Margin="-2 -2 7 0"/>
                                                                <TextBlock x:Name="ContentPresenter" Margin="0 -5 0 0"  Text="{Binding Title}" Foreground="#3D2B1F" FontFamily="Segoe Print"  FontSize="20"  HorizontalAlignment="Left"  VerticalAlignment="Top" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                            <Border x:Name="Underline" Opacity="0" Margin="0 -20 0 0"  BorderThickness="0 0 0 2" BorderBrush="{StaticResource ClueRedLightBrush}" VerticalAlignment="Bottom" Background="Transparent" />
                                                        </Grid>
                                                        <Grid Background="Transparent" IsHitTestVisible="False" Margin="-25 -2 0 0" Height="20" Width="20" HorizontalAlignment="Left" Visibility="{Binding InverseIdUpCategoryNavigation.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                                            <!--<TextBlock FontSize="15" Text="&#xE76C;" Margin="0 0 0 0" Background="Transparent" Height="30" Width="30" VerticalAlignment="Bottom" IsHitTestVisible="False"/>-->
                                                            <Grid Background="{StaticResource TransparentGridBrushCat}" Width="20" Height="15"/>
                                                            <FontIcon Glyph="{Binding IsExpanded, ElementName=TreeViewItem, Converter={StaticResource BoolToAngleConverter}}" HorizontalAlignment="Center" Width="10" Height="10" RenderTransformOrigin="0.5,0.5">
                                                            </FontIcon>
                                                        </Grid>
                                                        <Path IsHitTestVisible="False" Data="M 0,0 L 10,10 L 0,20 Z"  Fill="{StaticResource ClueRedLightBrush}" HorizontalAlignment="Left"  Stretch="Uniform" x:Name="ChevronPath"  Width="10" Height="17"  Margin="-35 2 0 0" Opacity="0"  Visibility="Collapsed"/>

                                                        <!--<CheckBox x:Name="ToggleBut" IsHitTestVisible="False" Visibility="Collapsed" IsChecked="True" />-->
                                                    </Grid>
                                                </TreeViewItem>

                                            </DataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>


                                    <!--<TextBlock Text="#Проекты" Margin="0,10" />-->

                                <!--Width="200"-->

                               

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
                </Border>
            </SplitView.Pane>
            <SplitView.Content>
                <Grid Background="AliceBlue" uen:Region.Attached="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0.1" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0*" x:Name="MenuTask" MinWidth="0" MaxWidth="220"></ColumnDefinition>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="PaneColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="PaneStates">

                            <!--СОСТОЯНИЕ: ПАНЕЛЬ ЗАКРЫТА-->
                            <VisualState x:Name="Closed">
                                <VisualState.StateTriggers>
                                    <StateTrigger IsActive="{Binding IsSplitViewPaneOpen, Converter={StaticResource InverseBoolConverter}}" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="PaneColumn.Width" Value="0" />
                                    <Setter Target="PaneColumn.MinWidth" Value="0" />
                                    <!--<Setter Target="DetailsPane.Visibility" Value="Collapsed" />-->
                                </VisualState.Setters>
                            </VisualState>

                            <!--СОСТОЯНИЕ: ПАНЕЛЬ ОТКРЫТА-->
                            <VisualState x:Name="Open">
                                <VisualState.StateTriggers>
                                    <StateTrigger IsActive="{Binding IsSplitViewPaneOpen}" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="PaneColumn.Width" Value="0.5*" />
                                    <Setter Target="PaneColumn.MinWidth" Value="350" />
                                    <Setter Target="PaneColumn.MaxWidth" Value="850" />
                                    <!--<Setter Target="DetailsPane.Visibility" Value="Visible" />-->
                                </VisualState.Setters>
                            </VisualState>


                        </VisualStateGroup>

                        <VisualStateGroup x:Name="MenuOpenStates2">
                            <VisualState x:Name="MenuOpen2">
                                <VisualState.StateTriggers>
                                    <StateTrigger IsActive="{Binding IsMenuOpen}" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="MenuBorder.Visibility" Value="Visible" />
                                    <Setter Target="LightDismissLayer.Visibility" Value="Visible" />
                                    <Setter Target="MenuBorder.Grid.ColumnSpan" Value="2" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="MenuClosed2" />
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Grid Padding="1 0 1 0"  x:Name="TaskContentGrid"
                       Grid.Column="1" Grid.Row="1"
uen:Region.Attached="True"  Visibility="{Binding IsVisibilityTabBar, Converter={StaticResource BoolToVisibilityConverter}}"
uen:Region.Navigator="Visibility" />


                    <Frame  Visibility="{Binding IsVisibilityFrame, Converter={StaticResource BoolToVisibilityConverter}}"  x:Name="ContentFrame" Grid.Column="1" Grid.Row="1" />



                    <Button  Content="Добавить запись" Command="{Binding CreatNewTask}" HorizontalAlignment="Right"  VerticalAlignment="Top"
                             Margin="10" Background="{StaticResource DividerLightBrush}" CornerRadius="0" Padding="3" helperstyle:ButtonHelper.IconGlyph="&#xE710;"
                             Visibility="{Binding IsSplitViewPaneOpen, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                             Style="{StaticResource StampWithIconButtonStyle}" FontSize="15" Tag="{StaticResource AccentBlueLightBrush}"
                             Foreground="{StaticResource InkBlueLightBrush}"  Grid.Column="1" Grid.Row="1"/>

                    <Grid Grid.Column="2" Grid.Row="1" x:Name="DetailsPane" >


                        <Frame x:Name="ContentFrameTask"/>
                        <Button Command="{Binding CloseAndOpenDetailedSplitView}" Content="&#xE10A;" FontSize="30" FontWeight="ExtraBlack" Foreground="{StaticResource ClueRedLightBrush}"
                                VerticalAlignment="Top" HorizontalAlignment="Right" Margin=" 0 15 0 0"  Style="{StaticResource RedTextButtonStyle}"/>
                    </Grid>


             

                </Grid>
            </SplitView.Content>
        </SplitView>





      
            <!--<Frame Background="AliceBlue"
       Grid.Column="1"
       Grid.ColumnSpan="2"
       Visibility="Collapsed"
       Content="{Binding CurPageCategory}" />-->
          


        <!--<Grid Background="BlueViolet">
            <ScrollViewer>
                <StackPanel Margin="10">
                    <Button Height="30" Margin="0,5,0,0" Content="Все задания" Command="{Binding OpenAllList}" />
                    <Button Height="30" Margin="0,5,0,0" Content="На сегодня" Command="{Binding OpenTodayList}" />
                    <Button Height="30" Margin="0,5,0,0" Content="Выполненные" Command="{Binding OpenCompleteList}" />
                    <Button Height="30" Margin="0,5,0,0" Content="Просроченные" Command="{Binding OpenOverdueList}" />
                    <Button Height="40" Margin="0,5,0,0">
                        <TextBlock TextAlignment="Center">
                            Фильтры и метки<LineBreak/>(а как работает?)
                        </TextBlock>
                    </Button>

                    <Line X1="0" Y1="0" X2="100" Y2="0" Stroke="Black" StrokeThickness="1" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="#Категории" />
                        <Button Content="+" Margin="10,0,0,0" Click="OpenCatBanner" />
                    </StackPanel>

                    <ListView ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              MinHeight="30">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="mod:Category">
                                <Grid>
                                    <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" />
                                    <Button Command="{Binding OpenCategoryList, Source={StaticResource Control}}"
                                            Background="Transparent"
                                            MinWidth="168" MinHeight="20" />
                                </Grid>
                            </DataTemplate>
