                                                     CommandParameter="{Binding ElementName=CalendarView}"
                                                                         Tag="M12,20A7,7 0 0,1 5,13A7,7 0 0,1 12,6A7,7 0 0,1 19,13A7,7 0 0,1 12,20M12,4A9,9 0 0,0 3,13A9,9 0 0,0 12,22A9,9 0 0,0 21,13A9,9 0 0,0 12,4M12.5,8H11V14L15.7,16.8L16.5,15.6L12.5,13.2V8M8,1V3H16V1H8Z">

                                                            </RadioButton>

                                                            <RadioButton Content="Завтра"  GroupName="DateGroup" Style="{StaticResource DateRadioButtonStyle}"
