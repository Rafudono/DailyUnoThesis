<Page
    x:Class="DailyUnoThesis.Presentation.View.Pages.SelectedAndNewTask"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DailyUnoThesis.Presentation.View.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:mv="using:DailyUnoThesis.Presentation.ViewModel.PagesControls"
    xmlns:mod="using:DailyUnoThesis.Models.MainClasses"
    xmlns:con="using:DailyUnoThesis.Models.Conventers"
    xmlns:model="using:DailyUnoThesis.Models"
    xmlns:control="using:DailyUnoThesis.Presentation.ViewModel.NavigationClasses"
    xmlns:uen="using:Uno.Extensions.Navigation.UI"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:utu="using:Uno.Toolkit.UI"
    xmlns:um="using:Uno.Material"
    xmlns:ut="using:Uno.Themes"
    NavigationCacheMode="Enabled"
     x:Name="DetailPage"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.DataContext>
        <mv:TaskViewModel/>
    </Page.DataContext>
    <Page.Resources>
        <con:LevelToMarginConverter x:Key="LevelToMarginConverter" />
        <con:StringFormatConverter x:Key="StringFormatConverter" />
        <con:LevelVisibilityConverter x:Key="LevelVisibilityConverter"/>
        <con:DateTimeToOffsetConverter x:Key="DateTimeToOffsetConverter"/>
        <con:LevelTextBoxVisibilityConverter x:Key="LevelTextBoxVisibilityConverter"/>
        <con:LevelComboBoxVisibilityConverter x:Key="LevelComboBoxVisibilityConverter"/>


        <Style TargetType="Grid" x:Key="OldPaper">
            <Setter Property="Background">
                <Setter.Value>
                    <RadialGradientBrush 
        Center="0.5,0.6" 
        RadiusX="1" RadiusY="0.9" 
        GradientOrigin="0.5,0.6">

                        <!-- Первый цвет: занимает 60% площади (Offset 0.6) -->
                        <GradientStop Color="#f2eff5" Offset="0.02" />

                        <!-- Второй цвет: плавный переход -->
                        <GradientStop Color="White" Offset="0.88" />

                        <!-- Третий цвет: темная кайма на самом краю -->
                        <GradientStop Color="#dfbba9" Offset="1.0" />
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Border   BorderThickness="1,0,0,0" CornerRadius="8 0 0 8" BorderBrush="#311a11">
            <Grid  Background="#ecf1ff">
                <!--<Grid.Style>
    <Style TargetType="Grid">
        <Setter Property="Background">
            <Setter.Value>
                <RadialGradientBrush Center="0.5,0.1" RadiusX="1" RadiusY="0.9" GradientOrigin="0.5,0.1">
                    -->
                <!-- Первый цвет: занимает 60% площади (Offset 0.6) -->
                <!--
                    <GradientStop Color="#f2eff5" Offset="0.02" />
                    -->
                <!-- Второй цвет: плавный переход -->
                <!--
                    <GradientStop Color="#f2eff5" Offset="0.88" />
                    -->
                <!-- Третий цвет: темная кайма на самом краю -->
                <!--
                    <GradientStop Color="#dfbba9" Offset="1.0" />
                </RadialGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
</Grid.Style>-->
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <!--<Button Click="CloseFilters_Click" Content="Cancel"/>-->
                        <Button Content="новый"
            HorizontalAlignment="Right"
            Command="{Binding NewTask}" />
                        

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.1*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <CheckBox CommandParameter="{Binding Task}"
Command="{Binding DataContext.CompleteTaskCommand, ElementName=DetailPage}"
IsChecked="{Binding Task.IsComplete, Mode=TwoWay}" />
                       
                        <TextBox Text="{Binding Task.Title, Mode=TwoWay}"
             MinWidth="150" Grid.Column="1"
             Header="Введите название"
             MinHeight="30" FontSize="18" TextWrapping="Wrap"/>
                        </Grid>

                        <TextBox Text="{Binding Task.Description, Mode=TwoWay}"
             MinWidth="150"
             Header="Введите описание"
             MinHeight="50" TextWrapping="Wrap" FontSize="15" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto"/>


                        <Ellipse Width="30" Height="30" Fill="Blue" Margin="5" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal">
                            <CalendarDatePicker Height="40" Width="Auto" DateFormat="{}{day.integer}.{month.integer}.{year.full}" Date="{Binding Task.StartDate,  Mode=TwoWay, Converter={StaticResource DateTimeToOffsetConverter} }"
    Padding="0" VerticalContentAlignment="Center"  Header="Выберите конечную дату"/>
                            <TextBlock Text="---" Margin="10,0,10,0" />
                            <CalendarDatePicker Height="40" Width="Auto" DateFormat="{}{day.integer}.{month.integer}.{year.full}" Date="{Binding Task.EndDate,  Mode=TwoWay, Converter={StaticResource DateTimeToOffsetConverter} }"
                            Padding="0" VerticalContentAlignment="Center"  Header="Выберите конечную дату"/>
                        </StackPanel>
                        <TextBlock Text="список папок" />

                        <Grid>
                            <TextBlock Text="{Binding SelectedCategory.Title}"
                   FontSize="20"
                   Visibility="{Binding Task.LevelUp, Converter={StaticResource LevelTextBoxVisibilityConverter}, ConverterParameter={Binding SelectedCategory.Id}}" />

                            <ComboBox FontSize="20" Height="30"
                  DisplayMemberPath="Title"
                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                  ItemsSource="{Binding Categories, Mode=TwoWay}"
                  Visibility="{Binding Task.LevelUp, Converter={StaticResource LevelComboBoxVisibilityConverter}}" />
                        </Grid>

                        <ListView Margin="0 10 0 0" Background="Transparent"
             ItemsSource="{Binding Subtasks, Mode=TwoWay}"
             MinHeight="10"
             Visibility="{Binding Task.LevelUp, Converter={StaticResource LevelVisibilityConverter}}">

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="mod:Mission">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.15*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox CommandParameter="{Binding}"
          Command="{Binding DataContext.CompleteTaskCommand, ElementName=DetailPage}"
          IsChecked="{Binding IsComplete, Mode=TwoWay}" />
                                        <TextBox MinWidth="150" Grid.Column="1" MinHeight="30"  Width="Auto" Margin="0,0,0,3" Padding="3"
                         Text="{Binding Title, Mode=TwoWay}"
                         PlaceholderText="Новая подзадача"
                         FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <Button Grid.Column="2" Content="D"
                                                Visibility="{Binding Id, Converter={StaticResource LevelVisibilityConverter}}"
                                                CommandParameter="{Binding}"
                                                Command="{Binding DataContext.DeleteTask, ElementName=DetailPage}"
                                                Style="{StaticResource TextButtonStyle}">
                                            <ut:ControlExtensions.Icon>
                                                <PathIcon  Data="M3,3H18V18H3V3M19,19H21V21H19V19M19,16H21V18H19V16M19,13H21V15H19V13M19,10H21V12H19V10M19,7H21V9H19V7M16,19H18V21H16V19M13,19H15V21H13V19M10,19H12V21H10V19M7,19H9V21H7V19Z"/>
                                            </ut:ControlExtensions.Icon>

                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Content="добавить подзадачу +"
            Command="{Binding CreateSubtask}"
            Visibility="{Binding Task.LevelUp, Converter={StaticResource LevelVisibilityConverter}}" />
                        


                        <Button Height="30" Content="Сохранить" Command="{Binding CreateAndEditTask}" />
                    </StackPanel>
                </ScrollViewer>
                <Button VerticalAlignment="Bottom" HorizontalAlignment="Right" Content="D"
        Visibility="{Binding Task.Id, Converter={StaticResource LevelVisibilityConverter}}"
        CommandParameter="{Binding Task}"
        Command="{Binding DataContext.DeleteTask, ElementName=DetailPage}"
        Style="{StaticResource TextButtonStyle}">
                    <ut:ControlExtensions.Icon>
                        <PathIcon  Data="M3,3H18V18H3V3M19,19H21V21H19V19M19,16H21V18H19V16M19,13H21V15H19V13M19,10H21V12H19V10M19,7H21V9H19V7M16,19H18V21H16V19M13,19H15V21H13V19M10,19H12V21H10V19M7,19H9V21H7V19Z"/>
                    </ut:ControlExtensions.Icon>

                </Button>
            </Grid>
        </Border>

    </Grid>
</Page>
