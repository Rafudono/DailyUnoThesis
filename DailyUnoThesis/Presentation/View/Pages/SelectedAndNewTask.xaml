                                                CommandParameter="{Binding}" Content="&#xE74D;" FontSize="18"
                                                Command="{Binding DataContext.DeleteTask, ElementName=DetailPage}"
                                                Style="{StaticResource RedTextSmallButtonStyle}">
                                                            <!--<ut:ControlExtensions.Icon>
                                                                <SymbolIcon Symbol="Delete"/>
                                                            </ut:ControlExtensions.Icon>-->

                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    <Button Content="добавить подзадачу" Style="{StaticResource TextsIconButtonStyle}" Foreground="{StaticResource InkBlueLightBrush}" Margin="-5 -10  0 0" Tag="{StaticResource AccentBlueLightBrush}"
            Command="{Binding CreateSubtask}"
            Visibility="{Binding Task.LevelUp, Converter={StaticResource LevelVisibilityConverter}}" />



                                       

                                        <!-- Место для подзадач, дат и т.д. -->
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
