                                <!--Цвет фона при наведении-->
                                <!--<SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#F0F0F0" Opacity="0.5"/>-->
                                <!--Цвет фона при выделении-->
                                <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{ThemeResource SystemControlBackgroundListLowBrush}" />
                                <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemControlBackgroundListMediumBrush}" />

                                <SolidColorBrush x:Key="TreeViewItemForegroundExpander" Color="Black" />
                                <!--Или ваш InkBlueBrush-->

                                <!--Убираем системные отступы, которые могут мешать нитям-->
                                <Thickness x:Key="TreeViewItemCompactPadding">0,0,0,0</Thickness>
                            </TreeView.Resources>

