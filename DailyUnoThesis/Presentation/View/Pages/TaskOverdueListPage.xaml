                                                        <DoubleAnimation Storyboard.TargetName="TreeViewItem"  Storyboard.TargetProperty="Height"  To="0" Duration="0:0:0.6" EnableDependentAnimation="True">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="GridRootBorder"  Storyboard.TargetProperty="Height"  To="0" Duration="0:0:0.6" EnableDependentAnimation="True">
