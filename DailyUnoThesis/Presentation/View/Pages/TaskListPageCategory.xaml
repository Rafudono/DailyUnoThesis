<Page x:Class="DailyUnoThesis.Presentation.View.Pages.TaskListPageCategory"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DailyUnoThesis.Presentation.View.Pages"
    xmlns:mod="using:DailyUnoThesis.Models.MainClasses"
    xmlns:con="using:DailyUnoThesis.Models.Conventers"
    xmlns:control="using:DailyUnoThesis.Presentation.ViewModel.PagesControls"
    xmlns:uen="using:Uno.Extensions.Navigation.UI"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:utu="using:Uno.Toolkit.UI"
    xmlns:um="using:Uno.Material"
    NavigationCacheMode="Enabled">
    <Page.DataContext>
        <control:TaskCategotyControle/>
    </Page.DataContext>
    <Page.Resources>
        <!--<con:LevelMarginConverter x:Key="LevelMarginConverter" />
        <con:LevelVisibilityConverter x:Key="LevelVisibilityConverter" />
        <con:DateToStringConverter x:Key="DateToStringConverter" />-->

        <DataTemplate x:Key="MissionTemplate" x:DataType="mod:Mission">
            <Grid Margin="{Binding LevelUp, Converter={StaticResource LevelMarginConverter}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="20" Height="20" Fill="Blue" Margin="5" />
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="20" Margin="10,3,0,3" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding EndDate, Converter={StaticResource DateToStringConverter}}" />
                            <TextBlock>
                                <Run Text="#"/>
                                <Run Text="{Binding Category.Title}" />
                            </TextBlock>
                        </StackPanel>
                        <Line StrokeThickness="1" Stroke="Black" X1="0" X2="250" Y1="0" Y2="0" HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="CadetBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="0.6*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="BlanchedAlmond">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="папки" />
                    <ComboBox />
                </StackPanel>
                <!--<ListBox ItemsSource="{Binding Missions}"
                         SelectedItem="{Binding Task}"
                         Height="600"
                         ItemTemplate="{StaticResource MissionTemplate}" />-->

                <TreeView ItemsSource="{Binding Missions}" 
          SelectionMode="Single"  SelectedItem="{Binding Task, Mode=TwoWay}">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="mod:Mission">
                            <TreeViewItem ItemsSource="{Binding InverseIdUpMissionNavigation}" >
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Padding="5">
                                        <Ellipse Width="20" Height="20" Fill="Blue" VerticalAlignment="Center" Margin="5"/>
                                        <StackPanel Margin="10,0,0,0" HorizontalAlignment="Stretch">

                                            <TextBlock Text="{Binding Title}"  FontSize="20"   FontWeight="Medium"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding EndDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:dd.MM.yyyy}'}"/>

                                                <TextBlock>
                                                    <Run Text="#"/>
                                                    <Run Text="{Binding Category.Title}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Rectangle Height="1"  Fill="Black"  Opacity="0.2"  Margin="0,8,0,0"  HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </TreeViewItem>

                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <ScrollViewer>
                <StackPanel Margin="10">
                    <Button Content="новый"
                            HorizontalAlignment="Right"
                            Command="{Binding NewTask}" />

                    <TextBox Text="{Binding Task.Title}"
                             MinWidth="300"
                             PlaceholderText="Введите название"
                             Height="30" FontSize="20" />

                    <TextBox Text="{Binding Task.Description}"
                             MinWidth="300"
                             PlaceholderText="Введите описание"
                             Height="50" TextWrapping="Wrap" FontSize="15" />

                    <ListBox Background="Transparent"
                             ItemsSource="{Binding Subtasks}"
                             MinHeight="40"
                             Visibility="{Binding Task.LevelUp, Converter={StaticResource LevelVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="mod:Mission">
                                <TextBox Width="300" Height="30" Margin="0,0,0,3" Padding="3"
                                         Text="{Binding Title}"
                                         PlaceholderText="Новая подзадача"
                                         FontSize="16" FontWeight="Bold" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Content="добавить подзадачу +"
                            Command="{Binding CreateSubtask}"
                            Visibility="{Binding Task.LevelUp, Converter={StaticResource LevelVisibilityConverter}}" />

                    <Ellipse Width="30" Height="30" Fill="Blue" Margin="5" HorizontalAlignment="Left" />

                    <StackPanel Orientation="Horizontal">
                        <DatePicker IsEnabled="False" />
                        <TextBlock Text="---" Margin="10,0,10,0" />
                        <DatePicker SelectedDate="{Binding Task.EndDate}" />
                    </StackPanel>

                    <TextBlock Text="список папок" />
                    <ComboBox Height="30"
                              DisplayMemberPath="Title"
                              SelectedItem="{Binding SelectedCategory}"
                              ItemsSource="{Binding Categories}" />

                    <Button Height="30" Content="Сохранить" Command="{Binding CreateAndEditTask}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--<Grid x:Name="CatBanner" Visibility="{Binding IsCatBannerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Background="Gray" Opacity="0.6" />
            <Border CornerRadius="20" Height="200" Width="500" Background="PaleVioletRed">
                <Grid>
                    <TextBox PlaceholderText="Название категории"
                             Width="400" Height="40" FontSize="25" />
                    <Button Content="Сохранить"
                            Margin="20"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Height="30" Width="100" />
                </Grid>
            </Border>
        </Grid>-->
    </Grid>
</Page>
