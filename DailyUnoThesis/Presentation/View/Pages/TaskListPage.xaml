<Page x:Class="DailyUnoThesis.Presentation.View.Pages.TaskListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DailyUnoThesis.Presentation.View.Pages"
    xmlns:mod="using:DailyUnoThesis.Models.MainClasses"
    xmlns:con="using:DailyUnoThesis.Models.Conventers"
    xmlns:control="using:DailyUnoThesis.Presentation.ViewModel.PagesControls"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uen="using:Uno.Extensions.Navigation.UI"
xmlns:utu="using:Uno.Toolkit.UI"
xmlns:um="using:Uno.Material"
NavigationCacheMode="Required"
          xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
xmlns:core="using:Microsoft.Xaml.Interactions.Core"
       mc:Ignorable="d"
      x:Name="MyPageRoot"
 Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <!--DataContext="{StaticResource Control}"-->
    <Page.Resources>
        <con:LevelToMarginConverter x:Key="LevelToMarginConverter" />
        <con:StringFormatConverter x:Key="StringFormatConverter" />
        <con:LevelVisibilityConverter x:Key="LevelVisibilityConverter"/>
        <con:DateTimeToOffsetConverter x:Key="DateTimeToOffsetConverter"/>
        <con:LevelTextBoxVisibilityConverter x:Key="LevelTextBoxVisibilityConverter"/>
        <con:LevelComboBoxVisibilityConverter x:Key="LevelComboBoxVisibilityConverter"/>
        <con:NullToVisibilityConverterTextBoxCategory x:Key="ConverterTextBoxVisibility"/>


        <Style TargetType="Grid" x:Key="OldPaper">
            <Setter Property="Background">
                <Setter.Value>
                    <RadialGradientBrush 
            Center="0.5,0.6" 
            RadiusX="1" RadiusY="0.9" 
            GradientOrigin="0.5,0.6">

                        <!-- Первый цвет: занимает 60% площади (Offset 0.6) -->
                        <GradientStop Color="#f2eff5" Offset="0.02" />

                        <!-- Второй цвет: плавный переход -->
                        <GradientStop Color="White" Offset="0.88" />

                        <!-- Третий цвет: темная кайма на самом краю -->
                        <GradientStop Color="#dfbba9" Offset="1.0" />
                    </RadialGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <!--<Page.Resources>
        <control:TaskListControle x:Key="Control"/>
        <con:ScrollHeightConventer x:Key="heightOffsetConverter"/>
    </Page.Resources>-->
    <!--<Page.DataContext>
        <control:TaskListControle/>
 </Page.DataContext>-->

    <Grid Background="#fafaf9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#f5f8ff">
            <ScrollViewer  Padding="10 5" VerticalAlignment="Top" IsTabStop="True">
                <StackPanel Margin="10">
                    <StackPanel Orientation="Horizontal" Height="150">
                        <TextBlock Text="папки" />
                        <ComboBox Width="Auto"
                              DisplayMemberPath="Title"
                              SelectedItem="{Binding SelectedFilterCategory}"
                              ItemsSource="{Binding Categories}" />
                    </StackPanel>
                    <TextBox PlaceholderText="Найти по названию" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                    <!--<ListView ItemsSource="{Binding Missions}" SelectedItem="{Binding Task}"
Height="600">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2">
                                -->
                    <!-- item itself -->
                    <!--
                                <TextBlock Text="{Binding Title}" />

                                -->
                    <!-- parent DataContext.SomeText -->
                    <!--
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>-->



                    <TreeView  ItemsSource="{Binding Missions, Mode=TwoWay}" 
          SelectionMode="Single"  SelectedItem="{Binding Task, Mode=TwoWay}" HorizontalAlignment="Left">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <!-- Убираем стандартные отступы, которые могут мешать схлопыванию -->
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="IsExpanded" Value="True" />
                                <Setter Property="Transitions">
                                    <Setter.Value>
                                        <TransitionCollection>
                                            <!-- Эта штука заставляет соседей плавно ехать на свободное место -->
                                            <AddDeleteThemeTransition />
                                        </TransitionCollection>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="mod:Mission">
                                <TreeViewItem ItemsSource="{Binding InverseIdUpMissionNavigation, Mode=TwoWay}">
                                    <Border x:Name="RootBorder" MinWidth="500" MaxWidth="800" CornerRadius="15"
                                            BorderBrush="Black" BorderThickness="0.8" Margin="3"  RenderTransformOrigin="0.5,0.5" VerticalAlignment="Top" MinHeight="0">

                                        <Border.RenderTransform>
                                            <CompositeTransform />
                                        </Border.RenderTransform>

                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="LifeCycleStates">
                                                <VisualState x:Name="Alive" />
                                                

                                                <VisualState x:Name="Removing">
                                                    <VisualState.StateTriggers>
                                                        <StateTrigger IsActive="{Binding IsRemoving}" />
                                                    </VisualState.StateTriggers>
                                                    <Storyboard>
                                                        <!-- 1. Плавно исчезаем -->
                                                        <DoubleAnimation Storyboard.TargetName="RootBorder" 
                                                         Storyboard.TargetProperty="Opacity" 
                                                         To="0" Duration="0:0:0.4"/>
                                                        <!-- 2. Сдвигаем влево (эффект вылета) -->
                                                        <DoubleAnimation Storyboard.TargetName="RootBorder" 
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)" 
                                                         To="-100" Duration="0:0:0.4">
                                                            <DoubleAnimation.EasingFunction>
                                                                <ExponentialEase Exponent="5" EasingMode="EaseIn"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <!-- 3. Схлопываем по высоте (чтобы нижние задачи поехали вверх) -->
                                                        <!--<DoubleAnimation Storyboard.TargetName="RootBorder" 
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" 
                                         To="0" Duration="0:0:0.4"/>-->
                                                        <DoubleAnimation Storyboard.TargetName="RootBorder" 
                                                             Storyboard.TargetProperty="Height" 
                                                             To="0" Duration="0:0:0.4">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </VisualState>

                                                <VisualState x:Name="Delete">
                                                    <VisualState.StateTriggers>
                                                        <StateTrigger IsActive="{Binding IsDelete}" />
                                                    </VisualState.StateTriggers>
                                                    <Storyboard>
                                                        <!-- 1. Плавно исчезаем -->
                                                        <DoubleAnimation Storyboard.TargetName="RootBorder" 
                Storyboard.TargetProperty="Opacity" 
                To="0" Duration="0:0:0.4"/>
                                                        <!-- 2. Сдвигаем влево (эффект вылета) -->
                                                        <DoubleAnimation Storyboard.TargetName="RootBorder" 
                Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)" 
                To="100" Duration="0:0:0.4">
                                                            <DoubleAnimation.EasingFunction>
                                                                <ExponentialEase Exponent="5" EasingMode="EaseIn"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <!-- 3. Схлопываем по высоте (чтобы нижние задачи поехали вверх) -->
                                                        <!--<DoubleAnimation Storyboard.TargetName="RootBorder" 
Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)" 
To="0" Duration="0:0:0.4"/>-->
                                                        <DoubleAnimation Storyboard.TargetName="RootBorder" 
                    Storyboard.TargetProperty="Height" 
                    To="0" Duration="0:0:0.4">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </VisualState>
                                                
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>

                                        <Grid  Background="#ffffff"  MinWidth="300">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="0.1*"/>
                                            </Grid.ColumnDefinitions>

                                            <interactivity:Interaction.Behaviors>
                                                <!-- Когда курсор входит в Grid -->
                                                <core:EventTriggerBehavior EventName="PointerEntered">
                                                    <core:ChangePropertyAction TargetObject="{Binding ElementName=DelButton}" PropertyName="Opacity" Value="1"/>
                                                </core:EventTriggerBehavior>

                                                <!-- Когда курсор выходит из Grid -->
                                                <core:EventTriggerBehavior EventName="PointerExited">
                                                    <core:ChangePropertyAction TargetObject="{Binding ElementName=DelButton}" 
                PropertyName="Opacity" 
                Value="0"/>
                                                </core:EventTriggerBehavior>
                                            </interactivity:Interaction.Behaviors>

                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="TaskCompletionStates">
                                                    
                                                    <!--<VisualState x:Name="Active">
                                                        --><!-- Изначальное состояние (не выполнено) --><!--
                                                        <VisualState.StateTriggers>
                                                            --><!-- Триггер: если IsComplete == false --><!--
                                                            <StateTrigger IsActive="{Binding IsComplete, Converter={StaticResource InverseBoolConverter}}" />
                                                        </VisualState.StateTriggers>
                                                        --><!-- Здесь не нужно ничего менять, т.к. это состояние по умолчанию --><!--
                                                    </VisualState>-->
                                                    <VisualState x:Name="Completed">
                                                        <!-- Состояние: выполнено -->
                                                        <VisualState.StateTriggers>
                                                            <!-- Триггер: если IsComplete == true -->
                                                            <StateTrigger IsActive="{Binding IsComplete}" />
                                                        </VisualState.StateTriggers>
                                                        <!-- Применяем стили к дочерним элементам -->
                                                        <Storyboard>
                                                            <!-- АНИМАЦИЯ ЗАЧЕРКИВАНИЯ: линия растет от 0 до 1 -->
                                                            <DoubleAnimation Storyboard.TargetName="StrikeLineScale" 
                                                              Storyboard.TargetProperty="ScaleX" 
                                                              To="1" 
                                                              Duration="0:0:0.4">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>

                                                            <!-- Плавная смена цвета текста -->
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TitleTextBlock" 
                                       Storyboard.TargetProperty="Foreground">
                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="Gray"/>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                        <VisualState.Setters>
                                                            
                                                            <!-- Применяем к TextBlock с заголовком -->
                                                            <!--<Setter Target="TitleTextBlock.Foreground" Value="Gray"/>
                                                            <Setter Target="TitleTextBlock.TextDecorations" Value="Strikethrough"/>-->

                                                            <!-- Применяем к TextBlock с датой -->
                                                            <Setter Target="DateTextBlock.Foreground" Value="Gray"/>
                                                            <!--<Setter Target="DateTextBlock.Visibility" Value="{Binding EndDate, Converter={StaticResource ConverterTextBoxVisibility}}"/>-->

                                                            <!-- Применяем к TextBlock с категорией -->
                                                            <Setter Target="CategoryTextBlock.Foreground" Value="Gray"/>
                                                            <!--<Setter Target="CategoryTextBlock.Visibility" Value="{Binding CategoryId, Converter={StaticResource ConverterTextBoxVisibility}}"/>-->

                                                            <!-- Можно также сделать разделитель менее заметным -->
                                                            <Setter Target="SeparatorRectangle.Opacity" Value="0.1"/>
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>

                                            

                                            <Grid Width="Auto"  Padding="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="0.1*"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox CommandParameter="{Binding}"
                                                          Command="{Binding DataContext.CompleteTaskCommand, ElementName=MyPageRoot}"
                                                          IsChecked="{Binding IsComplete, Mode=TwoWay}" />
                                                <StackPanel Grid.Column="1" Width="Auto" Margin="10,0,0,0" HorizontalAlignment="Stretch">
                                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TitleTextBlock" Text="{Binding Title}"  FontSize="20" TextWrapping="Wrap" Width="Auto" MaxWidth="800" FontWeight="Medium"/>

                                                        <!-- Линия зачеркивания -->
                                                        <Rectangle x:Name="StrikeLine"
                                                             Height="2"  
                                                             Fill="Gray"
                                                             HorizontalAlignment="Stretch" 
                                                             VerticalAlignment="Center"
                                                             RenderTransformOrigin="0,0.5"
                                                             IsHitTestVisible="False">
                                                            <Rectangle.RenderTransform>
                                                                <!-- Оставляем ScaleX="0" только здесь -->
                                                                <ScaleTransform x:Name="StrikeLineScale" ScaleX="0"/>
                                                            </Rectangle.RenderTransform>
                                                        </Rectangle>
                                                    </Grid>
                                                    
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock x:Name="DateTextBlock" Visibility="{Binding EndDate, Converter={StaticResource ConverterTextBoxVisibility}}" Text="{Binding EndDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:dd.MM.yyyy}'}"/>
                                                        <TextBlock x:Name="CategoryTextBlock" Visibility="{Binding CategoryId, Converter={StaticResource ConverterTextBoxVisibility}}">
                                                    <Run Text="#"/>
                                                    <Run Text="{Binding Category.Title}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Rectangle Height="1"  Fill="Black"  Opacity="0.2"  Margin="0,8,0,0"  HorizontalAlignment="Stretch"/>
                                                </StackPanel>

                                                <!--<StackPanel Width="Auto" Margin="10,0,0,0" HorizontalAlignment="Stretch">
                                                    <TextBlock Foreground="Gray" Text="{Binding Title}" TextDecorations="Strikethrough"  FontSize="20" TextWrapping="Wrap" Width="Auto" MaxWidth="800" FontWeight="Medium"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Foreground="Gray" Visibility="{Binding EndDate, Converter={StaticResource ConverterTextBoxVisibility}}" Text="{Binding EndDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:dd.MM.yyyy}'}"/>
                                                        <TextBlock Foreground="Gray" Visibility="{Binding CategoryId, Converter={StaticResource ConverterTextBoxVisibility}}">
                                                        <Run Text="#"/>
                                                        <Run Text="{Binding Category.Title}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Rectangle Height="1"  Fill="Black"  Opacity="0.2"  Margin="0,8,0,0"  HorizontalAlignment="Stretch"/>
                                                </StackPanel>-->
                                            </Grid>
                                            <Button x:Name="DelButton" Grid.Column="1" Content="Del" HorizontalAlignment="Right" Opacity="0"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.DeleteTask, ElementName=MyPageRoot}" >
                                                <!--<Button.Style>
                                                    <Style>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Style>
                                                </Button.Style>-->
                                            </Button>
                                        </Grid>
                                    </Border>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>


                    <!--<ListView ItemsSource="{Binding Missions}"
                         SelectedItem="{Binding Task, Mode=TwoWay}"  SelectionMode="Single"
                         Height="600"
                          >
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="mod:Mission">
                            <Grid Margin="{x:Bind LevelUp, Converter={StaticResource LevelToMarginConverter}}">
                                <StackPanel Orientation="Horizontal" Padding="5">

                                     Левый индикатор 
                                    <Ellipse Width="20" Height="20" 
                             Fill="Blue" 
                             VerticalAlignment="Center" 
                             Margin="5"/>

                                    <StackPanel Margin="10,0,0,0" HorizontalAlignment="Stretch">
