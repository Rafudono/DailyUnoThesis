<Page x:Class="DailyUnoThesis.Presentation.View.Pages.TaskListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DailyUnoThesis.Presentation.View.Pages"
    xmlns:mod="using:DailyUnoThesis.Models.MainClasses"
    xmlns:con="using:DailyUnoThesis.Models.Conventers"
    xmlns:control="using:DailyUnoThesis.Presentation.ViewModel.PagesControls"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uen="using:Uno.Extensions.Navigation.UI"
xmlns:utu="using:Uno.Toolkit.UI"
xmlns:um="using:Uno.Material"
NavigationCacheMode="Required"
       mc:Ignorable="d"
 Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <!--DataContext="{StaticResource Control}"-->
    <Page.Resources>
        <con:LevelToMarginConverter x:Key="LevelToMarginConverter" />
        <con:StringFormatConverter x:Key="StringFormatConverter" />
    </Page.Resources>
    <!--<Page.Resources>
        <control:TaskListControle x:Key="Control"/>
        <con:ScrollHeightConventer x:Key="heightOffsetConverter"/>
    </Page.Resources>-->
    <Page.DataContext>
        <control:TaskListControle/>
 </Page.DataContext>

    <Grid Background="CadetBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="0.6*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="BlanchedAlmond">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal" Height="150">
                    <TextBlock Text="папки" />
                    <ComboBox Width="Auto"
                              DisplayMemberPath="Title"
                              SelectedItem="{Binding SelectedFilterCategory}"
                              ItemsSource="{Binding Categories}" />
                </StackPanel>

                <!--<ListView ItemsSource="{Binding Missions}" SelectedItem="{Binding Task}"
Height="600">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2">
                                --><!-- item itself --><!--
                                <TextBlock Text="{Binding Title}" />

                                --><!-- parent DataContext.SomeText --><!--
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>-->

                <ListView ItemsSource="{Binding Missions}"
                         SelectedItem="{Binding Task, Mode=TwoWay}"  SelectionMode="Single"
                         Height="600"
                          >
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="mod:Mission">
                            <Grid Margin="{x:Bind LevelUp, Converter={StaticResource LevelToMarginConverter}}">
                                <StackPanel Orientation="Horizontal" Padding="5">

                                     Левый индикатор 
                                    <Ellipse Width="20" Height="20" 
                             Fill="Blue" 
                             VerticalAlignment="Center" 
                             Margin="5"/>

                                    <StackPanel Margin="10,0,0,0" HorizontalAlignment="Stretch">
                                         Заголовок 
                                        <TextBlock Text="{Binding Title}" 
                                   FontSize="20" 
                                   FontWeight="Medium"/>

                                         Нижняя строка: Дата и Категория 
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                             Форматирование даты в x:Bind делается через метод или простой Binding 
                                            <TextBlock Text="{Binding EndDate, Converter={StaticResource StringFormatConverter}, ConverterParameter='{}{0:dd-MM-yyyy}'}" 
                                       Foreground="Gray" />

                                            <TextBlock Foreground="Gray">
                                <Run Text="#"/>
                                <Run Text="{Binding Category.Title}"/>
                                            </TextBlock>
                                        </StackPanel>

                                         Разделитель (вместо Line лучше Rectangle) 
                                        <Rectangle Height="1" 
                                   Fill="Black" 
                                   Opacity="0.2" 
                                   Margin="0,8,0,0" 
                                   HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1">
            <ScrollViewer>
                <StackPanel Margin="10">
                    <Button Content="новый"
                            HorizontalAlignment="Right"
                            Command="{Binding NewTask}" />

                    <TextBox Text="{Binding Task.Title}"
                             MinWidth="300"
                             PlaceholderText="Введите название"
                             Height="30" FontSize="20" />

                    <TextBox Text="{Binding Task.Description}"
                             MinWidth="300"
                             PlaceholderText="Введите описание"
                             Height="50" TextWrapping="Wrap" FontSize="15" />

                    <ListBox Background="Transparent"
                             ItemsSource="{Binding Subtasks}"
                             MinHeight="40"
                             Visibility="{Binding Task.LevelUp, Converter={StaticResource LevelVisibilityConverter}}">

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="mod:Mission">
                                <TextBox Width="300" Height="30" Margin="0,0,0,3" Padding="3"
                                         Text="{Binding Title}"
                                         PlaceholderText="Новая подзадача"
                                         FontSize="16" FontWeight="Bold" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="добавить подзадачу +"
                            Command="{Binding CreateSubtask}"
                            Visibility="{Binding Task.LevelUp, Converter={StaticResource LevelVisibilityConverter}}" />

                    <Ellipse Width="30" Height="30" Fill="Blue" Margin="5" HorizontalAlignment="Left" />

                    <StackPanel Orientation="Horizontal">
                        <DatePicker IsEnabled="False" />
                        <TextBlock Text="---" Margin="10,0,10,0" />
                        <DatePicker SelectedDate="{Binding Task.EndDate}" />
                    </StackPanel>
                    <TextBlock Text="список папок" />

                    <Grid>
                        <TextBlock Text="{Binding SelectedCategory.Title}"
                                   FontSize="20"
                                   Visibility="{Binding SelectedCategory.Id, Converter={StaticResource ZeroCategoryVisibilityConverter}}" />

                        <ComboBox FontSize="20" Height="30"
                                  DisplayMemberPath="Title"
                                  SelectedItem="{Binding SelectedCategory}"
                                  ItemsSource="{Binding Categories}"
                                  Visibility="{Binding Task.LevelUp, Converter={StaticResource LevelEquals1VisibilityConverter}}" />
                    </Grid>

                    <Button Height="30" Content="Сохранить" Command="{Binding CreateAndEditTask}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <!--<Grid x:Name="CatBanner" Visibility="{Binding IsCatBannerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Background="Gray" Opacity="0.6" />
            <Border CornerRadius="20" Height="200" Width="500" Background="PaleVioletRed">
                <Grid>
                    <TextBox PlaceholderText="Название категории"
                             Width="400" Height="40" FontSize="25" />
                    <Button Content="Сохранить"
                            Margin="20"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Height="30" Width="100" />
                </Grid>
            </Border>
        </Grid>-->
    </Grid>
</Page>
