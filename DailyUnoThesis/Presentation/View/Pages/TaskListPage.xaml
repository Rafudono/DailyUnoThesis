                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>-->
                </StackPanel>
            </ScrollViewer>
        </Grid>




        
        <Border Grid.Column="1" Visibility="Collapsed" BorderThickness="1,0,0,0" CornerRadius="8 0 0 8" BorderBrush="#311a11">
            <Grid Grid.Column="1" Background="#ecf1ff">
                <!--<Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Background">
                            <Setter.Value>
                                <RadialGradientBrush Center="0.5,0.1" RadiusX="1" RadiusY="0.9" GradientOrigin="0.5,0.1">
                                    --><!-- Первый цвет: занимает 60% площади (Offset 0.6) --><!--
                                    <GradientStop Color="#f2eff5" Offset="0.02" />
                                    --><!-- Второй цвет: плавный переход --><!--
                                    <GradientStop Color="#f2eff5" Offset="0.88" />
                                    --><!-- Третий цвет: темная кайма на самом краю --><!--
                                    <GradientStop Color="#dfbba9" Offset="1.0" />
                                </RadialGradientBrush>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Style>-->
                <ScrollViewer>
                    <StackPanel Margin="10">
                        <Button Content="новый"
                            HorizontalAlignment="Right"
                            Command="{Binding NewTask}" />

                        <TextBox Text="{Binding Task.Title, Mode=TwoWay}"
                             MinWidth="150"
                             PlaceholderText="Введите название"
                             Height="30" FontSize="20" />

                        <TextBox Text="{Binding Task.Description, Mode=TwoWay}"
                             MinWidth="150"
                             PlaceholderText="Введите описание"
                             Height="50" TextWrapping="Wrap" FontSize="15" />

                        <ListView Margin="0 10 0 0" Background="Transparent"
                             ItemsSource="{Binding Subtasks, Mode=TwoWay}"
                             MinHeight="10"
                             Visibility="{Binding Task.LevelUp, Converter={StaticResource LevelVisibilityConverter}}">

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="mod:Mission">
                                    <TextBox Width="300" Height="30" Margin="0,0,0,3" Padding="3"
                                         Text="{Binding Title, Mode=TwoWay}"
                                         PlaceholderText="Новая подзадача"
                                         FontSize="16" FontWeight="Bold" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button Content="добавить подзадачу +"
                            Command="{Binding CreateSubtask}"
                            Visibility="{Binding Task.LevelUp, Converter={StaticResource LevelVisibilityConverter}}" />

                        <Ellipse Width="30" Height="30" Fill="Blue" Margin="5" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal">
                            <CalendarDatePicker Height="50" Width="130" DateFormat="{}{day.integer}.{month.integer}.{year.full}" Date="{Binding Task.StartDate,  Mode=TwoWay, Converter={StaticResource DateTimeToOffsetConverter} }"
                    Padding="0" VerticalContentAlignment="Center"  PlaceholderText="Выберите конечную дату"/>
                            <TextBlock Text="---" Margin="10,0,10,0" />
                            <CalendarDatePicker Height="50" Width="130" DateFormat="{}{day.integer}.{month.integer}.{year.full}" Date="{Binding Task.EndDate,  Mode=TwoWay, Converter={StaticResource DateTimeToOffsetConverter} }"
                                            Padding="0" VerticalContentAlignment="Center"  PlaceholderText="Выберите конечную дату"/>
                        </StackPanel>
                        <TextBlock Text="список папок" />

                        <Grid>
                            <TextBlock Text="{Binding SelectedCategory.Title}"
                                   FontSize="20"
                                   Visibility="{Binding Task.LevelUp, Converter={StaticResource LevelTextBoxVisibilityConverter}, ConverterParameter={Binding SelectedCategory.Id}}" />

                            <ComboBox FontSize="20" Height="30"
                                  DisplayMemberPath="Title"
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                  ItemsSource="{Binding Categories, Mode=TwoWay}"
                                  Visibility="{Binding Task.LevelUp, Converter={StaticResource LevelComboBoxVisibilityConverter}}" />
                        </Grid>

                        <Button Height="30" Content="Сохранить" Command="{Binding CreateAndEditTask}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <!--<Grid x:Name="CatBanner" Visibility="{Binding IsCatBannerVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Background="Gray" Opacity="0.6" />
            <Border CornerRadius="20" Height="200" Width="500" Background="PaleVioletRed">
                <Grid>
                    <TextBox PlaceholderText="Название категории"
                             Width="400" Height="40" FontSize="25" />
                    <Button Content="Сохранить"
                            Margin="20"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Height="30" Width="100" />
                </Grid>
            </Border>
        </Grid>-->
    </Grid>
</Page>
