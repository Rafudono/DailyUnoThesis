<Page
    x:Class="DailyUnoThesis.Presentation.View.Authentication.RegistrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DailyUnoThesis.Presentation.View.Authentication"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="RegPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Segoe Print"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#00224d"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#A3B1C6"/>
            <Setter Property="Padding" Value="0,4,0,2"/>
            <Setter Property="PlaceholderForeground" Value="#A3B1C6"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Center">
        <StackPanel MaxWidth="360" Margin="40,40,40,40" Spacing="16" VerticalAlignment="Center">

            <TextBlock Text="Регистрация"
                       FontFamily="Segoe Print"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource InkBlueLightBrush}"
                       TextAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBox PlaceholderText="Имя пользователя" Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBoxWithPlaceholderStyle}"
                     IsSpellCheckEnabled="False"/>

            <TextBox PlaceholderText="Электронная почта" Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBoxWithPlaceholderStyle}"
                     IsSpellCheckEnabled="False"/>

            <PasswordBox PlaceholderText="Придумайте пароль" Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RegPasswordBoxStyle}"/>

            <PasswordBox PlaceholderText="Повторите пароль" Text="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RegPasswordBoxStyle}"/>
            
            <TextBlock Visibility="{Binding ErrorVisibility}" Text="{Binding ErrorMessage}"  FontFamily="Segoe Print" FontSize="14"
                       Foreground="{StaticResource ClueRedLightBrush}"/>
          
            <Button Content="Зарегистрироваться"
                        Style="{StaticResource NoirDialogButtonStyle}" Command="{Binding RegistrationStart}"
                    Margin="0,8,0,0"/>

            <Button Content="Уже есть аккаунт? Войти"
                    Style="{StaticResource TextButtonStyle}" Command="{Binding BackToLoginPage}"
                    FontFamily="Segoe Print"
                    FontSize="13"
                    HorizontalAlignment="Center"/>

        </StackPanel>
    </ScrollViewer>
</Page>
