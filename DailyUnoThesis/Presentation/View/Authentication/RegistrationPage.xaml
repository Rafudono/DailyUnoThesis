<Page
    x:Class="DailyUnoThesis.Presentation.View.Authentication.RegistrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DailyUnoThesis.Presentation.View.Authentication"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="RegPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Segoe Print"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#00224d"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#A3B1C6"/>
            <Setter Property="Padding" Value="0,4,0,2"/>
            <Setter Property="PlaceholderForeground" Value="#A3B1C6"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Center">
        <StackPanel MaxWidth="360" Margin="40,40,40,40" Spacing="16">

            <!-- Заголовок -->
            <TextBlock Text="&#x270D; Новое дело"
                       FontFamily="Segoe Print"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource InkBlueLightBrush}"
                       TextAlignment="Center"
                       Margin="0,0,0,8"/>
            <Border Height="2"
                    Background="#A3B1C6"
                    Margin="40,0,40,0"
                    CornerRadius="1"/>

            <!-- Имя -->
            <TextBox PlaceholderText="Имя"
                     Style="{StaticResource NotebookTextBoxStyle}"
                     IsSpellCheckEnabled="False"/>

            <!-- Фамилия -->
            <TextBox PlaceholderText="Фамилия"
                     Style="{StaticResource NotebookTextBoxStyle}"
                     IsSpellCheckEnabled="False"/>

            <!-- Email -->
            <TextBox PlaceholderText="Электронная почта"
                     Style="{StaticResource NotebookTextBoxStyle}"
                     IsSpellCheckEnabled="False"/>

            <!-- Пароль -->
            <PasswordBox PlaceholderText="Придумайте кодовое слово"
                         Style="{StaticResource RegPasswordBoxStyle}"/>

            <!-- Подтверждение пароля -->
            <PasswordBox PlaceholderText="Повторите кодовое слово"
                         Style="{StaticResource RegPasswordBoxStyle}"/>

            <!-- Создать -->
            <Button Content="Открыть дело"
                    Style="{StaticResource DetectiveSaveButtonStyle}"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"/>

            <!-- Ссылка на вход -->
            <Button Content="Уже есть дело? Войти"
                    Style="{StaticResource TextButtonStyle}"
                    FontFamily="Segoe Print"
                    FontSize="13"
                    HorizontalAlignment="Center"/>

        </StackPanel>
    </ScrollViewer>
</Page>
