<Page
    x:Class="DailyUnoThesis.Presentation.View.Authentication.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DailyUnoThesis.Presentation.View.Authentication"
    xmlns:control="using:DailyUnoThesis.Presentation.ViewModel.AuthenticationControle"
    xmlns:mod="using:DailyUnoThesis.Models.MainClasses"
    xmlns:con="using:DailyUnoThesis.Models.Conventers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="AuthPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Segoe Print"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#00224d"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#A3B1C6"/>
            <Setter Property="Padding" Value="0,4,0,2"/>
            <Setter Property="PlaceholderForeground" Value="#A3B1C6"/>
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalContentAlignment="Center">
        <StackPanel MaxWidth="360" Margin="40,60,40,40" Spacing="16" VerticalAlignment="Center">


            <TextBlock Text="Авторизация"
                       FontFamily="Segoe Print"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource InkBlueLightBrush}"
                       TextAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBox PlaceholderText="Имя пользователя"
                     x:Name="LoginUsername"
                     FontFamily="Segoe Print"
                     Style="{StaticResource TextBoxWithPlaceholderStyle}"
                     IsSpellCheckEnabled="False"
                     Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <PasswordBox x:Name="LoginPassword"
                         PlaceholderText="Пароль"
                         Style="{StaticResource AuthPasswordBoxStyle}"
                         Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

       
          
            
            <TextBlock Visibility="{Binding ErrorVisibility}" Text="{Binding ErrorMessage}"  FontFamily="Segoe Print" FontSize="14"
                       Foreground="{StaticResource ClueRedLightBrush}"/>

            <Button Content="Войти"
                    x:Name="LoginButton"
                    AutomationProperties.AutomationId="LoginButton"
                    Style="{StaticResource NoirDialogButtonStyle}"
                    Command="{Binding Login}"
                    Margin="0,8,0,0"/>
            
            <CheckBox Content="Запомнить меня" IsEnabled="False"
            IsChecked="{Binding UserCredentials.SaveCredentials, Mode=TwoWay}"
            FontFamily="Segoe Print"
            FontSize="14"
            Foreground="{StaticResource InkBlueLightBrush}"/>
            
            <StackPanel Spacing="4" Margin="0,8,0,0">
                <Button Content="Забыли пароль?" IsEnabled="False"
                        Style="{StaticResource TextButtonStyle}"
                        FontFamily="Segoe Print"
                        FontSize="13"/>
                <Button Content="Регистрация"  Command="{Binding OpenRegistrationPage}"
                        Style="{StaticResource TextButtonStyle}"
                        FontFamily="Segoe Print"
                        FontSize="13"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
